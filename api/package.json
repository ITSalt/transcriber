{
  "name": "@transcrib/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc --build && node -e \"const fs=require('fs');const p='dist/lib/pdf';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('src/lib/pdf/template.html',p+'/template.html')\"",
    "dev": "tsc --build --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@transcrib/shared": "workspace:*",
    "bullmq": "^5.76.10",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "ioredis": "^5.10.1",
    "jszip": "^3.10.2",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "puppeteer-core": "^25.0.3",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/pg": "^8.20.0",
    "puppeteer": "^25.0.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
