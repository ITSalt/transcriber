// GLO-003 — Transcript
MERGE (glo003:GlossaryTerm {id: 'GLO-003'})
SET glo003.name            = 'Transcript',
    glo003.name_ru         = 'Транскрипт',
    glo003.definition      = 'The verbatim, speaker-attributed text output of the transcription pipeline. Contains the full spoken content of the meeting with speaker labels and timestamps per segment. Sometimes called a "verbatim transcript" to distinguish it from a summarized protocol.',
    glo003.aliases         = ['Транскрипт', 'Пословная транскрибация', 'Verbatim Transcript'],
    glo003.context         = 'Produced by BP-002 (Transcription); consumed by BP-003 (Retrieve) and BP-004 (Protocol Generation). Corresponds to OBJ-004.',
    glo003.status          = 'approved',
    glo003.created         = coalesce(glo003.created, date('2026-05-17')),
    glo003.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-003'})-[r:DEFINES_TERM]->() DELETE r;
MATCH (a:GlossaryTerm {id: 'GLO-003'}), (t:BusinessEntity {id: 'OBJ-004'}) MERGE (a)-[:DEFINES_TERM]->(t);

// GLO-004 — Speaker Diarization
MERGE (glo004:GlossaryTerm {id: 'GLO-004'})
SET glo004.name            = 'Speaker Diarization',
    glo004.name_ru         = 'Диаризация спикеров',
    glo004.definition      = 'The automated process of partitioning an audio stream into segments and labeling each segment with a speaker identity (e.g., «Спикер 1», «Спикер 2»). Diarization answers the question "who spoke when" and is a required step of the transcription pipeline.',
    glo004.aliases         = ['Диаризация спикеров', 'Diarization'],
    glo004.context         = 'Performed inside BP-002 (Transcription) by the ASR/Diarization Engine (EXT-01). Output feeds into speaker-attributed transcript segments.',
    glo004.status          = 'approved',
    glo004.created         = coalesce(glo004.created, date('2026-05-17')),
    glo004.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-004'})-[r:DEFINES_TERM]->() DELETE r;
MATCH (a:GlossaryTerm {id: 'GLO-004'}), (t:ExternalEntity {id: 'EXT-01'}) MERGE (a)-[:DEFINES_TERM]->(t);

// GLO-005 — Speaker Segment
MERGE (glo005:GlossaryTerm {id: 'GLO-005'})
SET glo005.name            = 'Speaker Segment',
    glo005.name_ru         = 'Сегмент транскрипта',
    glo005.definition      = 'A contiguous block of speech attributed to a single speaker, with a start timestamp, end timestamp, speaker label, and verbatim text. Multiple segments together form the full Transcript.',
    glo005.aliases         = ['Сегмент транскрипта', 'Transcript Segment'],
    glo005.context         = 'Produced by the diarization step inside BP-002; stored as structured content within OBJ-004 (Transcript) at MVP scope.',
    glo005.status          = 'approved',
    glo005.created         = coalesce(glo005.created, date('2026-05-17')),
    glo005.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-005'})-[r:DEFINES_TERM]->() DELETE r;

// GLO-006 — Meeting Protocol
MERGE (glo006:GlossaryTerm {id: 'GLO-006'})
SET glo006.name            = 'Meeting Protocol',
    glo006.name_ru         = 'Протокол встречи',
    glo006.definition      = 'A structured summary document produced from the transcript by the LLM generation pipeline. Contains sections for meeting participants, discussion topics, decisions made, and action items with assignees and deadlines. Stored in Markdown and exportable to PDF.',
    glo006.aliases         = ['Протокол встречи', 'Протокол', 'Protocol', 'Minutes'],
    glo006.context         = 'Produced by BP-004; edited in BP-005; exported in BP-006. Corresponds to OBJ-006. Also used in the short form «Протокол» (former GLO-007, merged here).',
    glo006.status          = 'approved',
    glo006.created         = coalesce(glo006.created, date('2026-05-17')),
    glo006.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-006'})-[r:DEFINES_TERM]->() DELETE r;
MATCH (a:GlossaryTerm {id: 'GLO-006'}), (t:BusinessEntity {id: 'OBJ-006'}) MERGE (a)-[:DEFINES_TERM]->(t);

// GLO-008 — Action Item
MERGE (glo008:GlossaryTerm {id: 'GLO-008'})
SET glo008.name            = 'Action Item',
    glo008.name_ru         = 'Поручение',
    glo008.definition      = 'A commitment agreed at a meeting: an assignment to a named project participant with the meeting context and a deadline. Extracted by the LLM from the transcript; appears in the protocol section «## Задачи» and, in a project, as an entry of the project register (code T-n, status, assignee, due date, history of events). The word «задача» is not used in the product: the user-facing name is «поручение»; code identifiers (Task, /api/projects/:id/tasks, T-n) are unchanged.',
    glo008.aliases         = ['Поручение', 'Action Item'],
    glo008.context         = 'Protocol section of OBJ-006 (BP-004); project register ent-020 (Task) with change history ent-022 (TaskEvent).',
    glo008.status          = 'approved',
    glo008.created         = coalesce(glo008.created, date('2026-05-17')),
    glo008.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-008'})-[r:DEFINES_TERM]->() DELETE r;
MATCH (a:GlossaryTerm {id: 'GLO-008'}), (t:DomainEntity {id: 'ent-020'}) MERGE (a)-[:DEFINES_TERM]->(t);

// GLO-009 — Decision
MERGE (glo009:GlossaryTerm {id: 'GLO-009'})
SET glo009.name            = 'Decision',
    glo009.name_ru         = 'Решение',
    glo009.definition      = 'A conclusion or resolution reached during the meeting that is explicitly recorded in the protocol. Decisions are distinct from action items in that they represent outcomes rather than future tasks.',
    glo009.aliases         = ['Решение'],
    glo009.context         = 'Captured as a section within OBJ-006 (Protocol); extracted during BP-004 (Protocol Generation).',
