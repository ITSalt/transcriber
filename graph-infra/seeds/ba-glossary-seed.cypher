// GLO-035 — Context Snapshot
MERGE (glo035:GlossaryTerm {id: 'GLO-035'})
SET glo035.name            = 'Context Snapshot',
    glo035.name_ru         = 'Снимок контекста',
    glo035.definition      = 'Неизменяемая копия контекста встречи в момент запуска распознавания (карточка проекта + данные встречи + текст предыдущего протокола) с хэшем snapshot_hash. Правки проекта после запуска снимок не меняют; пользователь может посмотреть, какой контекст был использован.',
    glo035.aliases         = ['Снимок контекста', 'Использованный контекст'],
