// GLO-027 — User
MERGE (glo027:GlossaryTerm {id: 'GLO-027'})
SET glo027.name            = 'User',
    glo027.name_ru         = 'Пользователь',
    glo027.definition      = 'A person who signs in to Transcrib with a personal PIN and works inside the workspaces they are a member of (Membership): uploads meetings, reviews transcripts, edits and exports protocols. Accounts, workspaces and memberships are managed only by the operator through the CLI (SR-03).',
    glo027.aliases         = ['Пользователь', 'Член пространства'],
    glo027.context         = 'Workspace member (FR-003): plays the Author role (ROL-01) for the meetings they upload and may read other members\' meetings in the same workspace. Signs in via UC-400; the operator role SR-03 is not represented in the web UI.',
    glo027.status          = 'approved',
    glo027.created         = coalesce(glo027.created, date('2026-05-17')),
    glo027.updated         = date('2026-10-09');
