// GLO-001 — Meeting
MERGE (glo001:GlossaryTerm {id: 'GLO-001'})
SET glo001.name            = 'Meeting',
    glo001.name_ru         = 'Встреча',
    glo001.definition      = 'A single business meeting whose recording is uploaded into the system for processing. The root object that owns the resulting recording, transcript, and protocol throughout its lifecycle. In the UI and in all specifications the word «встреча» is the only name of this object; the word «задача» is never used for it.',
    glo001.aliases         = ['Встреча'],
    glo001.context         = 'Used throughout all processes (BP-001..BP-006); the top-level aggregate (OBJ-001).',
    glo001.status          = 'approved',
    glo001.created         = coalesce(glo001.created, date('2026-05-17')),
    glo001.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-001'})-[r:DEFINES_TERM]->() DELETE r;
MATCH (a:GlossaryTerm {id: 'GLO-001'}), (t:BusinessEntity {id: 'OBJ-001'}) MERGE (a)-[:DEFINES_TERM]->(t);

// GLO-002 — Recording
MERGE (glo002:GlossaryTerm {id: 'GLO-002'})
SET glo002.name            = 'Recording',
    glo002.name_ru         = 'Видеозапись',
    glo002.definition      = 'The video file uploaded by the Author that captures the meeting. The physical file is stored in object storage; the system tracks its metadata (filename, size, duration, storage path) as the Recording entity.',
    glo002.aliases         = ['Видеозапись', 'Запись', 'Video File'],
    glo002.context         = 'Created in BP-001 (Upload); consumed in BP-002 (Transcription). Corresponds to OBJ-002.',
    glo002.status          = 'approved',
