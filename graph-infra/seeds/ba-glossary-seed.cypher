// GLO-038 — Speaker
MERGE (glo038:GlossaryTerm {id: 'GLO-038'})
SET glo038.name            = 'Speaker',
    glo038.name_ru         = 'Спикер',
    glo038.definition      = 'Анонимная метка диаризации «Спикер N», присвоенная голосу в распознанной записи. Один человек может получить несколько меток; после подтверждения (GLO-037) метка заменяется именем участника. В коде метка хранится как SPEAKER_n; это идентификатор, пользователю он не показывается. Не синоним участника (GLO-011).',
    glo038.aliases         = ['Спикер', 'Метка спикера', 'Speaker label'],
    glo038.context         = 'Сегменты транскрипта OBJ-004; UC-505.',
    glo038.status          = 'approved',
    glo038.created         = coalesce(glo038.created, date('2026-05-17')),
    glo038.updated         = date('2026-10-09');
