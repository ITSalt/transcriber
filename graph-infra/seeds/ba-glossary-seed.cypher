// GLO-012 — Author
MERGE (glo012:GlossaryTerm {id: 'GLO-012'})
SET glo012.name            = 'Author',
    glo012.name_ru         = 'Автор',
    glo012.definition      = 'The business role of a workspace member who uploaded a meeting recording and owns the derived artifacts (transcript and protocol). Any member of the same workspace sees these artifacts (the workspace is the isolation unit).',
    glo012.aliases         = ['Автор', 'Uploader'],
    glo012.context         = 'Defined as ROL-01; performs BP-001, BP-003, BP-005, BP-006. Per FR-003 an Author is a User (GLO-027) acting inside a workspace (GLO-029).',
