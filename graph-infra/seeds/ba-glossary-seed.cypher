// GLO-032 — Project Participant
MERGE (glo032:GlossaryTerm {id: 'GLO-032'})
SET glo032.name            = 'Project Participant',
    glo032.name_ru         = 'Участник проекта',
    glo032.definition      = 'Постоянный участник встреч проекта: имя, варианты написания и организация. Имена идут подсказкой в распознавание речи и в промпт протокола; метки спикеров сопоставляются с участниками проекта. Не путать с участником конкретной встречи (GLO-011).',
