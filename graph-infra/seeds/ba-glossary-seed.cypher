// GLO-029 — Workspace
MERGE (glo029:GlossaryTerm {id: 'GLO-029'})
SET glo029.name            = 'Workspace',
    glo029.name_ru         = 'Пространство',
    glo029.definition      = 'Единица изоляции данных: все члены пространства видят в нём все встречи, проекты и протоколы. У каждого пользователя есть личное пространство; общие выдаются по членству.',
    glo029.aliases         = ['Пространство', 'Рабочее пространство'],
