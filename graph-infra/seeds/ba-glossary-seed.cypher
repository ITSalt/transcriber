MERGE (glo018:GlossaryTerm {id: 'GLO-018'})
SET glo018.name            = 'Async Job',
    glo018.name_ru         = 'Обработка',
    glo018.definition      = 'A background operation that performs long-running work (transcription or protocol generation) outside the synchronous request-response cycle. The user sees its progress through meeting statuses and server-sent events and gets the result when processing completes. In the UI it is called «обработка».',
    glo018.aliases         = ['Обработка', 'Фоновая обработка', 'Background Job'],
