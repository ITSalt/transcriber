SET glo011.name            = 'Participant',
    glo011.name_ru         = 'Участник',
    glo011.definition      = 'A person who took part in the meeting. Identified in the transcript through speaker labels (GLO-038) and, in a project, mapped to project participants (GLO-032). The participant list appears as a dedicated section of the protocol.',
    glo011.aliases         = ['Участник', 'Attendee'],
