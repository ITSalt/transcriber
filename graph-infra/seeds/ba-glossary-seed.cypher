// GLO-028 — Speaker Name Resolution
MERGE (glo028:GlossaryTerm {id: 'GLO-028'})
SET glo028.name            = 'Speaker Name Resolution',
    glo028.name_ru         = 'Определение имён спикеров',
    glo028.definition      = 'Post-diarization step that substitutes anonymous speaker labels («Спикер 1», «Спикер 2», ...) with real participant names. Names come from project participants or from the transcript itself (self-introductions, addressed names), and are confirmed by the user at the speaker confirmation step (GLO-037). Unresolved labels remain as «Спикер N».',
    glo028.aliases         = ['Определение имён спикеров', 'Подтверждение имён', 'Name Attribution'],
    glo028.context         = 'Performed inside BP-002 at step BP-002-S07B; results stored in Transcript.speaker_map (OBJ-004-A08). Confirmed by the user in UC-505 before protocol generation.',
    glo028.assumption_note = 'Resolution method (heuristic or LLM-based) and confidence threshold are TBD at SA phase.',
    glo028.status          = 'approved',
    glo028.created         = coalesce(glo028.created, date('2026-05-17')),
    glo028.updated         = date('2026-10-09');
MATCH (:GlossaryTerm {id: 'GLO-028'})-[r:DEFINES_TERM]->() DELETE r;
