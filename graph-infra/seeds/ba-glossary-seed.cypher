SET glo039.name            = 'Keyterm',
    glo039.name_ru         = 'Ключевой термин',
    glo039.definition      = 'Слово или имя, которое передаётся распознаванию речи как подсказка: имена участников проекта первыми, затем термины проекта, не более 50. Повышает точность распознавания имён и терминов.',
    glo039.aliases         = ['Ключевой термин', 'Keyterm'],
