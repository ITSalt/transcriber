SET glo036.name            = 'Transcription Start',
    glo036.name_ru         = 'Запуск распознавания',
    glo036.definition      = 'Явное действие пользователя после загрузки: «Начать распознавание». До него встреча стоит в статусе AWAITING_START и контекст можно править; после — контекст фиксируется снимком и стартует обработка.',
    glo036.aliases         = ['Запуск распознавания', 'Начать распознавание', 'AWAITING_START'],
