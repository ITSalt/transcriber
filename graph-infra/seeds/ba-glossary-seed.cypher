// GLO-037 — Speaker Confirmation
MERGE (glo037:GlossaryTerm {id: 'GLO-037'})
SET glo037.name            = 'Speaker Confirmation',
    glo037.name_ru         = 'Подтверждение спикеров',
    glo037.definition      = 'Шаг после распознавания и до генерации протокола: пользователь сопоставляет метки «Спикер N» с участниками проекта или именами (можно объединять дубли) либо пропускает шаг. До подтверждения встреча стоит в статусе AWAITING_SPEAKERS.',
    glo037.aliases         = ['Подтверждение спикеров', 'AWAITING_SPEAKERS'],
    glo037.context         = 'UC-505; FR-007; статус встречи AWAITING_SPEAKERS.',
