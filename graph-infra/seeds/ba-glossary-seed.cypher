// GLO-013 — Reviewer
MERGE (glo013:GlossaryTerm {id: 'GLO-013'})
SET glo013.name            = 'Reviewer',
    glo013.name_ru         = 'Читатель протокола',
    glo013.definition      = 'A business role of a workspace member who reads, validates and gives feedback on a protocol produced by another member. Has no separate access rights: all workspace members see everything in the workspace.',
    glo013.aliases         = ['Читатель протокола', 'Проверяющий'],
    glo013.context         = 'Defined as ROL-02; same permissions as Author after FR-003 (access is defined by workspace membership). Feedback is captured as Protocol Feedback (GLO-045).',
