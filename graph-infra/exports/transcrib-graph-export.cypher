pdated:"2026-10-08T19:18:23.11Z", derived:false}}, {_id:885, properties:{internal:false, nullable:true, data_type:"DateTime", name:"speakers_confirmed_at", description:"Время подтверждения или пропуска спикеров (FR-007). NULL до подтверждения.", id:"Transcript-A11", type:"DateTime", updated:"2026-10-08T19:18:23.11Z", derived:false}}] AS row
