UNWIND [{id:"W0", properties:{number:0, created:datetime('2026-05-18T08:40:46.825Z'), name:"Foundation & Infrastructure", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W1", properties:{number:1, created:datetime('2026-05-18T08:40:46.825Z'), name:"Core BE: Catalog + Upload", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W2", properties:{number:2, created:datetime('2026-05-18T08:40:46.825Z'), name:"Core FE + Detail BE + Transcription Pipeline", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W3", properties:{number:3, created:datetime('2026-05-18T08:40:46.825Z'), name:"Detail/Delete BE+FE + Transcript + Protocol Pipeline", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W4", properties:{number:4, created:datetime('2026-05-18T08:40:46.825Z'), name:"Delete/Transcript FE + Protocol Editor BE", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W5", properties:{number:5, created:datetime('2026-05-18T08:40:46.825Z'), name:"Protocol Editor FE + PDF Export", updated:datetime('2026-05-22T12:46:37.452Z'), status:"delivered"}}, {id:"W7", properties:{number:7, created:datetime('2026-05-22T12:46:40.83Z'), name:"Production prep (parallel)", updated:datetime('2026-05-22T12:46:40.83Z'), status:"delivered"}}, {id:"W8", properties:{number:8, created:datetime('2026-05-22T12:46:40.83Z'), name:"Server wiring", updated:datetime('2026-05-22T12:46:40.83Z'), status:"delivered"}}, {id:"W9", properties:{number:9, created:datetime('2026-05-22T12:46:40.83Z'), name:"CI/CD deploy pipeline", updated:datetime('2026-05-22T12:46:40.83Z'), status:"delivered"}}, {id:"W10", properties:{number:10, created:datetime('2026-05-22T12:46:40.83Z'), name:"DNS cutover + smoke test runbook", updated:datetime('2026-05-22T12:46:40.83Z'), status:"partial"}}, {id:"wave-11", properties:{number:11, name:"FR-001: migration + infra (attempt_count, Redis db-index)", status:"pending"}}, {id:"wave-12", properties:{number:12, name:"FR-001: worker failure-path refinements (UC-200/UC-300 BE)", status:"pending"}}, {id:"wave-13", properties:{number:13, name:"FR-001: user-facing retry (UC-004 BE+FE)", status:"pending"}}, {id:"wave-14", properties:{number:14, name:"Program product: contract v1 (WP-BACKEND-06) — schema, shared contracts, deps, auto-registration", status:"done"}}, {id:"wave-15", properties:{number:15, name:"Program product: login by PIN, workspaces, isolation (WP-BACKEND-01)", status:"done"}}] AS row
