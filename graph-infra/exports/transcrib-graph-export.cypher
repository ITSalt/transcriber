UNWIND [{id:"DFL-001", properties:{data_description:"Raw video file (up to 2.5 GiB) containing the meeting recording, uploaded by the user", name:"Meeting video file upload", updated:datetime('2026-08-17T09:14:40.768Z'), direction:"IN"}}, {id:"DFL-002", properties:{data_description:"Complete timestamped transcript with speaker labels (who said what at which minute/second), delivered to the user for download", name:"Verbatim speaker-attributed transcript", direction:"OUT"}}, {id:"DFL-003", properties:{data_description:"Structured meeting protocol: participants list, discussion topics, decisions made, action items with assignees and deadlines, delivered to the user for download", name:"Meeting protocol", direction:"OUT"}}, {id:"DFL-004", properties:{data_description:"Extracted audio stream (or reference to stored file) sent to the ASR/diarization engine for processing", name:"Audio data for transcription", direction:"OUT"}}, {id:"DFL-005", properties:{data_description:"Transcript segments returned by ASR/diarization: each contains speaker ID, start/end timestamps, and spoken text", name:"Speaker-attributed transcript segments", direction:"IN"}}, {id:"DFL-006", properties:{data_description:"Full verbatim transcript with speaker labels sent to the LLM for extraction of topics, decisions, action items", name:"Transcript text for protocol generation", direction:"OUT"}}, {id:"DFL-007", properties:{data_description:"Structured meeting protocol returned by the LLM: participants, topics, decisions, action items with assignees and deadlines", name:"Generated meeting protocol", direction:"IN"}}, {id:"DFL-008", properties:{data_description:"Raw video/audio binary written to object storage for durable retention during asynchronous processing", name:"Video file write to storage", direction:"OUT"}}, {id:"DFL-009", properties:{data_description:"Video or extracted audio file retrieved from object storage to be passed to the ASR/diarization engine", name:"Video file retrieval from storage", direction:"IN"}}] AS row
CREATE (n:DataFlow{id: row.id}) SET n += row.properties;
UNWIND [{id:"OBJ-001", properties:{created:date('2026-05-17'), name:"Meeting", description:"Root aggregate representing a single meeting being processed. Owns Recording, Transcript, Protocol. Top-level object referenced by all downstream entities.", stereotype:"aggregate", updated:date('2026-05-17'), status:"draft"}}, {id:"OBJ-002", properties:{created:date('2026-05-17'), name:"Recording", description:"Metadata for the uploaded video file. Tracks filename, size, MIME, object storage path, and optional duration. Physical file in EXT-04.", stereotype:"entity", updated:date('2026-05-17'), status:"draft"}}, {id:"OBJ-003", properties:{created:date('2026-05-17'), name:"TranscriptionJob", description:"Async job tracking the ASR+diarization pipeline for a recording. Used to detect failure and surface error details.", stereotype:"job", updated:date('2026-05-17'), status:"draft"}}, {id:"OBJ-004", properties:{created:date('2026-05-17'), name:"Transcript", description:"Persisted verbatim speaker-attributed transcript from ASR+diarization. Segments stored inline as structured content rather than separate entities at MVP scope.", stereotype:"document", updated:date('2026-05-17'), status:"draft"}}, {id:"OBJ-005", properties:{created:date('2026-05-17'), name:"ProtocolGenerationJob", description:"Async job tracking LLM-based protocol generation for a transcript. Created automatically when transcription job completes.", stereotype:"job", updated:date('2026-05-17'), status:"draft"}}, {id:"OBJ-006", properties:{created:date('2026-05-17'), name:"Protocol", description:"Persisted meeting protocol Markdown produced by LLM and optionally refined by user. Sections: participants, topics, decisions, action items with assignees/deadlines. Version-incremented on each save.", stereotype:"document", updated:date('2026-05-17'), status:"draft"}}] AS row
CREATE (n:BusinessEntity{id: row.id}) SET n += row.properties;
UNWIND [{_id:541, properties:{level:"L2", created_at:datetime('2026-08-13T11:11:21.126Z'), alternatives_considered:["keep current (rejected: 404 is a gateway routing failure, not MODEL_NOT_FOUND - the model is never in the URL, so the current classifier bricks a meeting on the first transient blip and in-envelope provider errors are misreported as empty completions)", "retry every status including 400/401 (rejected: unbounded token spend and delayed operator feedback on genuinely permanent auth/quota/contract errors)", "special-case only the observed 404 without the effective-status rule (rejected: leaves in-envelope 429/5xx - the HTTP-200 path - still permanently failing, which is the second half of the reported bug)"], source:"3c7c757", title:"kie.ai HTTP 404 and in-envelope {code,msg} errors are classified by effective status; 404 is transient", delivered_in_release:"v0.3.1", created_by:"nacl-tl-fix", rationale:"Empirically (live probes against api.kie.ai on 2026-08-13, reproduced independently): POST /claude/v1/messages with an invalid Bearer key returns HTTP 200 + {code:401,msg:...}, and any unrouted path returns HTTP 404 + a Spring Boot whitelabel body. The model id travels in the request BODY (kieai.ts:138), never in the URL, so a 404 cannot mean MODEL_NOT_FOUND - the previous spec claim in .tl/external-contracts/kie-anthropic.md section 8 was factually wrong. kie.ai's 404 means 'gateway did not route the path', a transient failure of the gateway (incident 2026-05-26: the identical request returned 200 twelve minutes later). Retrying costs at most 2 extra attempts and ~15s of backoff, and a genuinely permanent 404 still lands in FAILED after exhaustion - so transience is the strictly safer default. The in-envelope rule is required because otherwise a rate limit (code 429 inside HTTP 200) bricks a meeting instantly while being reported as a parse error.", chosen:"Classify on an EFFECTIVE status: body.code when an HTTP 200 body carries a numeric code other than 200, otherwise the HTTP status. TRANSIENT = 404/408/429/5xx plus network/transport failures; PERMANENT = 400/401/402/413, any other unlisted 4xx, and local parse/empty-completion/missing-section errors.", context:"worker/src/llm/kieai.ts classifies transience as `response.status === 429 || response.status >= 500`. A kie.ai HTTP 404 is therefore permanent and a meeting goes FAILED on the first attempt; and a provider error delivered inside HTTP 200 as {code,msg} never reaches the classifier at all - it falls into the empty-completion branch and is reported as the permanent local error 'kie.ai API returned an empty or missing completion text'.", id:"DEC-001", delivered_at:datetime('2026-08-14T08:27:14.518Z'), status:"accepted"}}, {_id:542, properties:{level:"feature", created_at:datetime('2026-05-26T10:34:49.403Z'), alternatives_considered:[], backfilled:true, source:"FR-001 (backfilled from markdown)", backfilled_at:datetime('2026-08-14T08:07:45.099Z'), title:"Worker Job Retry Resilience", delivered_in_release:"v0.3.0", created_by:"provenance-gap-closure runbook (nacl-tl-core/references/provenance-gap-closure.md), Step 2 backfill", rationale:"Recorded in .tl/feature-requests/FR-001-retry-resilience.md (## Feature Description): \"Today a transient ASR/LLM failure permanently bricks a meeting. There is no working retry path: the worker runs with BullMQ attempts=1, and even with retries configured the failure handler writes status=FAILED to Postgres first, so the idempotency guard (status===FAILED -> return) no-ops any re-attempt.\" The FAILED-write ordering, not the absence of retry configuration, is the root cause — which is why the fix is a spec refinement of the failure path rather than a queue-config change.", chosen:"Two-part change: (a) REFINE the worker UCs (UC-200, UC-300) so a TRANSIENT failure with BullMQ attempts remaining re-throws WITHOUT writing status=FAILED — letting the bounded auto retry-with-backoff already specified in RC-UC-200/RC-UC-300 actually work; and (b) ADD UC-004, a user-facing \"Retry processing\" action so an AUTHOR can recover a meeting stuck in FAILED, re-enqueuing whichever stage failed (idempotent on meetingId+stage, offered only when Meeting.status=FAILED, else 409).", delivered_note:"Backfilled decision node (created 2026-08-14) for work actually delivered in v0.3.0 with FR-001; stamped with the release its subject matter shipped in, not the release that authored the node.", context:"Original /nacl-sa-feature intent (Source metadata line of the FR markdown): \"retry resilience: transient ASR/LLM failures permanently brick a meeting (no BullMQ retry; FAILED-write + idempotency guard no-op any re-attempt; RQ-026 said do NOT re-enqueue). Spec retry-with-backoff AND a user-facing regenerate action. Plus a Redis db-index TECH ticket.\" Impact was resolved via Neo4j graph traversal (fulltext sa_impact_analysis + runtime-contract trace). Requirements touched: NEW RQ-034/035/036 (UC-004); MODIFIED RQ-015, RQ-026 (permanent-OR-exhaustion semantics).", id:"DEC-002", status:"accepted"}}, {_id:544, properties:{level:"L2", context:"Meeting.language is three-valued (RU/EN/AUTO) and defaults to AUTO, but protocol-generation collapsed it with `rawLang === 'RU' ? 'RU' : 'EN'`, so every AUTO meeting selected the English prompt template. The ASR-detected language was computed but never persisted (transcripts had no language column), so nothing downstream could correct the choice, and section validation ran against the same wrong language - letting an English protocol for a Russian meeting pass validation and persist silently. Three production meetings were affected.", created_at:datetime('2026-08-14T09:32:40.14Z'), alternatives_considered:["keep current: protocol language follows Transcript.language (rejected: this is what produced the defect - with AUTO the transcript language was unavailable at selection time, so it degenerated into a hard-coded EN fallback)", "resolve AUTO from the detected transcript language, falling back to EN (rejected: retains a silent fallback branch and makes the deliverable's language depend on ASR accuracy)", "always Russian with no exception (rejected: discards the existing EN template and NFR-004 RU+EN coverage for the genuine English-meeting case)"], source:"4b2657e743b818f634e1cd8c7f8d8d6294505341", id:"DEC-003", title:"Protocol language is decided by Meeting.language (RU by default), not by the detected transcript language", created_by:"nacl-tl-fix", rationale:"The product serves Russian-speaking organisations, so the protocol is a working document in the language of the organisation rather than a mirror of the recording. Root cause of the defect was a silent fallback: an unresolved language was mapped onto a concrete template, producing a plausible-looking document in the wrong language that passed every check. Making Russian the explicit default removes the fallback branch entirely rather than making it smarter, so there is no longer a path where an unresolved language silently picks a template. Keeping template selection on Meeting.language (author intent) rather than Transcript.language (observation) also means a detection error can no longer change the language of the deliverable.", status:"accepted", chosen:"Protocol language resolves from Meeting.language only: EN selects the English template, RU and AUTO both select the Russian template. Russian is the default output regardless of the language spoken in the recording; English requires an explicit author choice at upload. Separately, the ASR-detected language is now persisted on Transcript.language (RQ-018/BRQ-005) as a record of the recording and as the source for transcript-language display - explicitly NOT as a control input for template selection. The AUTO -> EN fallback is removed with no replacement fallback."}}, {_id:548, properties:{updated_at:datetime('2026-08-17T08:36:04.383Z'), level:"feature", context:"Prod evidence: 24 recordings, max 363 MB / 4429 s. Storage is external S3 (s3.cloud.ru), so VPS disk was never the constraint despite the initial assumption. Ten graph nodes disagreed about the limit before this decision - six still said 500 MB while four said 1 GiB.", created_at:datetime('2026-08-15T14:44:15.615Z'), alternatives_considered:["8 GB via Deepgram async callback mode - rejected for this change: 12-18 engineer-days, a public callback endpoint, an AWAITING_CALLBACK migration and a dropped-callback sweeper; also gated on an unverified assumption that Deepgram can fetch presigned URLs from s3.cloud.ru at usable throughput", "~4-5 GB via streaming ffmpeg to S3 + Opus + transcribeUrl - rejected as still bounded by Deepgram's 10-minute synchronous processing cap, and it needs LLM context chunking for Russian transcripts", "Byte cap only, no duration gate - rejected because byte size does not bound the pipeline: identical byte counts differ by 4-5x in duration depending on source bitrate", "Keep 1 GiB and only fix the pipeline - rejected as it leaves the stated requirement lower than what the fixed pipeline demonstrably supports"], source:"FR-002", id:"DEC-004", title:"Upload cap raised to 1.5 GiB and bounded by a 4-hour duration gate", created_by:"nacl-sa-feature", rationale:"Measurement showed the advertised 1 GiB was already unreachable, so raising the number alone would have converted an honest client-side rejection into a mid-pipeline failure. Two implementation defects bound the real ceiling to roughly 400-600 MB: the Deepgram SDK's 60s default request timeout covered upload plus processing, and the extracted audio was copied three times in memory against a 1024M worker cap. Both are now fixed. 8 GB was rejected because it needs Deepgram's async callback mode - a two-phase BullMQ pipeline, a public callback endpoint, a schema migration and a timeout sweeper - which is a redesign, not a limit change. 1.5 GiB with a 4h gate is the largest value the synchronous pipeline can honestly honour. MEASURED on production hardware against a real recording (2026-08-16), not estimated: FLAC extraction at 16-bit yields 13.1 kB/s versus 32 kB/s for pcm_s16le (59% smaller), so a 4h recording is a 182 MB payload - 9% of Deepgram's 2 GB cap - and peak worker RSS is ~594 MB against the 1024M pm2 cap, so no pm2 change is needed on a VPS shared with four other products. ASR round-trip was measured at three durations (30s/693s/7200s) rather than assumed: it fits t = 2.16s fixed + 3.09 ms per audio-second, so a 4h recording completes in ~47s - roughly 12x under the 570s client timeout, and the timeout would not bind until ~51h of audio. The K=100x originally assumed in this decision was never measured and is superseded by that fit. Protocol-generation input measured 62410 chars at 2h, i.e. ~125k chars / ~50k tokens at 4h, comfortably inside the 200k context. FLAC losslessness was verified bitwise (decoded FLAC is byte-identical to the pcm_s16le output), so the codec swap cannot affect word-error rate. Pinning -sample_fmt s16 proved essential rather than cosmetic: pcm_s16le pinned the bit depth implicitly, flac does not, and Opus sources decode to float, so the unpinned output was 24-bit - a 355 MB payload and a measured 1113 MB peak RSS, i.e. over the pm2 cap and an OOM restart on every 4h job. The duration gate carries the real constraint: bytes are a poor proxy, since 1.5 GiB is 5.5h at the 656 kbps observed in production but only 71 minutes at 1080p/3 Mbps. ffprobe already runs at finalization and its duration was being discarded.", status:"accepted", chosen:"1.5 GiB byte cap + 14,400 s duration gate, plus the pipeline fixes that make the cap reachable (FLAC extraction, one fewer in-memory audio copy, longer presign validity). Explicitly NOT the 8 GB originally requested."}}, {_id:549, properties:{level:"feature", context:"Requested directly by the product owner after DEC-004 shipped at 1.5 GiB. Observed production bitrate averages 656 kbps, where 4 h is only ~1.1 GiB - so this cap is headroom for high-bitrate sources, not for longer meetings.", created_at:datetime('2026-08-17T09:15:00.191Z'), alternatives_considered:["Raise the duration gate as well - rejected: 4 h is the value every DEC-004 measurement was taken at, and moving it would invalidate the memory, ASR-timing and LLM-context evidence rather than extend it", "Keep 1.5 GiB - rejected: it silently caps 4 h recordings at ~0.9 Mbps, which excludes ordinary 1080p screen capture", "Drop the byte cap entirely and rely only on the duration gate - rejected: the byte cap is what bounds upload time, storage cost and the orphaned-multipart exposure tracked in F-006, none of which duration constrains"], source:"FR-002", id:"DEC-005", title:"Upload byte cap raised 1.5 GiB -> 2.5 GiB; the 4-hour duration gate is unchanged", created_by:"nacl-sa-feature", rationale:"Safe precisely because the byte cap is not what protects the pipeline. Every constraint measured for DEC-004 scales with DURATION, not file size: at the unchanged 4 h ceiling the FLAC payload stays 182 MB, peak worker RSS stays ~594 MB against the 1024M pm2 cap, the ASR round-trip stays ~47 s against a 570 s budget, and the protocol input stays ~50K tokens against a 200K window. None of those numbers move when the byte cap rises, because the pipeline never sees more than 4 h of audio regardless of how large the container is. What the higher cap buys is HIGHER-BITRATE recordings of the same maximum length - up to ~1.5 Mbps at the full 4 h, where 1.5 GiB only allowed ~0.9 Mbps - which is what screen and 1080p capture actually produce. The only cost that scales with bytes is the worker's source read: measured 17 MB/s from the production host to s3.cloud.ru, so 2.5 GiB reads in ~2.6 minutes, against a 2 h presigned-read window and with the event loop free throughout (ffmpeg is a child process, so the BullMQ lock heartbeat keeps renewing). Multipart part count goes to 256 of the 10,000 allowed. Client-side upload is the real user-visible cost: ~36 minutes on a 10 Mbit/s uplink, inside the 6 h presign window set by DEC-004.", status:"accepted", chosen:"MAX_UPLOAD_BYTES = 2_684_354_560 (2.5 GiB). RQ-039's 14,400 s duration gate stays exactly as DEC-004 set it."}}, {_id:809, properties:{program_decisions:["D-3", "D-6", "D-7", "D-8", "A-1", "A-3", "D-15"], level:"feature", context:"Program product, WP-BACKEND-06 contract v1; NFR-007 (no auth) superseded by NFR-011.", created_at:datetime('2026-10-07T17:33:38.875Z'), alternatives_considered:["email/password or OAuth login (rejected by the owner for the MVP)", "per-user lockout (impossible: a wrong PIN identifies nobody)", "backfill only, no DB default (meetings created between deploys would stay ownerless)"], source:"FR-003", id:"DEC-006", title:"Workspace is the isolation unit; PIN-only login with per-client lockout; legacy data goes to a fixed-id workspace «Роман»", created_by:"nacl-sa-feature", rationale:"The owner chose a PIN-only MVP for a small circle (D-8) with workspace isolation (D-6) and legacy meetings belonging to «Роман» (D-7). A wrong PIN cannot point to a user, so the lockout counts per client (A-3). Because merge = production (D-3) and the old code keeps inserting meetings until WP-BACKEND-01 ships, a fixed-id workspace plus a DB default keeps every row owned without changing runtime behaviour.", status:"accepted", chosen:"User/Workspace/Membership/AuthSession/LoginBlock in Postgres; Meeting.workspace_id nullable with a temporary DB default = LEGACY_WORKSPACE_ID until WP-BACKEND-01 sets NOT NULL; identical 404 for foreign and missing resources."}}, {_id:810, properties:{program_decisions:["D-9", "D-10", "Q-1", "Q-2"], level:"feature", context:"Program product, WP-BACKEND-06 contract v1; consumers WP-API-PROJECTS-01, WP-WEB-PROJECTS-01, WP-WORKER-01.", created_at:datetime('2026-10-07T17:33:38.875Z'), alternatives_considered:["read the live project card at generation time (not reproducible)", "separate draft table (two shapes for one concept)", "start immediately and attach context later (contradicts D-9)"], source:"FR-004", id:"DEC-007", title:"Meeting context = draft until POST /start, then an immutable snapshot with snapshot_hash", created_by:"nacl-sa-feature", rationale:"D-9 puts context entry on the upload screen while the file uploads and starts recognition on a button; D-10 fixes the context composition. Freezing a snapshot makes every protocol reproducible from what it was actually generated with, independent of later project edits, and the hash links ProtocolGeneration to it.", status:"accepted", chosen:"MeetingContext row is the draft (snapshot_hash NULL, meeting additions only) and becomes the snapshot at /start (project card copied in with source='project', previous protocol resolved, hash set); upload completes with defer_start and status AWAITING_START."}}, {_id:811, properties:{program_decisions:["D-3", "D-12"], level:"feature", context:"Program product, WP-BACKEND-06 contract v1; consumers WP-BACKEND-01 (USER_EDIT), WP-WORKER-01 (GENERATED), WP-API-FEEDBACK-01, WP-WEB-FEEDBACK-01.", created_at:datetime('2026-10-07T17:33:38.875Z'), alternatives_considered:["version column + snapshots inside Protocol (rewrites old code paths)", "store only diffs (fragile, harder diff with v1)", "drop the edited original silently (marking it LEGACY is honest)"], source:"FR-005", id:"DEC-008", title:"Protocol history is append-only ProtocolVersion rows; Protocol keeps the current text", created_by:"nacl-sa-feature", rationale:"Overwriting Protocol lost the generated original and made feedback unattributable to a text. Keeping Protocol as the current text leaves the pre-program code working on the new schema (D-3), while versions give history, diffs against v1 and a stable anchor for feedback (D-12).", status:"accepted", chosen:"ProtocolVersion(meeting_id, n, kind GENERATED|USER_EDIT|LEGACY) unique per (meeting_id, n) written in the same transaction as the Protocol change; existing protocols backfilled as v1 (LEGACY when edited); ProtocolGeneration audits each LLM run; ProtocolFeedback bound to protocol_version_n with parsed .docx in JSONB."}}, {_id:812, properties:{program_decisions:["D-11", "D-13", "D-14", "D-16", "Q-3"], level:"feature", context:"Program product, WP-BACKEND-06 contract v1; consumers WP-INFRA-01, WP-WORKER-MEMORY-01, WP-API-MEMORY-01, WP-WEB-MEMORY-01.", created_at:datetime('2026-10-07T17:33:38.875Z'), alternatives_considered:["Postgres tables with relations", "Graphiti temporal knowledge graph", "reuse the dev spec Neo4j"], source:"FR-006", id:"DEC-009", title:"Project memory lives in a separate production Neo4j behind ProjectMemoryProvider; Postgres stays the system of record", created_by:"nacl-sa-feature", rationale:"The owner wants knowledge to accumulate automatically (D-11) and chose Neo4j after research Q-3 (D-13); the gate keeps destructive changes under human confirmation (D-14). A provider interface with a real no-memory default lets the protocol pipeline and the memory pipeline ship independently without changing production behaviour.", status:"accepted", chosen:"ADR-013: (:Task)/(:Decision)/(:TaskEvent)/(:ProjectMemory) in Neo4j with workspaceId+projectId on every query; GraphOutbox in Postgres for deletions; worker module worker/src/memory registers its own queue and provider; NoProjectMemoryProvider as the default; gate D-14 for AUTO vs PENDING."}}, {_id:838, properties:{program_decisions:["D-3", "D-9", "D-10", "D-15", "Q-1", "Q-2"], level:"feature", context:"Program product, WP-WORKER-01 (consumer of WP-BACKEND-06 contract v1); Q-1 not measured, Q-2 answered from SDK code: min/max_speakers never reach Deepgram.", created_at:datetime('2026-10-07T20:41:01.684Z'), alternatives_considered:["add the context rules to protocol.md (changes every prod request, breaks the byte-for-byte regression)", "persist ASR options in a new column (needs a migration; package has none)", "fail the protocol when the S3 prompt upload fails (audit outage would block users)"], source:"FR-004", id:"DEC-010", title:"Context is a separate prompt mode; the no-context protocol request stays byte-for-byte unchanged", created_by:"nacl-sa-feature", rationale:"D-3: every merge is a prod deploy, so meetings without context (all of them until WP-API-PROJECTS-01 ships) must not change at all — editing the shared protocol.md would alter every production request. The new rules (context is data, transcript over agenda, speaker mapping only on explicit evidence, T-n codes) only have meaning when context is present, so they live in a context variant. Recording what was sent requires no schema change if keyterms are rebuilt deterministically from the frozen snapshot; a lost prompt archive must not cost the user a protocol.", status:"accepted", chosen:"kieai adapter picks prompts/{ru,en}/protocol-context.md and the sectioned user message only when some context section is non-empty; otherwise protocol.md + raw transcript exactly as before. Keyterms only from a frozen snapshot behind ASR_KEYTERMS_ENABLED (off). ProtocolGeneration + ProtocolVersion(1, GENERATED) in the Protocol transaction; prompt archive in S3 best effort; keyterms/asr_options of the PROTOCOL run reconstructed from snapshot + flag."}}, {_id:856, properties:{level:"feature", context:"WP-API-PROJECTS-01 implementation (PR #20); earlier contract v1 allowed 200000.", created_at:datetime('2026-10-08T10:32:57.07Z'), alternatives_considered:["keep 200000 (contract v1)", "truncate in the worker"], source:"FR-004", id:"DEC-011", title:"Previous-protocol text is limited to 50000 characters in the shared schema; project protocol is resolved at /start", created_by:"nacl-sa-feature", rationale:"D-25: a previous protocol is context for the LLM, not an archive — 50000 characters bounds the prompt without silent truncation downstream, and the same constant validates the form and the API. Resolving the project protocol at start (not at PUT) keeps the draft free of stale text and makes the frozen snapshot the single record of what was used.", status:"accepted", chosen:"PREVIOUS_PROTOCOL_MAX_CHARS = 50000 in shared (one Zod limit for API and form); no truncation in the worker; source=project text is resolved inside the /start transaction and a missing protocol fails with 422 PREVIOUS_PROTOCOL_UNAVAILABLE, rolling the start back. A project protocol longer than the limit fails with 422 PREVIOUS_PROTOCOL_TOO_LONG (never truncated), rolling the start back."}}, {_id:874, properties:{level:"feature", context:"D-20 keeps the pre-login web working as workspace Роман until AUTH_REQUIRED=true; the feedback table was designed with a required author.", created_at:datetime('2026-10-08T10:38:34.004Z'), alternatives_considered:["nullable ProtocolFeedback.user_id (schema change, anonymous rows)", "synthetic service user for the legacy principal (seeded row, ambiguous attribution)"], source:"FR-005", id:"DEC-012", title:"Protocol feedback is accepted only from a signed-in user; the legacy principal reads but cannot submit", created_by:"nacl-sa-feature", rationale:"ProtocolFeedback.user_id is a mandatory FK to users (WP-BACKEND-06 schema) and the legacy principal of D-20 has no users row. Allowing the submission would need a schema change (nullable user_id or a service user) outside WP-API-FEEDBACK-01, and anonymous feedback would be unattributable. Feedback is a quality loop for real authors who log in by PIN (FR-003), so refusing the legacy mode costs little.", status:"accepted", chosen:"POST /api/meetings/:id/feedback answers 401 UNAUTHENTICATED without a session even when AUTH_REQUIRED=false"}}, {_id:887, properties:{level:"feature", context:"D-38 (owner decision after the 2026-10-08 feedback analysis); D-9 deferred-start pattern; speaker_map already exists and is pre-filled by the worker.", created_at:datetime('2026-10-08T19:18:41.877Z'), alternatives_considered:["Looser LLM prompt rule (rejected: wrong names without evidence)", "Pass participants list to the diarisation (not supported by Deepgram, D-21)", "Confirm after the protocol and regenerate (rejected: costs a second LLM run)"], source:"FR-007", id:"DEC-013", title:"Speaker names are confirmed by the author (AWAITING_SPEAKERS) instead of guessed by the LLM; labels can be merged, never split", created_by:"nacl-sa-feature", rationale:"The <speaker_mapping> prompt rule forbids naming without explicit evidence, so most labels stay «Speaker N», and when a model does guess it errs (feedback 2026-10-08). The author knows who spoke; a confirmation step with the project participants is cheap and deterministic. Merging labels fixes over-segmentation; under-segmentation needs re-diarisation and stays a documented limit (D-21). Existing meetings and meetings without context keep the old flow, so the change is additive.", status:"accepted", chosen:"A new status AWAITING_SPEAKERS for context meetings; PUT /api/meetings/:id/speakers writes transcripts.speaker_map and starts protocol generation"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Decision;
UNWIND [{id:"SYS-001", properties:{in_scope:["Video file upload (300-500 MB)", "Audio extraction from video", "Automatic Speech Recognition (ASR) with speaker diarization", "Verbatim transcript generation with per-speaker timestamps", "Meeting protocol generation: participants list, discussion topics, decisions, action items with assignees and deadlines", "Download / export of both artifacts by the user", "Markdown protocol format with in-app rendered view component", "In-app editing of the protocol (markdown editor)", "PDF export of the protocol (via export script)", "Bilingual support: Russian and English (per-upload)"], success_criteria:["User can upload a 300-500 MB video and receive a verbatim speaker-attributed transcript", "User can receive a structured meeting protocol with participants, topics, decisions, and action items", "Both artifacts are produced without manual intervention after upload", "Timestamps in transcript are accurate to the second"], created:date('2026-05-17'), name:"Transcrib", out_of_scope:["Real-time / live meeting transcription (batch processing only)", "Video playback or video editing", "User authentication and access management (no multi-tenancy assumed)", "Payment, billing, or subscription management", "Mobile native applications", "Integration with calendar or meeting platforms (e.g. Zoom, Teams)", "Sending or distributing the protocol to participants automatically"], updated:date('2026-05-17'), constraints:["Input files up to 300-500 MB must be handled without timeout", "Tech stack is TBD - no stack-specific constraints defined yet", "Processing may be asynchronous due to large file sizes and ASR latency", "Languages supported: Russian + English", "No processing-time SLA: async, best effort", "Protocol stored and edited as Markdown; PDF is export-only"], assumptions:["[assumption] A single user role (Meeting Participant) covers the primary stakeholder", "[assumption] An external ASR/diarization engine is required; vendor/model TBD", "[assumption] An LLM-based service is required for protocol generation; provider TBD", "[assumption] A file/object storage service is required to hold large video files; service TBD", "[assumption] One video at a time per user session; queue/parallelism design TBD"], status:"draft", goals:["Transcribe audio from large meeting video files (300-500 MB) with speaker diarization", "Produce a verbatim, speaker-attributed transcript with minute/second timestamps", "Generate a structured meeting protocol: participants, topics discussed, decisions made, action items with assignees and deadlines"]}}] AS row
CREATE (n:SystemContext{id: row.id}) SET n += row.properties;
