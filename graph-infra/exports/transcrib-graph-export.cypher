UNWIND [{_id:372, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"DateTime", name:"last_edited_at", description:"Timestamp of the most recent manual save. Null until the user edits at least once.", id:"Protocol-A05", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:373, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), name:"edit_count", data_type:"Int", description:"Number of manual saves performed since initial generation (BRQ-015). Starts at 0.", id:"Protocol-A06", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:374, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), name:"version", data_type:"Int", description:"Monotonically incrementing version number. Starts at 1 on generation; incremented by 1 on each save (BRQ-014).", id:"Protocol-A07", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:519, properties:{internal:false, nullable:false, data_type:"JSON", name:"segments_blob", description:"JSONB array of Deepgram word/utterance segments (speaker, start, end, text). Source of truth for segments_count and speakers_count. Default [].", id:"Transcript-A09", type:"JSON", derived:false}}, {_id:611, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"id", description:"Первичный ключ", id:"User-A01", updated:"2026-10-07T17:22:19.38Z"}}, {_id:612, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"String", name:"name", description:"Имя, показываемое в меню и в авторстве версий/отзывов", id:"User-A02", updated:"2026-10-07T17:22:19.38Z"}}, {_id:613, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"String", name:"pin_lookup", description:"HMAC-SHA256(PIN, PIN_PEPPER); UNIQUE — PIN уникален среди пользователей", id:"User-A03", updated:"2026-10-07T17:22:19.38Z"}}, {_id:614, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"String", name:"pin_hash", description:"Медленный солёный хеш PIN (scrypt), проверяется после lookup, сравнение постоянного времени", id:"User-A04", updated:"2026-10-07T17:22:19.38Z"}}, {_id:615, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"DateTime", name:"created_at", description:"Когда заведён", id:"User-A05", updated:"2026-10-07T17:22:19.38Z"}}, {_id:616, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"id", description:"Первичный ключ", id:"Workspace-A01", updated:"2026-10-07T17:22:19.38Z"}}, {_id:617, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"String", name:"name", description:"Название (в переключателе пространств)", id:"Workspace-A02", updated:"2026-10-07T17:22:19.38Z"}}, {_id:618, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"Boolean", name:"personal", description:"true = личное пространство пользователя", id:"Workspace-A03", updated:"2026-10-07T17:22:19.38Z"}}, {_id:619, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"DateTime", name:"created_at", description:"Когда создано", id:"Workspace-A04", updated:"2026-10-07T17:22:19.38Z"}}, {_id:620, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"id", description:"Первичный ключ", id:"Membership-A01", updated:"2026-10-07T17:22:19.38Z"}}, {_id:621, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"user_id", description:"FK → User (CASCADE)", id:"Membership-A02", updated:"2026-10-07T17:22:19.38Z"}}, {_id:622, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"workspace_id", description:"FK → Workspace (CASCADE)", id:"Membership-A03", updated:"2026-10-07T17:22:19.38Z"}}, {_id:623, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"DateTime", name:"created_at", description:"Когда выдано", id:"Membership-A04", updated:"2026-10-07T17:22:19.38Z"}}, {_id:624, properties:{internal:true, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"id", description:"Первичный ключ", id:"AuthSession-A01", updated:"2026-10-07T17:22:19.38Z"}}, {_id:625, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"UUID", name:"user_id", description:"FK → User (CASCADE)", id:"AuthSession-A02", updated:"2026-10-07T17:22:19.38Z"}}, {_id:626, properties:{internal:false, nullable:false, created:"2026-10-07T17:22:19.38Z", data_type:"String", name:"token_hash", description:"SHA-256 токена из cookie; UNIQUE", id:"AuthSession-A03", updated:"2026-10-07T17:22:19.38Z"}}] AS row
