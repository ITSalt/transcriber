UNWIND [{id:"ROL-01", properties:{code:"author", responsibility:"Provides a valid source recording; reviews and corrects the generated protocol to ensure accuracy before distribution.", created:date('2026-05-17'), authority:"Upload video recordings; view own transcripts and protocols; edit own protocols in the Markdown editor; export own protocols to PDF; delete own recordings and derived artifacts.", name:"Author", description:"The person who uploaded a meeting recording and owns the resulting transcript and protocol. The primary - and at MVP the only - active human role.", updated:date('2026-05-17'), status:"draft"}}, {id:"ROL-02", properties:{assumption_note:"No authentication or sharing mechanism exists at MVP. Recorded for completeness and future multi-user scope; no distinct system behavior today.", code:"reviewer", responsibility:"Validates decisions and action items from an attendee perspective.", created:date('2026-05-17'), authority:"View protocols shared with them; annotate or comment on protocol content (future).", name:"Reviewer", description:"A meeting participant (typically the organizer, STK-02) who reads/annotates a protocol produced by another person. No technical distinction from Author at MVP.", updated:date('2026-05-17'), status:"draft"}}] AS row
CREATE (n:BusinessRole{id: row.id}) SET n += row.properties;
UNWIND [{id:"SR-01", properties:{system_only:false, responsibilities:"Upload meeting recordings; observe pipeline progress; view/download transcripts; review and edit generated protocols; export protocols to PDF; delete own meetings and derived artifacts.", created:datetime('2026-05-18T06:53:14.885Z'), name:"AUTHOR", description:"The end-user who uploads a meeting recording and owns the derived artifacts (Recording, Transcript, Protocol). The sole active human role at MVP. Merges BA roles ROL-01 Author and ROL-02 Reviewer (the Reviewer has no distinct behavior at MVP per BA assumption). FR-003 (2026-10-07): AUTHOR = вошедший по PIN член пространства; видит и меняет всё в пространствах, где состоит (D-6); чужое и несуществующее — одинаковый 404.", type:"internal", updated:"2026-10-07T17:26:15.593Z", status:"draft"}}, {id:"SR-02", properties:{system_only:true, responsibilities:"Run TranscriptionJob workflow (ASR + diarization); auto-create ProtocolGenerationJob on transcript completion; run LLM protocol generation; persist Transcript and Protocol artifacts; update Meeting.status as the pipeline progresses; record error_reason on failures.", created:datetime('2026-05-18T06:53:14.885Z'), name:"SYSTEM", description:"Infrastructure role representing automated background workers and async pipeline machinery. Owns job lifecycles (transcription, protocol generation), auto-triggers downstream jobs per BRQ-007, and writes Meeting.status updates per BRQ-008. No BA mapping; not user-facing.", type:"internal", updated:datetime('2026-05-18T06:53:14.885Z'), status:"draft"}}, {id:"SR-03", properties:{system_only:false, responsibilities:"pnpm --filter @transcrib/api run user:create | user:grant | user:reset-pin | user:unblock | user:blocks", source_fr:"FR-003", created:"2026-10-07T17:26:15.593Z", name:"OPERATOR", description:"Владелец/агент с доступом к серверу: заводит пользователей и пространства, выдаёт членство, сбрасывает PIN и снимает блокировки через CLI в api (A-1, A-3). В веб-интерфейсе не представлен; PIN руками в SQL не заводится.", type:"internal", updated:"2026-10-07T17:26:15.593Z", status:"draft"}}] AS row
CREATE (n:SystemRole{id: row.id}) SET n += row.properties;
UNWIND [{id:"BP-001-S01", properties:{actor:"STK-01", step_order:1, created:date('2026-05-17'), name:"Open Upload Page", description:"User navigates to the upload section. System renders the file upload form with format hints and size constraints visible.", stereotype:"manual", updated:date('2026-05-17'), status:"draft"}}, {id:"BP-001-S02", properties:{actor:"STK-01", assumption_note:"Language selection optional at upload; auto-detect by ASR engine if omitted.", step_order:2, created:date('2026-05-17'), name:"Select File and Language Hint", description:"User picks a video file and optionally selects a language hint (RU or EN). If omitted, auto-detection is applied in BP-002.", artifact_name:"VideoFile", stereotype:"manual", updated:date('2026-05-17'), artifact_kind:"file", status:"draft"}}, {id:"BP-001-S03", properties:{actor:"System", step_order:3, created:date('2026-05-17'), name:"Validate File", description:"System checks file format (MP4/MKV/MOV/WebM), size (max 2.5 GiB) and recording duration (max 4 h). On failure, user gets inline error and may retry.", artifact_name:"VideoFile", stereotype:"decision", updated:datetime('2026-08-17T09:14:40.768Z'), artifact_kind:"file", status:"draft"}}, {id:"BP-001-S03-REJ", properties:{actor:"System", created:date('2026-05-17'), name:"Show Validation Error", description:"System displays inline error (unsupported format or size). User remains on upload page and may retry with a different file.", stereotype:"automated", updated:date('2026-05-17'), status:"draft"}}, {id:"BP-001-S04", properties:{actor:"System", step_order:4, created:date('2026-05-17'), name:"Upload File in Chunks to Object Storage", description:"System transfers the validated video file to object storage (EXT-04) via chunked/multipart upload. Progress shown to user.", artifact_name:"VideoFile", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"file", status:"draft"}}, {id:"BP-001-S05", properties:{actor:"System", step_order:5, created:date('2026-05-17'), name:"Create Recording and UploadJob Records", description:"System persists a Recording entity (file metadata, storage path, language hint) and an UploadJob record, linking them.", artifact_name:"Recording", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"entity", status:"draft"}}, {id:"BP-001-S06", properties:{actor:"System", step_order:6, created:date('2026-05-17'), name:"Enqueue Transcription Job", description:"System pushes a TranscriptionJob message to the async queue, referencing the Recording. Triggers BP-002.", artifact_name:"TranscriptionJob", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"message", status:"draft"}}, {id:"BP-001-S07", properties:{actor:"System", step_order:7, created:date('2026-05-17'), name:"Show Upload Confirmation", description:"System shows \"Upload complete, transcription is processing\" with a link to the recording detail page.", stereotype:"automated", updated:date('2026-05-17'), status:"draft"}}, {id:"BP-002-S01", properties:{actor:"System (transcription worker)", step_order:1, created:date('2026-05-17'), name:"Dequeue transcription job", artifact_name:"TranscriptionJob", description:"Transcription worker polls the async job queue and dequeues the next pending job, extracting job ID, file reference, and language hint.", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"entity", status:"draft"}}, {id:"BP-002-S02", properties:{actor:"EXT-04 (Object Storage)", step_order:2, created:date('2026-05-17'), name:"Fetch video file from object storage", description:"Worker retrieves the raw video file from object storage (EXT-04) using the stored file reference. Streamed or downloaded to a working location.", artifact_name:"VideoFile", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"file", status:"draft"}}, {id:"BP-002-S03", properties:{actor:"System (transcription worker)", assumption_note:"Audio demux is an internal sub-step with no business decision; not modelled as a separate BP.", step_order:3, created:date('2026-05-17'), name:"Extract audio stream from video", description:"Worker demuxes the video container to extract the raw audio stream. Re-encoding only if ASR mandates a specific codec/sample rate.", artifact_name:"AudioStream", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"file", status:"draft"}}, {id:"BP-002-S04", properties:{actor:"EXT-02 (ASR/Diarization Engine)", assumption_note:"Language hint passed per-job; auto-detect if unset. ASR supports RU and EN at minimum.", step_order:4, created:date('2026-05-17'), name:"Submit audio to ASR/diarization engine", description:"Worker submits audio to EXT-02 with a language hint (RU/EN) or auto-detect flag.", artifact_name:"ASRRequest", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"message", status:"draft"}}, {id:"BP-002-S05", properties:{actor:"System (transcription worker)", step_order:5, created:date('2026-05-17'), name:"ASR result: success or failure?", description:"Worker evaluates EXT-02 response. Success: speaker-attributed segments. Failure: timeout, engine error, or empty result -> failure branch.", artifact_name:"ASRResponse", stereotype:"decision", updated:date('2026-05-17'), artifact_kind:"message", status:"draft"}}, {id:"BP-002-S06", properties:{actor:"EXT-02 (ASR/Diarization Engine)", step_order:6, created:date('2026-05-17'), name:"Receive speaker-attributed transcript segments", description:"Worker receives structured response from EXT-02 with speaker labels, start/end timestamps, and verbatim text per segment.", artifact_name:"TranscriptSegments", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"entity", status:"draft"}}, {id:"BP-002-S07", properties:{actor:"System (transcription worker)", step_order:7, created:date('2026-05-17'), name:"Assemble and persist full transcript", description:"Worker merges segments into a full ordered speaker-attributed transcript and persists it, linked to the originating job and meeting record.", artifact_name:"Transcript", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"entity", status:"draft"}}, {id:"BP-002-S08", properties:{actor:"System (transcription worker)", step_order:9, created:date('2026-05-17'), name:"Update job status to transcript ready", description:"Worker marks the transcription job completed with status transcript ready and emits/queues a protocol-generation job, triggering BP-004.", artifact_name:"JobStatusUpdate", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"event", status:"draft"}}, {id:"BP-002-S09", properties:{actor:"System (transcription worker)", assumption_note:"Failure notification at MVP is a UI status flag; push/email is out of scope. Retry logic TBD with tech stack.", step_order:10, created:date('2026-05-17'), name:"Mark job failed and surface error", description:"Worker marks job failed, records the error reason, and updates status so the UI can surface the failure state.", artifact_name:"JobStatusUpdate", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"event", status:"draft"}}, {id:"BP-004-S01", properties:{actor:"System", step_order:1, created:date('2026-05-17'), name:"Receive Transcript-Ready Event", description:"Protocol worker triggered by transcript-ready event emitted when BP-002 completes. Event carries meeting ID.", artifact_name:"TranscriptReadyEvent", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"event", status:"draft"}}, {id:"BP-004-S02", properties:{actor:"System", step_order:2, created:date('2026-05-17'), name:"Load Transcript", description:"Worker retrieves the verbatim speaker-attributed transcript by meeting ID.", artifact_name:"Transcript", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"data", status:"draft"}}, {id:"BP-004-S03", properties:{actor:"System", assumption_note:"Prompt template storage and versioning TBD (config/file/DB). Language detection: heuristic or ASR metadata.", step_order:3, created:date('2026-05-17'), name:"Select Prompt Template by Language", description:"Worker detects source language (RU/EN) and loads the matching structured-extraction prompt template. Prompt instructs LLM to produce protocol in same language as source.", artifact_name:"PromptTemplate", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"template", status:"draft"}}] AS row
CREATE (n:WorkflowStep{id: row.id}) SET n += row.properties;
UNWIND [{id:"BP-004-S04", properties:{actor:"EXT-03", step_order:4, created:date('2026-05-17'), name:"Submit Transcript + Prompt to LLM", description:"Worker assembles LLM request with transcript + prompt and submits to EXT-03. Specifies required sections: participants, topics, decisions, action items with assignees/deadlines.", artifact_name:"LLMRequest", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"api-payload", status:"draft"}}, {id:"BP-004-S05", properties:{actor:"System", step_order:5, created:date('2026-05-17'), name:"LLM Response Valid?", description:"Worker inspects LLM response. Success: 2xx with non-empty structured content. Failure: HTTP error, timeout, or malformed body.", artifact_name:"LLMResponse", stereotype:"decision", updated:date('2026-05-17'), artifact_kind:"api-payload", status:"draft"}}, {id:"BP-004-S06", properties:{actor:"System", step_order:6, created:date('2026-05-17'), name:"Parse LLM Response into Protocol Draft", description:"Worker parses output into structured Markdown with sections: Participants, Discussed Topics, Decisions Made, Action Items (assignee + deadline).", artifact_name:"ProtocolDraft", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"document", status:"draft"}}, {id:"BP-004-S07", properties:{actor:"System", assumption_note:"Section is present if heading exists with at least one non-empty content line. Partial-accept threshold TBD; MVP routes any missing section to failure.", step_order:7, created:date('2026-05-17'), name:"All Required Sections Present?", description:"Worker validates the draft contains all four required sections. Missing -> failure.", artifact_name:"ProtocolDraft", stereotype:"decision", updated:date('2026-05-17'), artifact_kind:"document", status:"draft"}}, {id:"BP-004-S08", properties:{actor:"System", step_order:8, created:date('2026-05-17'), name:"Persist Protocol as Markdown", description:"Worker writes validated draft to data store as Markdown linked to the meeting record.", artifact_name:"Protocol", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"document", status:"draft"}}, {id:"BP-004-S09", properties:{actor:"System", step_order:9, created:date('2026-05-17'), name:"Update Status to Protocol Ready", description:"Worker sets meeting status to protocol ready, making it available for BP-005.", artifact_name:"MeetingStatus", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"status", status:"draft"}}, {id:"BP-004-S10", properties:{actor:"System", assumption_note:"Retry (manual user-triggered or auto with back-off) TBD at SA phase. Errors logged for diagnostics.", step_order:10, created:date('2026-05-17'), name:"Update Status to Protocol Generation Failed", description:"Worker sets meeting status to protocol generation failed so the UI surfaces the error. User may retry manually.", artifact_name:"MeetingStatus", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"status", status:"draft"}}, {id:"BP-002-S07B", properties:{actor:"System (transcription worker)", assumption_note:"Name resolution method TBD: heuristic regex/lookup over the transcript, or a dedicated LLM pass with a name-resolution prompt. Mapping confidence threshold TBD. Unresolved labels stay as Speaker N.", step_order:8, created:date('2026-05-17'), name:"Resolve speaker names from dialogue context", description:"After segments are assembled, scan the transcript for self-introductions and addressed names (e.g., \"��, ��������, ...\", \"��������, ������ ���� ��������������?\"). When a name can be reliably associated with a speaker label, substitute the anonymous label (Speaker 1, Speaker 2, ...) with the resolved name across the transcript. Labels without a confident mapping remain as Speaker N.", artifact_name:"Transcript", stereotype:"automated", updated:date('2026-05-17'), artifact_kind:"entity", status:"draft"}}] AS row
CREATE (n:WorkflowStep{id: row.id}) SET n += row.properties;
UNWIND [{id:"FORM-MeetingCatalog", properties:{name_ru:"Встречи", name:"Встречи", description:"List view of all meetings owned by the current author. Each row is a Meeting with key metadata and status. Auto-refreshes for transient statuses.", updated:datetime('2026-10-09T10:34:25.457Z'), name_en:"Meeting catalog"}}, {id:"FORM-MeetingDetail", properties:{name_ru:"Сведения", name:"Сведения", description:"Detail panel for a single meeting: shows Meeting + Recording metadata, current job error_reason on FAILED, and conditional action links (view transcript / review protocol / export PDF / delete).", updated:datetime('2026-10-09T10:34:25.457Z'), name_en:"Meeting detail"}}, {id:"FORM-MeetingDeleteConfirm", properties:{name:"Confirm meeting deletion", description:"Confirmation dialog before destructive cascade-delete. Warns if a job is IN_PROGRESS.", updated:datetime('2026-05-18T07:04:29.613Z')}}, {id:"FORM-MeetingUpload", properties:{name_ru:"Загрузить запись встречи", name:"Загрузить запись встречи", description:"File picker + language hint + optional title. Submits to server, which streams in chunks to EXT-04 with progress reporting; inline validation errors per BRQ-001/002/003.", updated:datetime('2026-10-09T10:34:25.457Z'), name_en:"Upload meeting video"}}, {id:"FORM-TranscriptView", properties:{name:"Transcript view", description:"Read-only view of the verbatim transcript with speaker labels and timestamps. Header shows transcript metadata. Provides a one-click Download action.", updated:datetime('2026-05-18T07:07:50.001Z')}}, {id:"FORM-ProtocolEditor", properties:{name:"Protocol editor", description:"Markdown editor for the meeting protocol with side-by-side rendered preview. Header shows version + edit_count + last_edited_at. Save action increments version and edit_count per BRQ-014/015.", updated:datetime('2026-05-18T07:09:31.14Z')}}] AS row
CREATE (n:Form{id: row.id}) SET n += row.properties;
UNWIND [{id:"GPR-01", properties:{created:date('2026-05-17'), name:"Transcription Pipeline", description:"All processes from initial video upload through delivery of a verbatim, speaker-attributed transcript. Covers file handling, audio extraction, ASR/diarization, and transcript storage.", updated:date('2026-05-17'), status:"draft"}}, {id:"GPR-02", properties:{created:date('2026-05-17'), name:"Protocol Lifecycle", description:"All processes that transform a completed transcript into a structured meeting protocol: LLM-based generation, in-app review and editing, and PDF export.", updated:date('2026-05-17'), status:"draft"}}] AS row
CREATE (n:ProcessGroup{id: row.id}) SET n += row.properties;
UNWIND [{id:"BP-001", properties:{owner:"STK-01", outputs:["File stored in object storage (EXT-04)", "Transcription job queued", "Upload confirmation shown to user"], inputs:["Raw video file (300-500 MB, MP4/MKV/MOV or similar)"], created:date('2026-05-17'), name:"Upload Meeting Video", description:"User selects and uploads a meeting video file (up to 2.5 GiB, max 4 h of recording) via the web interface. System validates the file, stores it in object storage, and enqueues an async transcription job.", trigger:"User initiates an upload action in the UI", updated:datetime('2026-08-17T09:14:40.768Z'), has_decomposition:true, status:"draft"}}, {id:"BP-002", properties:{outputs:["Verbatim speaker-attributed transcript with timestamps stored in the system", "Processing status updated to transcript ready"], owner:"STK-01", assumption_note:"Audio extraction step (demux from video container) is treated as an internal sub-step, not a separate business process, because it has no business decision point.", inputs:["Video/audio file from object storage (EXT-04)", "Speaker diarization request to ASR engine (EXT-02)"], created:date('2026-05-17'), name:"Transcribe Audio (ASR + Diarization)", description:"System retrieves the uploaded video from storage, extracts audio, submits it to the ASR/diarization engine (EXT-02), receives speaker-attributed transcript segments, assembles and persists the verbatim transcript.", trigger:"Transcription job is dequeued from the async processing queue", has_decomposition:true, updated:date('2026-05-17'), status:"draft"}}, {id:"BP-003", properties:{owner:"STK-01", outputs:["Transcript file delivered to user (download)"], assumption_note:"Simple retrieval/download operation. No complex branching at MVP scope.", inputs:["Persisted verbatim transcript (from BP-002)"], created:date('2026-05-17'), name:"Download / Retrieve Transcript", description:"User views and downloads the completed verbatim transcript from the system. The transcript is rendered in the UI and offered as a downloadable text/document file.", trigger:"User navigates to transcript view and requests download", has_decomposition:false, updated:date('2026-05-17'), status:"draft"}}, {id:"BP-004", properties:{owner:"STK-01", outputs:["Meeting protocol stored as Markdown", "Processing status updated to protocol ready"], assumption_note:"Protocol generation is triggered automatically after transcription completes; no manual user action is required to initiate it.", inputs:["Verbatim speaker-attributed transcript (from BP-002)", "Prompt template for structured protocol extraction"], created:date('2026-05-17'), name:"Generate Meeting Protocol", description:"System submits the verbatim transcript to the LLM protocol generator (EXT-03) with a structured extraction prompt. The LLM returns a meeting protocol. System persists the protocol as Markdown.", trigger:"Transcription job completes successfully (transcript is ready)", has_decomposition:true, updated:date('2026-05-17'), status:"draft"}}, {id:"BP-005", properties:{owner:"STK-01", outputs:["Updated meeting protocol saved as Markdown"], assumption_note:"Free-form Markdown edit; no structured field validation required at MVP scope.", inputs:["Generated meeting protocol in Markdown (from BP-004 or previous edit)"], created:date('2026-05-17'), name:"Review and Edit Protocol", description:"User opens the generated protocol in the in-app Markdown editor, reviews its content, makes corrections or additions, and saves the updated version.", trigger:"User opens the protocol view and chooses to edit", has_decomposition:false, updated:date('2026-05-17'), status:"draft"}}, {id:"BP-006", properties:{owner:"STK-01", outputs:["PDF file delivered to user (download)"], assumption_note:"PDF rendering uses a server-side export script (e.g. Pandoc or headless browser). Specific tool TBD with tech stack.", inputs:["Current meeting protocol Markdown (from BP-004 or BP-005)"], created:date('2026-05-17'), name:"Export Protocol to PDF", description:"User requests a PDF export of the meeting protocol. System renders the Markdown to PDF via an export script and delivers the file as a download.", trigger:"User clicks Export to PDF in the protocol view", has_decomposition:false, updated:date('2026-05-17'), status:"draft"}}] AS row
CREATE (n:BusinessProcess{id: row.id}) SET n += row.properties;
UNWIND [{id:"ent-001", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-common", name:"Meeting", description:"Root aggregate representing a single meeting being processed. Owns Recording, Transcript, Protocol references and tracks overall pipeline status.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-002", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-ingest", name:"Recording", description:"Metadata for the uploaded video file (filename, size, MIME, storage path). Physical file lives in EXT-04 Object Storage.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-003", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-transcription", name:"TranscriptionJob", description:"Async job tracking the ASR+diarization pipeline for a recording. Surfaces success/failure and error details.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-004", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-transcription", name:"Transcript", description:"Persisted verbatim speaker-attributed transcript from ASR+diarization. Segments stored inline at MVP scope.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-005", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-protocol", name:"ProtocolGenerationJob", description:"Async job tracking LLM-based protocol generation for a transcript. Auto-created when transcription completes.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-006", properties:{shared:false, created:datetime('2026-05-18T06:35:21.947Z'), module:"mod-protocol", name:"Protocol", description:"Persisted meeting protocol Markdown produced by LLM and refined by user. Sections: participants, topics, decisions, action items. Version-incremented on save.", updated:datetime('2026-05-18T06:35:21.947Z'), status:"draft"}}, {id:"ent-007", properties:{shared:false, source_fr:"FR-003", created:"2026-10-07T17:22:19.38Z", module:"mod-access", name:"User", description:"Человек, входящий по 6-значному PIN (D-8). PIN не хранится: pin_lookup = HMAC-SHA256(PIN, PIN_PEPPER) для уникального поиска, pin_hash = scrypt с солью (A-1, A-3). Заводится оператором через CLI user:create.", code_ref:"api/prisma/schema.prisma model User (users)", storage:"postgres", updated:"2026-10-07T17:22:19.38Z", status:"draft"}}, {id:"ent-008", properties:{shared:false, source_fr:"FR-003", created:"2026-10-07T17:22:19.38Z", module:"mod-access", name:"Workspace", description:"Пространство — единица изоляции: все участники видят всё в нём (D-6). У каждого пользователя личное (personal), общие — по членству. Личное пространство «Роман» с фиксированным id 00000000-0000-4000-8000-000000000001 создаётся миграцией и владеет всеми встречами до программы (D-7).", code_ref:"api/prisma/schema.prisma model Workspace (workspaces)", storage:"postgres", updated:"2026-10-07T17:22:19.38Z", status:"draft"}}, {id:"ent-009", properties:{shared:false, source_fr:"FR-003", created:"2026-10-07T17:22:19.38Z", module:"mod-access", name:"Membership", description:"Членство пользователя в пространстве; UNIQUE(user_id, workspace_id). Выдаётся CLI user:grant или user:create --workspace.", code_ref:"api/prisma/schema.prisma model Membership (memberships)", storage:"postgres", updated:"2026-10-07T17:22:19.38Z", status:"draft"}}, {id:"ent-010", properties:{shared:false, source_fr:"FR-003", created:"2026-10-07T17:22:19.38Z", module:"mod-access", name:"AuthSession", description:"Серверная сессия входа. Cookie transcrib_session (httpOnly; Secure; SameSite=Lax; 30 дней) несёт случайный токен, в БД — только его SHA-256. Выход удаляет сессию.", code_ref:"api/prisma/schema.prisma model AuthSession (auth_sessions)", storage:"postgres", updated:"2026-10-07T17:22:19.38Z", status:"draft"}}, {id:"ent-011", properties:{shared:false, source_fr:"FR-003", created:"2026-10-07T17:22:19.38Z", module:"mod-access", name:"LoginBlock", description:"Счётчик неудачных вводов PIN по ключу клиента (IP из X-Forwarded-For, доверяемого только от прокси 127.0.0.1) плюс общая строка client_key='*' (A-3). На 10-й неудаче ставится blocked_at; снимается только CLI user:unblock (D-8).", code_ref:"api/prisma/schema.prisma model LoginBlock (login_blocks)", storage:"postgres", updated:"2026-10-07T17:22:19.38Z", status:"draft"}}, {id:"ent-012", properties:{shared:false, source_fr:"FR-004", created:"2026-10-07T17:23:08.437Z", module:"mod-projects", name:"Project", description:"Проект пространства: группирует встречи и несёт общий контекст (участники, глоссарий) и память (FR-006). Удаление проекта не удаляет встречи (Meeting.project_id → NULL) и пишет GraphOutbox DELETE_PROJECT.", code_ref:"api/prisma/schema.prisma model Project (projects)", storage:"postgres", updated:"2026-10-07T17:23:08.437Z", status:"draft"}}, {id:"ent-013", properties:{shared:false, source_fr:"FR-004", created:"2026-10-07T17:23:08.437Z", module:"mod-projects", name:"ProjectParticipant", description:"Постоянный участник встреч проекта (D-10). Имя и варианты написания идут в ASR keyterms (первым приоритетом) и в секцию <participants> LLM; спикеров сопоставляет LLM.", code_ref:"api/prisma/schema.prisma model ProjectParticipant (project_participants)", storage:"postgres", updated:"2026-10-07T17:23:08.437Z", status:"draft"}}, {id:"ent-014", properties:{shared:false, source_fr:"FR-004", created:"2026-10-07T17:23:08.437Z", module:"mod-projects", name:"GlossaryTerm", description:"Термин глоссария проекта (D-10). Все термины идут в секцию <glossary> LLM; термины с asr_keyterm — ещё и в ASR keyterms (после имён и организаций, в пределах 50 штук). Не путать с BA-глоссарием спецификации (метка :GlossaryTerm).", code_ref:"api/prisma/schema.prisma model GlossaryTerm (glossary_terms)", storage:"postgres", updated:"2026-10-07T17:23:08.437Z", status:"draft"}}, {id:"ent-015", properties:{shared:false, source_fr:"FR-004", created:"2026-10-07T17:23:08.437Z", module:"mod-projects", name:"MeetingContext", description:"Контекст одной встречи (D-9, D-10), 1:1 с Meeting. Жизненный цикл: ЧЕРНОВИК (PUT /api/meetings/:id/context, только в AWAITING_START; snapshot_hash NULL; в participants/glossary только добавления встречи, source='meeting') → СНИМОК (POST /start: карточка проекта копируется с source='project', подставляется текст предыдущего протокола, snapshot_hash = sha256(canonicalSnapshotJson)). После старта не меняется; правки проекта снимок не трогают. Контекст необязателен.", code_ref:"api/prisma/schema.prisma model MeetingContext (meeting_contexts); shared/src/api/context.ts", storage:"postgres", updated:"2026-10-07T17:23:08.437Z", status:"draft"}}, {id:"ent-016", properties:{shared:false, source_fr:"FR-005", created:"2026-10-07T17:23:56.385Z", module:"mod-protocol", name:"ProtocolGeneration", description:"Аудит одного прогона LLM — протокола или шага памяти: модель, версия промпта (sha256 файла шаблона), снимок контекста, ASR keyterms и опции, токены. Отвечает на вопрос «чем и из чего сделана версия».", code_ref:"api/prisma/schema.prisma model ProtocolGeneration (protocol_generations)", storage:"postgres", updated:"2026-10-07T17:23:56.385Z", status:"draft"}}, {id:"ent-017", properties:{shared:false, source_fr:"FR-005", created:"2026-10-07T17:23:56.385Z", module:"mod-protocol", name:"ProtocolVersion", description:"Неизменяемая история протокола, только добавление; n = 1, 2, … на встречу, UNIQUE(meeting_id, n). v1 GENERATED пишется в той же транзакции, что Protocol (UC-300); каждое сохранение — USER_EDIT с автором в транзакции PUT protocol (UC-301). Существующие протоколы бэкфиллятся как v1 (LEGACY при edit_count>0, иначе GENERATED). Protocol.markdown_content остаётся текущим текстом.", code_ref:"api/prisma/schema.prisma model ProtocolVersion (protocol_versions)", storage:"postgres", updated:"2026-10-07T17:23:56.385Z", status:"draft"}}, {id:"ent-018", properties:{shared:false, source_fr:"FR-005", created:"2026-10-07T17:23:56.385Z", module:"mod-protocol", name:"ProtocolFeedback", description:"Отзыв на конкретную (текущую на момент отправки) версию протокола: комментарий, исправленный протокол или Word с комментариями/правками. Файл хранится в s3://bucket/ws/<workspaceId>/feedback/<id>/<имя> и сразу разбирается в extracted (D-12).", code_ref:"api/prisma/schema.prisma model ProtocolFeedback (protocol_feedback); shared/src/api/feedback.ts", storage:"postgres", updated:"2026-10-07T17:23:56.385Z", status:"draft"}}, {id:"ent-019", properties:{shared:false, source_fr:"FR-006", created:"2026-10-07T17:25:01.194Z", module:"mod-memory", name:"GraphOutbox", description:"Транзакционный outbox Postgres → Neo4j памяти проекта (D-13). Строка пишется в той же транзакции, что и изменение (удаление встречи с проектом → DELETE_MEETING, удаление проекта → DELETE_PROJECT), и выбирается воркером с повторами, пока Neo4j недоступен.", code_ref:"api/prisma/schema.prisma model GraphOutbox (graph_outbox); shared GraphOutboxEntry", storage:"postgres", updated:"2026-10-07T17:25:01.194Z", status:"draft"}}, {id:"ent-020", properties:{shared:false, source_fr:"FR-006", created:"2026-10-07T17:25:01.194Z", module:"mod-memory", name:"Task", description:"Задача реестра проекта в графе памяти (не путать с :Task плана разработки в этом графе спецификации). Текущее состояние = результат применённых TaskEvent; код T-n последователен в пределах проекта. Связи: ASSIGNED_TO→:Participant, MENTIONED_IN {quote,startMs,endMs,speakerLabel,kind}→:Meeting, DEPENDS_ON, DUPLICATE_OF, SUBTASK_OF; всегда с workspaceId и projectId.", code_ref:"Neo4j памяти (:Task); shared MemoryTask", storage:"neo4j-memory", updated:"2026-10-07T17:25:01.194Z", status:"draft"}}] AS row
CREATE (n:DomainEntity{id: row.id}) SET n += row.properties;
UNWIND [{id:"ent-021", properties:{shared:false, source_fr:"FR-006", created:"2026-10-07T17:25:01.194Z", module:"mod-memory", name:"Decision", description:"Решение, принятое на встрече проекта, в графе памяти (не путать с :Decision проектных решений в этом графе). Код D-n в пределах проекта; MENTIONED_IN→:Meeting с цитатой, LEADS_TO→:Task, SUPERSEDES→:Decision.", code_ref:"Neo4j памяти (:Decision); shared MemoryDecision", storage:"neo4j-memory", updated:"2026-10-07T17:25:01.194Z", status:"draft"}}, {id:"ent-022", properties:{shared:false, source_fr:"FR-006", created:"2026-10-07T17:25:01.194Z", module:"mod-memory", name:"TaskEvent", description:"Битемпоральное изменение одного поля задачи (OF_TASK→:Task, IN_MEETING→:Meeting). Гейт D-14: новые задачи, упоминания и уверенные обновления — AUTO; закрытие, отмена, слияние, смена исполнителя и неуверенные — PENDING с цитатой. Несёт workspaceId/projectId, чтобы /api/task-events/:id искался с фильтром по пространствам вызывающего.", code_ref:"Neo4j памяти (:TaskEvent); shared TaskEvent", storage:"neo4j-memory", updated:"2026-10-07T17:25:01.194Z", status:"draft"}}, {id:"ent-023", properties:{shared:false, source_fr:"FR-006", created:"2026-10-07T17:25:01.194Z", module:"mod-memory", name:"ProjectMemory", description:"Версионируемая сводка проекта (OF_PROJECT→:Project, PREVIOUS→предыдущая версия), обновляется после каждого протокола (D-11). Вместе с открытыми задачами и свежими решениями отдаётся в секцию <project_memory> через ProjectMemoryProvider (≤ ~5000 токенов).", code_ref:"Neo4j памяти (:ProjectMemory); shared ProjectMemoryResponse", storage:"neo4j-memory", updated:"2026-10-07T17:25:01.194Z", status:"draft"}}] AS row
CREATE (n:DomainEntity{id: row.id}) SET n += row.properties;
UNWIND [{_id:210, properties:{summary:"L1-L8 internal consistency check passed. All ProcessGroups contain BPs (L1). All has_decomposition BPs have workflows (L2). All workflow steps have actors (L3). 2 UI-feedback steps (BP-001-S03-REJ, BP-001-S07) lack artifact_name ��� accepted as pure UI messages (L4). All entities have PRODUCES/CONSUMES (L5). All roles have PERFORMS; all BPs with manual steps have a role (L6). EXT-01 (User) glossary gap resolved via GLO-027 (L7). BRQ-019 APPLIES_TO gap resolved by linking to OBJ-003/OBJ-005 (L8).", phase:"BA", checks_l4_artifact_binding:"pass-with-warnings", created:date('2026-05-17'), checks_l5_entity_matrix:"pass", warnings_accepted:2, critical_errors:0, checks_l2_decomposition:"pass", checks_l1_process_completeness:"pass", checks_l6_role_matrix:"pass", checks_l3_actor_binding:"pass", checks_l7_glossary:"pass-after-fix", id:"VAL-BA-001", updated:date('2026-05-17'), warnings_resolved:2, checks_l8_rules:"pass-after-fix", run_date:date('2026-05-17'), status:"passed"}}, {_id:211, properties:{coverage_role:"100% (2/2 BA roles MAPPED_TO)", coverage_entity:"100% (6/6 BA entities REALIZED_AS; 43/43 attributes TYPED_AS)", created:datetime('2026-05-18T07:18:59.462Z'), critical_count:34, fixes_pending:"Fix A: 13 Module->Requirement HAS_REQUIREMENT edges for NFRs. Fix B: 28 WorkflowStep->UseCase AUTOMATES_AS edges (BP-001 8 steps -> UC-100; BP-002 10 -> UC-200; BP-004 10 -> UC-300). Fix C: system_uc=true on UC-001/002/003/201/301/302 (SA-only or BPs with no decomposed BA steps). Fix D: 4 IMPLEMENTED_BY edges - BRQ-004 -> NFR-004 + RQ-012; BRQ-019 -> NFR-003; BRQ-020 -> NFR-005.", findings:"CRITICAL: L2.1 (9 disconnected NFRs); XL6.1 (22 automated steps without AUTOMATES_AS); XL9.1 (3 unimplemented BRQs: BRQ-004, BRQ-019, BRQ-020). WARNING: L3.2 (9 NFRs not linked to any UC, same as L2.1); XL6.2 (9 UCs untraced from BA, none flagged system_uc). INFO: L4.2 (3 unreferenced attrs: TranscriptionJob.status, ProtocolGenerationJob.status, ProtocolGenerationJob.error_reason - by design); L6.3 (7 cross-module RELATES_TO edges - by design toward Meeting and Transcript). PASS: L1 (data consistency), L2.2-L2.5 (connectivity), L3.1/3.3-3.6 (UC completeness), L4.1/4.3/4.4 (MAPS_TO integrity), L5 (UC-Form), L6.1/6.2/6.4 (cross-module), XL7 (entity coverage), XL8 (role coverage).", overall_status:"FAIL", info_count:10, user_decision:"pause_for_review", layer:"SA", coverage_uc:"0% (0/22 automated WorkflowSteps have AUTOMATES_AS)", warning_count:9, id:"VR-SA-001", updated:datetime('2026-05-18T07:18:59.462Z'), coverage_rule:"85.7% (18/21 BRQ IMPLEMENTED_BY; BRQ-004/019/020 unmapped)"}}, {_id:212, properties:{coverage_role:"100% (2/2 BA roles MAPPED_TO)", coverage_entity:"100% (6/6 BA entities REALIZED_AS)", notes:"Fixes A,B,C,D successfully reduced criticals from 34 to 3 and warnings from 9 to 9. XL6 went 0% to 100%. XL9 went 85.7% to 100% by edge presence, but XL9.3 integrity check requires those Requirements to also be linked to UseCases. Phase 8 finalize blocked by XL9.3 critical.", created:datetime('2026-05-18T07:26:28.55Z'), findings:"CRITICAL: XL9.3 x3 - BRQ-004 IMPLEMENTED_BY NFR-004, BRQ-019 IMPLEMENTED_BY NFR-003, BRQ-020 IMPLEMENTED_BY NFR-005, where each NFR target is not linked to any UseCase (orphan Requirement). Root cause: NFR-001..NFR-009 are linked to Modules via HAS_REQUIREMENT (Fix A) but not to any UseCase. WARNING: L3.2 x9 - NFR-001..NFR-009 are orphan Requirements w.r.t. UseCases. L4.1 x15 reported but ALL are display/action fields (buttons, headers) - false positives due to FormField.field_category being NULL on 45/45 FormFields (see Step 0d). After backfilling field_category=display|action, those 15 become exempt. INFO: L4.2 x3 attributes not referenced by any FormField (TranscriptionJob.status, ProtocolGenerationJob.status, ProtocolGenerationJob.error_reason). PASS: L1, L2, L3.1/3.3-3.6, L4.3-4.4, L5, L6, L7, XL6 100%, XL7 100%, XL8 100%, XL9.1/9.4 100%.", critical_count:18, fixes_pending:"Link NFR-001..NFR-009 to relevant UseCases via UseCase-[:HAS_REQUIREMENT]->NFR (currently only Module-[:HAS_REQUIREMENT]->NFR exists from Fix A). Suggested mapping: NFR-001 (500MB upload) -> UC-100; NFR-002 (async jobs) -> UC-100/UC-200/UC-300; NFR-003 (no SLA) -> UC-200/UC-300; NFR-004 (RU/EN) -> UC-100/UC-200/UC-300; NFR-005 (storage retention) -> UC-100; NFR-006 (markdown canonical) -> UC-300; NFR-007 (no auth MVP) -> UC-001/002/003 (system UCs); NFR-008 (failure surfacing) -> UC-200/UC-300; NFR-009 (single-user) -> UC-001. Also backfill FormField.field_category for 45 fields via /nacl-sa-flags to eliminate L4.1 false-positives.", overall_status:"FAIL", info_count:6, user_decision:"review_required", findings_after_flags_backfill:"After backfill expected: CRITICAL 3 (XL9.3 only), WARNING 9, INFO 6. Phase 8 blocked by 3 XL9.3 critical.", layer:"SA", coverage_uc:"100% (28/28 automated WorkflowSteps AUTOMATES_AS)", findings_strict:"CRITICAL strict total 18: XL9.3 x3 (BRQ-004->NFR-004; BRQ-019->NFR-003; BRQ-020->NFR-005). L4.1 x15 (buttons/headers without MAPS_TO) all false positives due to FormField.field_category NULL on 45/45 fields. Remediation: /nacl-sa-flags backfill-all. WARNING: L3.2 x9 (NFR-001..NFR-009 orphan from UCs). INFO: L4.2 x3.", warning_count:9, id:"VR-SA-002", updated:datetime('2026-05-18T07:26:57.118Z'), coverage_rule:"100% (21/21 BRQ IMPLEMENTED_BY)"}}, {_id:213, properties:{coverage_role:"100% (2/2 BA roles MAPPED_TO)", coverage_entity:"100% (6/6 BA entities REALIZED_AS)", notes:"Fix E (17 UseCase-[:HAS_REQUIREMENT]->NFR edges) resolved 3 real XL9.3 CRITICAL. Fix F (FormField.field_category backfill: 45 fields -> input/action/display) resolved 15 L4.1 false-positive CRITICAL. Fix G (DomainEntity.shared=false on 6 entities) silenced L6.1 noise. Fix H (TranscriptionJob/ProtocolGenerationJob.status/error_reason marked internal=true) silenced 4 L4.2 INFO. All previous warnings cleared - the 9 L3.2 WARNINGs (orphaned NFR requirements) were eliminated when NFRs were attached to UseCases via Fix E. Graph is clean. Ready for Phase 8 finalize.", created:datetime('2026-05-18T00:00:00Z'), critical_count:0, fixes_pending:"None - all critical and warning findings resolved.", findings:"L1-L7 internal PASS (0 issues). XL6-XL9 cross-validation PASS (0 issues). Coverage metrics: UC 100%, Entity 100%, Role 100%, Rule 100%. INFO observations: 7 cross-module RELATES_TO edges (L6.3 informational), 2 BusinessRoles both map to single AUTHOR SystemRole (XL8.3, intentional N:1 collapse), 16 EnumValues use both .value and .label properties (L1.5 dual convention, acceptable since .value is populated for all). Pre-flight: 0 schema drift, all exemption properties 100% populated.", overall_status:"PASS", info_count:4, user_decision:"pending - awaiting confirmation to proceed to /nacl-sa-finalize", layer:"SA", coverage_uc:"100% (28/28 automated WorkflowSteps AUTOMATES_AS)", warning_count:0, id:"VR-SA-003", coverage_rule:"100% (21/21 BRQ IMPLEMENTED_BY)"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ValidationReport;
UNWIND [{id:"mod-common", properties:{finalized_at:date('2026-05-18'), uc_range_start:1, uc_range_end:99, created:datetime('2026-05-18T06:34:50.996Z'), name:"Common / Shell", description:"Cross-cutting module owning the Meeting root aggregate. Provides the meeting catalog/dashboard, navigation shell, global status display, and system-level error surfacing. Referenced by all other modules.", updated:datetime('2026-05-18T06:34:50.996Z'), status:"finalized"}}, {id:"mod-ingest", properties:{finalized_at:date('2026-05-18'), uc_range_start:100, uc_range_end:199, created:datetime('2026-05-18T06:34:50.996Z'), name:"Video Ingest", description:"Handles synchronous, user-driven upload of meeting video files: validation (size, format, integrity), chunked upload to object storage, and Recording entity creation. Realizes BP-001 (Upload Meeting Video). Integrates with EXT-04 Object Storage.", updated:datetime('2026-05-18T06:34:50.996Z'), status:"finalized"}}, {id:"mod-transcription", properties:{finalized_at:date('2026-05-18'), uc_range_start:200, uc_range_end:299, created:datetime('2026-05-18T06:34:50.996Z'), name:"Transcription", description:"Async transcription pipeline: enqueues and processes TranscriptionJob, calls ASR/diarization engine, assembles and persists verbatim speaker-attributed Transcript, and serves transcript download/view. Realizes BP-002 (Transcribe) and BP-003 (Download Transcript). Integrates with EXT-02 ASR/Diarization and EXT-04 Storage.", updated:datetime('2026-05-18T06:34:50.996Z'), status:"finalized"}}, {id:"mod-protocol", properties:{finalized_at:date('2026-05-18'), uc_range_start:300, uc_range_end:399, created:datetime('2026-05-18T06:34:50.996Z'), name:"Protocol Lifecycle", description:"End-to-end Protocol lifecycle: auto-triggered LLM-based generation, in-app Markdown review/edit, and PDF export. Realizes BP-004 (Generate Protocol), BP-005 (Review and Edit Protocol), BP-006 (Export Protocol to PDF). Integrates with EXT-03 LLM Protocol Generator.", updated:datetime('2026-05-18T06:34:50.996Z'), status:"finalized"}}, {id:"mod-access", properties:{uc_range_end:499, uc_range_start:400, source_fr:"FR-003", created:"2026-10-07T17:20:59.285Z", name:"Access & Workspaces", description:"Вход по PIN, серверные сессии, пространства (единица изоляции, D-6) и членство. Все маршруты /api/* кроме health и login требуют сессии; чужое и несуществующее — одинаковый 404. Пользователей и блокировки ведёт оператор через CLI (A-1, A-3). Код: api/src/features/auth (WP-BACKEND-01); таблицы и контракты — WP-BACKEND-06.", updated:"2026-10-07T17:20:59.285Z", status:"draft"}}, {id:"mod-projects", properties:{uc_range_end:599, uc_range_start:500, source_fr:"FR-004", created:"2026-10-07T17:20:59.285Z", name:"Projects & Meeting Context", description:"Проекты пространства с участниками и глоссарием; контекст встречи, вводимый на экране загрузки (D-9, D-10), и отложенный старт распознавания: черновик контекста → снимок при «Начать». Снимок кормит ASR (keyterms) и LLM (секции контекста). Код: api/src/features/{projects,context} (WP-API-PROJECTS-01), worker (WP-WORKER-01).", updated:"2026-10-07T17:20:59.285Z", status:"draft"}}, {id:"mod-memory", properties:{uc_range_start:600, uc_range_end:699, source_fr:"FR-006", created:"2026-10-07T17:20:59.285Z", name:"Project Memory", description:"Память проекта (D-11, D-13, D-14): после каждого протокола LLM извлекает задачи и решения, сопоставляет с реестром проекта и применяет изменения автоматически или через очередь подтверждения; сводка проекта версионируется. Хранилище — отдельный Neo4j на проде (ADR-013); Postgres остаётся источником истины для пространств/проектов/встреч, удаления зеркалятся через GraphOutbox. Код: worker/src/{memory,graph} (WP-WORKER-MEMORY-01), api/src/features/memory (WP-API-MEMORY-01).", updated:"2026-10-07T17:20:59.285Z", status:"draft"}}] AS row
CREATE (n:Module{id: row.id}) SET n += row.properties;
UNWIND [{_id:218, properties:{actor:"User", form_ref:"FORM-MeetingCatalog", description:"AUTHOR opens the meeting catalog page.", id:"UC-001-AS01", updated:datetime('2026-05-18T07:04:19.567Z'), order:1}}, {_id:219, properties:{actor:"System", description:"System loads Meetings owned by the current AUTHOR, sorted by updated_at descending.", id:"UC-001-AS02", updated:datetime('2026-05-18T07:04:19.567Z'), order:2}}, {_id:220, properties:{actor:"System", form_ref:"FORM-MeetingCatalog", description:"System renders one row per Meeting with title (or filename fallback), status badge, language, uploaded_at, and duration_sec from Recording.", id:"UC-001-AS03", updated:datetime('2026-05-18T07:04:19.567Z'), order:3}}, {_id:221, properties:{actor:"System", form_ref:"FORM-MeetingCatalog", description:"For rows in transient states (UPLOADING, TRANSCRIBING, PROTOCOL_GENERATING), System auto-refreshes the row status periodically.", id:"UC-001-AS04", updated:datetime('2026-05-18T07:04:19.567Z'), order:4}}, {_id:222, properties:{actor:"User", form_ref:"FORM-MeetingDetail", description:"AUTHOR navigates to a specific meeting (from catalog or direct link).", id:"UC-002-AS01", updated:datetime('2026-05-18T07:04:19.567Z'), order:1}}, {_id:223, properties:{actor:"System", description:"System loads Meeting + Recording + most recent TranscriptionJob + most recent ProtocolGenerationJob + existence flags for Transcript and Protocol.", id:"UC-002-AS02", updated:datetime('2026-05-18T07:04:19.567Z'), order:2}}, {_id:224, properties:{actor:"System", form_ref:"FORM-MeetingDetail", description:"System renders the detail panel: title, language, status badge, recording metadata, and current job error_reason when Meeting.status=FAILED.", id:"UC-002-AS03", updated:datetime('2026-05-18T07:04:19.567Z'), order:3}}, {_id:225, properties:{actor:"System", form_ref:"FORM-MeetingDetail", description:"System renders conditional action links: View transcript (status >= TRANSCRIPT_READY), Review/Edit protocol (status >= PROTOCOL_READY), Export PDF (status in {PROTOCOL_READY, EDITED}), Delete meeting (always).", id:"UC-002-AS04", updated:datetime('2026-05-18T07:04:19.567Z'), order:4}}, {_id:226, properties:{actor:"User", description:"AUTHOR clicks Delete on the meeting detail page (UC-002).", id:"UC-003-AS01", updated:datetime('2026-05-18T07:04:19.567Z'), order:1}}, {_id:227, properties:{actor:"System", form_ref:"FORM-MeetingDeleteConfirm", description:"System shows confirmation dialog showing the meeting title. If any job is IN_PROGRESS, the dialog warns that the in-flight job will be marked FAILED.", id:"UC-003-AS02", updated:datetime('2026-05-18T07:04:19.567Z'), order:2}}, {_id:228, properties:{actor:"User", form_ref:"FORM-MeetingDeleteConfirm", description:"AUTHOR confirms deletion (or cancels, returning to UC-002 with no changes).", id:"UC-003-AS03", updated:datetime('2026-05-18T07:04:19.567Z'), order:3}}, {_id:229, properties:{actor:"System", description:"System cascade-deletes: any in-flight jobs marked FAILED (error_reason='deleted by user'), Protocol, ProtocolGenerationJob, Transcript, TranscriptionJob, Recording (with storage object removed from EXT-04), Meeting.", id:"UC-003-AS04", updated:datetime('2026-05-18T07:04:19.567Z'), order:4}}, {_id:230, properties:{actor:"System", description:"System redirects to the meeting catalog (UC-001) and shows a success toast.", id:"UC-003-AS05", updated:datetime('2026-05-18T07:04:19.567Z'), order:5}}, {_id:231, properties:{actor:"User", form_ref:"FORM-MeetingUpload", description:"AUTHOR navigates to the Upload page.", id:"UC-100-AS01", updated:datetime('2026-05-18T07:06:29.618Z'), order:1}}, {_id:232, properties:{actor:"User", form_ref:"FORM-MeetingUpload", description:"AUTHOR selects a video file via the file picker and optionally sets the protocol language and title (defaults to filename). The language selector is RU / EN / blank; blank means Meeting.language takes its default AUTO, which yields a RUSSIAN protocol (BRQ-013) with ASR auto-detection of the spoken language (BRQ-005). Selecting EN is the only way to obtain an English protocol (RQ-012).", id:"UC-100-AS02", updated:datetime('2026-08-15T13:59:16.74Z'), order:2}}, {_id:233, properties:{actor:"User", form_ref:"FORM-MeetingUpload", description:"AUTHOR clicks the Upload button.", id:"UC-100-AS03", updated:datetime('2026-05-18T07:06:29.618Z'), order:3}}, {_id:234, properties:{actor:"System", drift_corrected_note:"Text said 500 MB and omitted video/webm while RQ-008/RQ-009 and the shipped code (shared/src/api/uc100.ts MAX_UPLOAD_BYTES = 1_073_741_824, ACCEPTED_UPLOAD_MIME_TYPES incl. video/webm) both said 1 GiB / 4 types. Surfaced by the L3.7 anchor adoption on 2026-08-14.", description:"System validates: size_bytes <= 2.5 GiB / 2,684,354,560 bytes (BRQ-001, raised by DEC-005 per RQ-008), duration <= 14,400 s / 4 h (RQ-039), mime_type in {video/mp4, video/x-matroska, video/quicktime, video/webm} (BRQ-002, video/webm added per RQ-009), container integrity (BRQ-003). Decision step.", id:"UC-100-AS04", updated:datetime('2026-08-17T09:14:27.065Z'), order:4}}, {_id:235, properties:{actor:"System", form_ref:"FORM-MeetingUpload", description:"ALT: If validation fails, System shows a human-readable error inline on FORM-MeetingUpload and returns control to AS02. No Meeting / Recording / storage object is created.", id:"UC-100-AS05", updated:datetime('2026-05-18T07:06:29.618Z'), order:5}}, {_id:236, properties:{actor:"System", description:"System creates Meeting (status=UPLOADING) and Recording (filename, size_bytes, mime_type, uploaded_at; storage_path allocated) records in a single transaction.", id:"UC-100-AS06", updated:datetime('2026-05-18T07:06:29.618Z'), order:6}}, {_id:237, properties:{actor:"System", form_ref:"FORM-MeetingUpload", description:"System streams the file in chunks to EXT-04 Object Storage at the allocated storage_path. Progress is reported back to the client.", id:"UC-100-AS07", updated:datetime('2026-05-18T07:06:29.618Z'), order:7}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:238, properties:{actor:"System", description:"On upload completion, System creates TranscriptionJob (status=QUEUED, recording_id, meeting_id) and transitions Meeting.status UPLOADING -> TRANSCRIBING.", id:"UC-100-AS08", updated:datetime('2026-05-18T07:06:29.618Z'), order:8}}, {_id:239, properties:{actor:"System", description:"System redirects AUTHOR to the meeting detail page (UC-002) with a success toast.", id:"UC-100-AS09", updated:datetime('2026-05-18T07:06:29.618Z'), order:9}}, {_id:240, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"Worker dequeues a QUEUED TranscriptionJob; sets status=IN_PROGRESS and started_at=now. Loads the Meeting with its Recording and its MeetingContext (FR-004).", id:"UC-200-AS01", updated:datetime('2026-10-07T20:38:11.451Z'), order:1}}, {_id:241, properties:{actor:"System", description:"Worker fetches the Recording file from EXT-04 Object Storage using storage_path.", id:"UC-200-AS02", updated:datetime('2026-05-18T07:07:36.989Z'), order:2}}, {_id:242, properties:{actor:"System", description:"Worker extracts the audio stream from the video container and populates Recording.duration_sec.", id:"UC-200-AS03", updated:datetime('2026-05-18T07:07:36.989Z'), order:3}}, {_id:243, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"Worker submits the extracted audio + Meeting.language hint to EXT-02 ASR/Diarization Engine. FR-004 / RQ-048: when ASR_KEYTERMS_ENABLED is on AND the meeting has a FROZEN context snapshot (snapshot_hash NOT NULL, RQ-059), the worker builds keyterms from the snapshot (participant names and aliases → organizations → glossary terms with asr_keyterm; commas replaced, case-insensitive dedup, ≤ 50 terms, conservative estimate ≤ 450 tokens) and passes them as AudioInput.keyterms → Deepgram repeated keyterm= query parameters. Flag off, no snapshot or empty list → the request is byte-for-byte today's. Q-2 (2026-10-07): @deepgram/sdk 5.2.0 transcribeFile serializes only a fixed whitelist of query keys; min_speakers/max_speakers are not in it and are dropped client-side, so the user speaker count has never reached Deepgram (behaviour kept unchanged; the participant count reaches the LLM through <participants>).", id:"UC-200-AS04", updated:datetime('2026-10-07T20:38:11.451Z'), order:4}}, {_id:244, properties:{actor:"System", description:"Worker awaits ASR response. Decision: success vs failure.", id:"UC-200-AS05", updated:datetime('2026-05-18T07:07:36.989Z'), order:5}}, {_id:245, properties:{actor:"System", description:"On success: Worker receives speaker-attributed transcript segments with per-segment timestamps and speaker labels (Speaker 1, Speaker 2, ...).", id:"UC-200-AS06", updated:datetime('2026-05-18T07:07:36.989Z'), order:6}}, {_id:246, properties:{actor:"System", description:"Worker resolves anonymous speaker labels to real names from dialogue context per BRQ-021; populates speaker_map. Unresolved labels remain Speaker N.", id:"UC-200-AS07", updated:datetime('2026-05-18T07:07:36.989Z'), order:7}}, {_id:247, properties:{actor:"System", description:"Worker assembles and persists Transcript (full_text with speakers+timestamps, segments_count, speakers_count, speaker_map, created_at) together with language = the ASR-detected language normalized to RU or EN, or NULL when the provider reported neither (RQ-018, BRQ-005). Meeting.language is left untouched. Transitions Meeting.status -> TRANSCRIPT_READY. Transitions job.status -> COMPLETED with completed_at.", id:"UC-200-AS08", updated:datetime('2026-05-18T07:07:36.989Z'), order:8}}, {_id:248, properties:{actor:"System", description:"Worker auto-creates a ProtocolGenerationJob (status=QUEUED, transcript_id, meeting_id, prompt_template_version) per BRQ-007.", id:"UC-200-AS09", updated:datetime('2026-05-18T07:07:36.989Z'), order:9}}, {_id:249, properties:{actor:"System", description:"ALT (failure path): Worker sets job.status=FAILED with non-null error_reason per BRQ-010 and transitions Meeting.status -> FAILED. Terminal states immutable per BRQ-009.", id:"UC-200-AS10", updated:datetime('2026-05-18T07:07:36.989Z'), order:10}}, {_id:250, properties:{actor:"User", form_ref:"FORM-TranscriptView", description:"AUTHOR clicks 'View transcript' from the meeting detail page (UC-002).", id:"UC-201-AS01", updated:datetime('2026-05-18T07:07:36.989Z'), order:1}}, {_id:251, properties:{actor:"System", description:"System loads the Transcript for the meeting and the speaker_map.", id:"UC-201-AS02", updated:datetime('2026-05-18T07:07:36.989Z'), order:2}}, {_id:252, properties:{actor:"System", form_ref:"FORM-TranscriptView", description:"System renders the transcript with segments, speaker labels (resolved name from speaker_map or 'Speaker N' if unresolved), and timestamps. Header shows segments_count, speakers_count, language, created_at.", id:"UC-201-AS03", updated:datetime('2026-05-18T07:07:36.989Z'), order:3}}, {_id:253, properties:{actor:"User", form_ref:"FORM-TranscriptView", description:"AUTHOR clicks Download.", id:"UC-201-AS04", updated:datetime('2026-05-18T07:07:36.989Z'), order:4}}, {_id:254, properties:{actor:"System", description:"System streams a plain-text file containing the verbatim transcript with speaker labels and timestamps. Filename: '<title>-transcript.txt'.", id:"UC-201-AS05", updated:datetime('2026-05-18T07:07:36.989Z'), order:5}}, {_id:255, properties:{actor:"System", description:"Worker dequeues a QUEUED ProtocolGenerationJob (auto-created by UC-200 AS09); sets status=IN_PROGRESS and started_at=now.", id:"UC-300-AS01", updated:datetime('2026-05-18T07:09:16.868Z'), order:1}}, {_id:256, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"Worker loads the Transcript via meeting_id, reads Meeting.language, Meeting.projectId/workspaceId and the FROZEN MeetingContext snapshot (RQ-059). When the meeting belongs to a project it asks ProjectMemoryProvider.getPromptMemory(projectId, workspaceId) for the <project_memory> text (default NoProjectMemoryProvider → null; provider error → section omitted, RQ-062).", id:"UC-300-AS02", updated:datetime('2026-10-07T20:38:11.451Z'), order:2}}, {_id:257, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"Worker selects the LLM prompt template by Meeting.language per BRQ-013: EN -> English template, RU or AUTO -> Russian template. The same language value is used for the RQ-023 section validation. When at least one context section is non-empty the context variant of the template (prompts/{ru,en}/protocol-context.md, rules RQ-060) is used; otherwise the unchanged prompts/{ru,en}/protocol.md. prompt_version = sha256 of the selected template file (RQ-051).", id:"UC-300-AS03", updated:datetime('2026-10-07T20:38:11.451Z'), order:3}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:258, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"Worker submits transcript + selected prompt to EXT-03 LLM Protocol Generator. RQ-049: the user message is the context sections <meeting_meta>, <participants>, <agenda>, <glossary>, <previous_protocol>, <notes>, <project_memory> (non-empty only, canonical order, section tags inside the text neutralised) followed by <transcript>…</transcript>; with no non-empty section the user message is the raw transcript exactly as today. <meeting_meta> (title, date, meeting type, goal) is emitted only when some other context section is non-empty.", id:"UC-300-AS04", updated:datetime('2026-10-07T20:38:11.451Z'), order:4}}, {_id:259, properties:{actor:"System", description:"Worker awaits LLM response. Decision: valid response vs failure.", id:"UC-300-AS05", updated:datetime('2026-05-18T07:09:16.868Z'), order:5}}, {_id:260, properties:{actor:"System", description:"Worker parses the LLM response into a structured protocol draft (Markdown with four required sections).", id:"UC-300-AS06", updated:datetime('2026-05-18T07:09:16.868Z'), order:6}}, {_id:261, properties:{actor:"System", description:"Worker validates that all four required sections are present (BRQ-011: Participants, Discussion Topics, Decisions, Action Items). Decision.", id:"UC-300-AS07", updated:datetime('2026-05-18T07:09:16.868Z'), order:7}}, {_id:262, properties:{actor:"System", updated_by:"WP-WORKER-01", description:"On success: Worker uploads the rendered user message to s3://…/ws/<workspaceId>/prompts/<generationId>.txt (best effort, RQ-061), then in ONE transaction persists Protocol (markdown_content, version=1, edit_count=0, generated_at=now), ProtocolGeneration (kind PROTOCOL, model, prompt_version, context_snapshot_hash, keyterms, asr_options, input/output tokens, prompt_uri; RQ-051) and ProtocolVersion (n=1, kind GENERATED, generation_id; RQ-050). Transitions Meeting.status -> PROTOCOL_READY. Transitions job.status -> COMPLETED with completed_at.", id:"UC-300-AS08", updated:datetime('2026-10-07T20:38:11.451Z'), order:8}}, {_id:263, properties:{actor:"System", description:"ALT (failure path): On LLM error, invalid response, or missing required sections, Worker sets job.status=FAILED with non-null error_reason per BRQ-010 and transitions Meeting.status -> FAILED. Terminal states immutable per BRQ-009.", id:"UC-300-AS09", updated:datetime('2026-05-18T07:09:16.868Z'), order:9}}, {_id:264, properties:{actor:"User", form_ref:"FORM-ProtocolEditor", description:"AUTHOR clicks 'Review/Edit protocol' from the meeting detail page (UC-002).", id:"UC-301-AS01", updated:datetime('2026-05-18T07:09:16.868Z'), order:1}}, {_id:265, properties:{actor:"System", description:"System loads Protocol by meeting_id with current markdown_content, version, edit_count, last_edited_at.", id:"UC-301-AS02", updated:datetime('2026-05-18T07:09:16.868Z'), order:2}}, {_id:266, properties:{actor:"System", form_ref:"FORM-ProtocolEditor", description:"System renders a Markdown editor with side-by-side rendered preview. Header shows version and edit_count.", id:"UC-301-AS03", updated:datetime('2026-05-18T07:09:16.868Z'), order:3}}, {_id:267, properties:{actor:"User", form_ref:"FORM-ProtocolEditor", description:"AUTHOR edits Markdown content (canonical form per BRQ-018).", id:"UC-301-AS04", updated:datetime('2026-05-18T07:09:16.868Z'), order:4}}, {_id:268, properties:{actor:"User", form_ref:"FORM-ProtocolEditor", description:"AUTHOR clicks Save.", id:"UC-301-AS05", updated:datetime('2026-05-18T07:09:16.868Z'), order:5}}, {_id:269, properties:{actor:"System", description:"System persists updated markdown_content; increments version by 1 (BRQ-014); increments edit_count by 1 (BRQ-015); sets last_edited_at=now; transitions Meeting.status -> EDITED if not already EDITED (BRQ-008).", id:"UC-301-AS06", updated:datetime('2026-05-18T07:09:16.868Z'), order:6}}, {_id:270, properties:{actor:"System", form_ref:"FORM-ProtocolEditor", description:"System shows a save-confirmation indicator with the new version number.", id:"UC-301-AS07", updated:datetime('2026-05-18T07:09:16.868Z'), order:7}}, {_id:271, properties:{actor:"User", form_ref:"FORM-ProtocolEditor", description:"ALT: If AUTHOR navigates away with unsaved changes, System shows an unsaved-changes warning before navigation.", id:"UC-301-AS08", updated:datetime('2026-05-18T07:09:16.868Z'), order:8}}, {_id:272, properties:{actor:"User", description:"AUTHOR clicks 'Export PDF' button on FORM-MeetingDetail (UC-002) or FORM-ProtocolEditor (UC-301).", id:"UC-302-AS01", updated:datetime('2026-05-18T07:09:16.868Z'), order:1}}, {_id:273, properties:{actor:"System", description:"System loads Protocol.markdown_content (canonical Markdown per BRQ-018).", id:"UC-302-AS02", updated:datetime('2026-05-18T07:09:16.868Z'), order:2}}, {_id:274, properties:{actor:"System", description:"System renders the Markdown to PDF via the export pipeline; the PDF is NOT persisted per BRQ-017.", id:"UC-302-AS03", updated:datetime('2026-05-18T07:09:16.868Z'), order:3}}, {_id:275, properties:{actor:"System", description:"System delivers the PDF as a download. Filename pattern: '<meeting-title>-protocol-v<version>.pdf'.", id:"UC-302-AS04", updated:datetime('2026-05-18T07:09:16.868Z'), order:4}}, {_id:276, properties:{actor:"System", description:"ALT: On render failure, System shows an error toast and no file is delivered. No state change is persisted.", id:"UC-302-AS05", updated:datetime('2026-05-18T07:09:16.868Z'), order:5}}, {_id:520, properties:{actor:"User", description:"Open the detail page of a Meeting whose status is FAILED; the page shows error_reason and a \"Retry processing\" action (RQ-036).", id:"UC-004-AS01", updated:datetime('2026-05-26T10:32:06.064Z'), order:1}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:521, properties:{actor:"User", description:"Click \"Retry processing\" and confirm in the dialog.", id:"UC-004-AS02", updated:datetime('2026-05-26T10:32:06.064Z'), order:2}}, {_id:522, properties:{actor:"System", description:"Identify the most recent FAILED job for the meeting (TranscriptionJob or ProtocolGenerationJob) to determine which stage to retry (RQ-034).", id:"UC-004-AS03", updated:datetime('2026-05-26T10:32:06.064Z'), order:3}}, {_id:523, properties:{actor:"System", description:"In one Prisma transaction, reset that job (status=QUEUED, attempt_count=0, error_msg=null) and transition Meeting.status FAILED -> TRANSCRIBING | PROTOCOL_GENERATING per failed stage (RQ-034, BRQ-008).", id:"UC-004-AS04", updated:datetime('2026-05-26T10:32:06.064Z'), order:4}}, {_id:524, properties:{actor:"System", description:"After commit, enqueue the job to BullMQ (idempotent on meetingId+stage; no duplicate if already queued) and publish SSE meeting.status (RQ-035).", id:"UC-004-AS05", updated:datetime('2026-05-26T10:32:06.064Z'), order:5}}, {_id:525, properties:{actor:"System", description:"ALT: if the Meeting is not in FAILED status, reject the action with a 409-class error and make no changes (RQ-036).", id:"UC-004-AS06", updated:datetime('2026-05-26T10:32:06.064Z'), order:6}}, {_id:815, properties:{actor:"User", source_wp:"WP-BACKEND-01", description:"Участник открывает приложение; без сессии (при AUTH_REQUIRED=true) web показывает экран входа и вводит 6-значный PIN.", id:"UC-400-AS01", updated:"2026-10-07T20:18:50.308Z", order:1}}, {_id:816, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"POST /api/auth/login {pin}: определяет ключ клиента (IP из X-Forwarded-For только если запрос пришёл от прокси 127.0.0.1, иначе адрес сокета). Если LoginBlock клиента заблокирован → 423 LOGIN_BLOCKED «Больше нельзя, пиши Максу для разблокировки» без проверки PIN.", id:"UC-400-AS02", updated:"2026-10-07T20:18:50.308Z", order:2}}, {_id:817, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Проверяет формат PIN (6 цифр, иначе 400 PIN_FORMAT); без PIN_PEPPER → 503 AUTH_NOT_CONFIGURED. Ищет User по pin_lookup = HMAC-SHA256(PIN, PIN_PEPPER), проверяет pin_hash (scrypt, timingSafeEqual). Для несуществующего lookup тоже выполняет scrypt (одинаковое время).", id:"UC-400-AS03", updated:"2026-10-07T20:18:50.308Z", order:3}}, {_id:818, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Неудача: в одной транзакции +1 к счётчику клиента и к глобальной строке '*'; на 10-й неудаче клиента ставит blocked_at и отвечает 423, иначе 401 INVALID_PIN «Неверный PIN». Глобально > 100 неудач за час → warn в лог. PIN нигде не логируется.", id:"UC-400-AS04", updated:"2026-10-07T20:18:50.308Z", order:4}}, {_id:819, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Успех: сбрасывает счётчик клиента, создаёт AuthSession (случайный 32-байтный токен, в БД SHA-256, expires_at = +30 дней), ставит cookie transcrib_session (httpOnly; Secure; SameSite=Lax; Path=/; Max-Age 30 дней), отвечает 200 MeResponse.", id:"UC-400-AS05", updated:"2026-10-07T20:18:50.308Z", order:5}}, {_id:820, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Глобальный onRequest для /api/*: health и login публичны; по cookie находит действующую сессию (обновляет last_seen_at не чаще раза в минуту) и ставит request.auth {userId, workspaceIds}. Без сессии: AUTH_REQUIRED=true → 401 UNAUTHENTICATED; false → принципал legacy (только пространство «Роман», D-20).", id:"UC-400-AS06", updated:"2026-10-07T20:18:50.308Z", order:6}}, {_id:821, properties:{actor:"User", source_wp:"WP-BACKEND-01", description:"Участник нажимает «Выйти» в меню пользователя.", id:"UC-401-AS01", updated:"2026-10-07T20:18:50.308Z", order:1}}, {_id:822, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"POST /api/auth/logout: удаляет AuthSession по хешу токена из cookie (если есть), очищает cookie, 204; повтор и вызов без сессии — тоже 204.", id:"UC-401-AS02", updated:"2026-10-07T20:18:50.308Z", order:2}}, {_id:823, properties:{actor:"User", source_wp:"WP-BACKEND-01", description:"Участник открывает приложение или переключает пространство в шапке.", id:"UC-402-AS01", updated:"2026-10-07T20:18:50.308Z", order:1}}, {_id:824, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"GET /api/auth/me → {user, workspaces} (личное первым). При AUTH_REQUIRED=false и без сессии — синтетический пользователь «Роман» и [«Роман»] (D-20); при true без сессии — 401.", id:"UC-402-AS02", updated:"2026-10-07T20:18:50.308Z", order:2}}, {_id:825, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"GET /api/meetings?workspace_id=: без параметра → 400 WORKSPACE_REQUIRED (legacy-принципал: по умолчанию «Роман»); не член → 404 NOT_FOUND; иначе только встречи пространства (WorkspaceMeetingListResponse).", id:"UC-402-AS03", updated:"2026-10-07T20:18:50.308Z", order:3}}, {_id:826, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Каждый маршрут встречи (детали, транскрипт и скачивание, протокол и PUT, PDF, SSE, удаление, повтор) сначала вызывает assertMeetingAccess: встреча не найдена или её workspace_id не в request.auth.workspaceIds → одинаковый 404 NOT_FOUND.", id:"UC-402-AS04", updated:"2026-10-07T20:18:50.308Z", order:4}}, {_id:827, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"Загрузка: init/complete/abort требуют workspace_id с членством (legacy — «Роман»); presigned URL выдаётся только после проверки; новый ключ S3 ws/<workspaceId>/<uuid>.<ext>; complete и abort принимают только ключи этого пространства (и pending/ для загрузок, начатых до выхода пакета).", id:"UC-402-AS05", updated:"2026-10-07T20:18:50.308Z", order:5}}, {_id:828, properties:{actor:"Operator", source_wp:"WP-BACKEND-01", description:"Оператор на сервере запускает pnpm --filter @transcrib/api run user:create -- --name <имя> --pin <6 цифр> [--workspace <имя|id>] (нужны DATABASE_URL и PIN_PEPPER).", id:"UC-403-AS01", updated:"2026-10-07T20:18:50.308Z", order:1}}, {_id:829, properties:{actor:"System", source_wp:"WP-BACKEND-01", description:"user:create: проверяет формат PIN и уникальность pin_lookup (совпадение → отказ, код 1); без --workspace создаёт личное пространство с именем пользователя; с --workspace привязывает членство (по id или точному имени, неоднозначное имя → отказ).", id:"UC-403-AS02", updated:"2026-10-07T20:18:50.308Z", order:2}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:830, properties:{actor:"Operator", source_wp:"WP-BACKEND-01", description:"Другие команды: user:grant -- --user <имя|id> --workspace <имя|id>; user:reset-pin -- --user <имя|id> --pin <6 цифр> (сессии пользователя удаляются); user:blocks (список заблокированных клиентов и счётчиков); user:unblock -- --client <ip> | --all.", id:"UC-403-AS03", updated:"2026-10-07T20:18:50.308Z", order:3}}, {_id:839, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Слушатель события protocolJobCompleted (модуль worker/src/memory) читает ProtocolGenerationJob и встречу; продолжает только при status=DONE и непустых meeting.projectId и meeting.workspaceId — встречи без проекта память не трогают. Ставит задание в очередь project-memory {meeting_id, project_id, workspace_id} с JOB_RETRY_OPTIONS и jobId по встрече и заданию протокола (повторное событие не дублирует задание).", id:"UC-600-AS01", updated:"2026-10-07T20:42:52.779Z", order:1}}, {_id:840, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Задание загружает из Postgres встречу, Transcript.segmentsBlob, протокол и участников проекта. Если в графе уже есть ProjectMemory с sourceMeetingId этой встречи — завершается без изменений (идемпотентность повторной доставки). Без MEMORY_NEO4J_URI модуль выключен: очередь не создаётся, остаётся NoProjectMemoryProvider.", id:"UC-600-AS02", updated:"2026-10-07T20:42:52.779Z", order:2}}, {_id:841, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"MEMORY_EXTRACT: LLM (ILlmCompletionProvider, JSON) получает пронумерованные сегменты транскрипта «[#i] [MM:SS] спикер: текст» и открытые задачи проекта (код, название) и возвращает задачи (название, описание, исполнитель, срок, сигнал статуса) и решения — каждое с дословной цитатой и номером сегмента. Пишется ProtocolGeneration(kind MEMORY_EXTRACT, model, prompt_version = sha256 шаблона, токены).", id:"UC-600-AS03", updated:"2026-10-07T20:42:52.779Z", order:3}}, {_id:842, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Проверка цитат кодом по сегментам: нормализация (регистр, ё→е, пунктуация, пробелы), поиск в указанном сегменте, соседних и во всём транскрипте; нечёткое совпадение — доля токенов цитаты в окне сегментов ≥ 0,85. Таймкод (startMs, endMs) и speakerLabel берутся из найденных сегментов, а не от LLM. Цитата не найдена → пункт отбрасывается с предупреждением в логе.", id:"UC-600-AS04", updated:"2026-10-07T20:42:52.779Z", order:4}}, {_id:843, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Кандидаты для сопоставления: все открытые задачи проекта (OPEN, IN_PROGRESS, POSTPONED); при числе > 200 — лексический предфильтр (пересечение токенов с проверенными пунктами), 200 лучших.", id:"UC-600-AS05", updated:"2026-10-07T20:42:52.779Z", order:5}}, {_id:844, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"MEMORY_RESOLVE: LLM по проверенным пунктам и кандидатам возвращает решения NEW|UPDATE|CLOSE|DUPLICATE|NO_CHANGE с target_task_code, changes, quote_ref, confidence, reason. Валидатор отклоняет решение с неизвестным quote_ref, target_task_code не из кандидатов, недопустимым переходом статуса (canTransitionTaskStatus) или неверными значениями; отклонённое решение логируется и не применяется. Пишется ProtocolGeneration(kind MEMORY_RESOLVE).", id:"UC-600-AS06", updated:"2026-10-07T20:42:52.779Z", order:6}}, {_id:845, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Гейт D-14 (RQ-063): каждое изменение становится TaskEvent AUTO (применяется к задаче) или PENDING (ждёт подтверждения, задача не меняется). Пункт, не упомянутый во встрече, событий не получает.", id:"UC-600-AS07", updated:"2026-10-07T20:42:52.779Z", order:7}}, {_id:846, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"MEMORY_SUMMARY: LLM получает предыдущую сводку проекта, протокол встречи и список изменений (применённых и ожидающих) и возвращает новую сводку в markdown. Пишется ProtocolGeneration(kind MEMORY_SUMMARY).", id:"UC-600-AS08", updated:"2026-10-07T20:42:52.779Z", order:8}}, {_id:847, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Запись одной транзакцией Neo4j: проекции :Project, :Meeting (порядковый номер встречи в проекте), :Participant (MERGE по id с workspaceId, projectId); новые T-n и D-n по счётчикам проекта; рёбра MENTIONED_IN с цитатой, таймкодом, спикером и kind; TaskEvent с OF_TASK/IN_MEETING; ProjectMemory версии n+1 с PREVIOUS. Каждый запрос параметризован workspaceId и projectId.", id:"UC-600-AS09", updated:"2026-10-07T20:42:52.779Z", order:9}}, {_id:848, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"ALT (сбой): ошибка LLM, Neo4j или разбора ответа — задание project-memory падает и повторяется по JOB_RETRY_OPTIONS (FR-001); статус встречи и протокола не меняется; итоговая ошибка видна в состоянии задания (failedReason) и в логе. Транзакция не оставляет частичной записи.", id:"UC-600-AS10", updated:"2026-10-07T20:42:52.779Z", order:10}}, {_id:849, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"ProjectMemoryProvider (Neo4j) для генерации протокола: getPromptMemory(projectId, workspaceId) возвращает сводку, открытые задачи строками «T-42 | Отправить договор | Иванов | до 15.10 | open с встречи 3» и последние решения, ≤ ~5 000 токенов (≈ 20 000 символов, хвост списков обрезается). Памяти нет или Neo4j недоступен → null, секция <project_memory> опускается.", id:"UC-600-AS11", updated:"2026-10-07T20:42:52.779Z", order:11}}, {_id:850, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"API при удалении встречи с проектом или проекта пишет строку GraphOutbox (DELETE_MEETING / DELETE_PROJECT) в той же транзакции Postgres (ядро API).", id:"UC-605-AS01", updated:"2026-10-07T20:42:52.779Z", order:1}}, {_id:851, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Модуль worker/src/memory раз в MEMORY_OUTBOX_POLL_MS (по умолчанию 10 с) выбирает до 50 строк GraphOutbox с done_at IS NULL по created_at; без MEMORY_NEO4J_URI потребитель не запускается и строки ждут.", id:"UC-605-AS02", updated:"2026-10-07T20:42:52.779Z", order:2}}, {_id:852, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"DELETE_MEETING: одной транзакцией Neo4j DETACH DELETE узла :Meeting, его TaskEvent (IN_MEETING), задач и решений, упомянутых только в этой встрече; состояние остальных затронутых задач пересчитывается свёрткой оставшихся применённых событий. DELETE_PROJECT: DETACH DELETE всех узлов с этими workspaceId и projectId. Обе операции идемпотентны.", id:"UC-605-AS03", updated:"2026-10-07T20:42:52.779Z", order:3}}, {_id:853, properties:{actor:"System", source_wp:"WP-WORKER-MEMORY-01", description:"Успех → done_at = now(). Ошибка → attempts + 1, last_error, строка остаётся; при недоступности Neo4j цикл прерывается и повторяется на следующем тике, пока Neo4j не восстановится. Строка с неразбираемым payload помечается last_error и не блокирует остальные.", id:"UC-605-AS04", updated:"2026-10-07T20:42:52.779Z", order:4}}, {_id:857, properties:{actor:"User", description:"AUTHOR opens the protocol history of a meeting.", id:"UC-303-AS01", updated:"2026-10-08T10:38:20.858Z", order:1}}, {_id:858, properties:{actor:"System", description:"System checks workspace membership of the meeting; a foreign or nonexistent meeting gives the same 404 NOT_FOUND (RQ-044).", id:"UC-303-AS02", updated:"2026-10-08T10:38:20.858Z", order:2}}, {_id:859, properties:{actor:"System", description:"System returns versions ascending (n, kind GENERATED/USER_EDIT/LEGACY, author or null, generation_id, created_at) and current_n (null when none).", id:"UC-303-AS03", updated:"2026-10-08T10:38:20.858Z", order:3}}, {_id:860, properties:{actor:"User", description:"AUTHOR opens version n.", id:"UC-303-AS04", updated:"2026-10-08T10:38:20.858Z", order:4}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:861, properties:{actor:"System", description:"System returns the version markdown; n that is unknown, not a positive integer or beyond int4 gives 404 PROTOCOL_VERSION_NOT_FOUND.", id:"UC-303-AS05", updated:"2026-10-08T10:38:20.858Z", order:5}}, {_id:862, properties:{actor:"User", description:"AUTHOR chooses kind (COMMENT / CORRECTED_PROTOCOL / DOCX_REVIEW), optional category, enters text and/or attaches a file.", id:"UC-304-AS01", updated:"2026-10-08T10:38:20.858Z", order:1}}, {_id:863, properties:{actor:"System", description:"System requires a signed-in user: the legacy principal without a session (D-20) gets 401 UNAUTHENTICATED because ProtocolFeedback.user_id is mandatory (DEC-012).", id:"UC-304-AS02", updated:"2026-10-08T10:38:20.858Z", order:2}}, {_id:864, properties:{actor:"System", description:"System validates by kind (shared checkFeedbackSubmission): COMMENT needs text and no file; CORRECTED_PROTOCOL text or .md/.txt/.docx; DOCX_REVIEW a .docx; ALT: 400 FEEDBACK_TEXT_REQUIRED / FEEDBACK_FILE_REQUIRED, 413 FEEDBACK_FILE_TOO_LARGE (over 20 MB), 415 FEEDBACK_FILE_TYPE (extension, MIME, or .docx without PK zip signature).", id:"UC-304-AS03", updated:"2026-10-08T10:38:20.858Z", order:3}}, {_id:865, properties:{actor:"System", description:"System binds the feedback to the current protocol version (max n); ALT: the meeting has no version -> 404 PROTOCOL_VERSION_NOT_FOUND.", id:"UC-304-AS04", updated:"2026-10-08T10:38:20.858Z", order:4}}, {_id:866, properties:{actor:"System", description:"System parses the file: .docx review -> comments with anchored_text, w:ins/w:del revisions, accepted_text, original_text; CORRECTED_PROTOCOL .docx -> plain_text with changes accepted; .md/.txt -> plain_text; ALT: a parse failure does not fail the intake, the file is kept and extracted.error is set (RQ-053).", id:"UC-304-AS05", updated:"2026-10-08T10:38:20.858Z", order:5}}, {_id:867, properties:{actor:"System", description:"System stores the file at s3://bucket/ws/<workspaceId>/feedback/<feedbackId>/<sanitized file name> and writes the ProtocolFeedback row; ALT: if the row cannot be written the stored object is removed.", id:"UC-304-AS06", updated:"2026-10-08T10:38:20.858Z", order:6}}, {_id:868, properties:{actor:"System", description:"System answers 201 FeedbackCreateResponse with extracted and extracted_counts for the UI.", id:"UC-304-AS07", updated:"2026-10-08T10:38:20.858Z", order:7}}, {_id:869, properties:{actor:"User", description:"Participant opens the feedback list of a meeting.", id:"UC-305-AS01", updated:"2026-10-08T10:38:20.858Z", order:1}}, {_id:870, properties:{actor:"System", description:"System returns the feedback of this meeting in its workspace, newest first, with author name, file meta, download_path and extracted_counts.", id:"UC-305-AS02", updated:"2026-10-08T10:38:20.858Z", order:2}}, {_id:871, properties:{actor:"User", description:"Participant downloads an attached file.", id:"UC-305-AS03", updated:"2026-10-08T10:38:20.858Z", order:3}}, {_id:872, properties:{actor:"System", description:"System streams the stored file as an attachment (nosniff); ALT: feedback without a file, foreign or unknown id, or a lost object -> 404 NOT_FOUND.", id:"UC-305-AS04", updated:"2026-10-08T10:38:20.858Z", order:4}}, {_id:876, properties:{actor:"Author", source_wp:"WP-BACKEND-07", description:"Воркер (WP-WORKER-06) после распознавания ставит встречу с контекстом в AWAITING_SPEAKERS и не создаёт задание генерации.", id:"UC-505-AS01", updated:"2026-10-08T19:18:15.219Z", order:1}}, {_id:877, properties:{actor:"Author", source_wp:"WP-BACKEND-07", description:"Автор открывает карточку подтверждения: GET /speakers отдаёт метки с образцами реплик, текущие имена и участников проекта.", id:"UC-505-AS02", updated:"2026-10-08T19:18:15.219Z", order:2}}, {_id:878, properties:{actor:"Author", source_wp:"WP-BACKEND-07", description:"Автор для каждой метки выбирает участника проекта, вводит имя или оставляет «Speaker N»; несколько меток можно сопоставить одному человеку.", id:"UC-505-AS03", updated:"2026-10-08T19:18:15.219Z", order:3}}, {_id:879, properties:{actor:"System", source_wp:"WP-BACKEND-07", description:"PUT /speakers (confirm|skip) в одной транзакции пишет speaker_map, speaker_mapping, speakers_confirmed_at, переводит в GENERATING_PROTOCOL, создаёт ProtocolGenerationJob; после фиксации — очередь и SSE.", id:"UC-505-AS04", updated:"2026-10-08T19:18:15.219Z", order:4}}, {_id:880, properties:{actor:"System", source_wp:"WP-BACKEND-07", description:"Воркер при генерации строит реплики из segments_blob + speaker_map; повтор после FAILED использует сохранённую карту.", id:"UC-505-AS05", updated:"2026-10-08T19:18:15.219Z", order:5}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:ActivityStep;
UNWIND [{_id:277, properties:{ba_role_coverage_pct:100.0, stat_requirements_nfr:9, notes:"All 9 UCs fully detailed (100% detail). All 6 BA entities realized. All 21 BA rules implemented via 28 AUTOMATES_AS edges. 9 NFRs linked to modules and UCs. SA specification approved for development handoff.", stat_components:11, stat_automates_as_edges:28, stat_domain_entities:6, production_url:"https://transcriber.itsalt.ru", next_phase:"nacl-tl-plan", released_at:datetime('2026-05-18T16:15:00Z'), release_url:"https://github.com/ITSalt/transcriber/releases/tag/v0.2.0", layer:"SA", stat_requirements_functional:33, stat_use_cases:9, tl_handoff_ready:true, project_id:"transcrib", stat_forms:6, overall_readiness_pct:100.0, id:"FR-SA-001", uc_readiness_pct:100.0, stat_use_cases_detailed:9, release_tag:"v0.2.0", ba_step_coverage_pct:100.0, stat_modules:4, stat_form_fields:45, created:datetime('2026-05-18T00:00:00Z'), ba_entity_coverage_pct:100.0, module_readiness_json:"[{\"id\":\"mod-common\",\"name\":\"Common / Shell\",\"ucs\":3,\"detailed\":3,\"entities\":1,\"readiness\":100},{\"id\":\"mod-ingest\",\"name\":\"Video Ingest\",\"ucs\":1,\"detailed\":1,\"entities\":1,\"readiness\":100},{\"id\":\"mod-transcription\",\"name\":\"Transcription\",\"ucs\":2,\"detailed\":2,\"entities\":2,\"readiness\":100},{\"id\":\"mod-protocol\",\"name\":\"Protocol Lifecycle\",\"ucs\":3,\"detailed\":3,\"entities\":2,\"readiness\":100}]", validation_summary:"0 critical, 0 warning, 4 info ��� PASSED", entity_readiness_pct:100.0, ba_rule_coverage_pct:100.0, adrs_created:"ADR-001..ADR-011 (tech stack: Fastify+TS, Postgres+Prisma, BullMQ+Redis, MinIO, TUS, Deepgram, kie.ai, Vite+React, Milkdown+Puppeteer, SSE, pnpm monorepo+Compose)", open_questions_remaining:"none", validation_report_ref:"VR-SA-003", stat_system_roles:2, updated:datetime('2026-05-22T12:46:49.391Z'), stat_domain_attributes:44, status:"approved"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:FinalizationReport;
UNWIND [{id:"NFR-001", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"Upload pipeline MUST accept files up to 2.5 GiB via chunked (S3 presigned multipart) transfer without timeout. Presigned part URLs MUST remain valid long enough for a consumer-grade uplink to finish the transfer: at 2.5 GiB a 10 Mbit/s uplink needs ~36 minutes, against the 6 h presign window. (Corrected by DEC-004 from a stale 500 MB; cap raised again by DEC-005.)", category:"performance", type:"nfr", priority:"high", updated:datetime('2026-08-17T09:14:27.065Z'), rationale:"Upload pipeline MUST accept files up to 2.5 GiB via chunked (S3 presigned multipart) transfer without timeout. Presigned part URLs MUST remain valid long enough for a consumer-grade uplink to finish the transfer: at 2.5 GiB a 10 Mbit/s uplink needs ~36 minutes, against the 6 h presign window. (Corrected by DEC-004 from a stale 500 MB; cap raised again by DEC-005.)", status:"draft"}}, {id:"NFR-002", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"Transcription and protocol generation MUST run asynchronously (job-based); UI MUST surface job progress without blocking.", category:"performance", type:"nfr", priority:"high", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Large file processing and external ASR/LLM latency make synchronous execution infeasible (SystemContext).", status:"draft"}}, {id:"NFR-003", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"No processing-time SLA at MVP - best-effort delivery; long-running jobs are acceptable. Bounded in practice by RQ-039: a recording may not exceed 4 h, which caps a single job's worst-case runtime and its provider spend.", type:"nfr", category:"performance", priority:"medium", updated:datetime('2026-08-15T14:43:25.66Z'), rationale:"Explicit non-SLA per BRQ-019; recorded so future readers do not infer a performance budget.", status:"draft"}}, {id:"NFR-004", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"System MUST support Russian and English throughout (UI, ASR language hint, LLM prompts, error messages).", category:"integration", type:"nfr", priority:"high", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Derived from BRQ-004 and SystemContext language constraint.", status:"draft"}}, {id:"NFR-005", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"Recordings MUST persist in durable object storage (EXT-04) until both Transcript and Protocol artifacts are produced.", category:"infrastructure", type:"nfr", priority:"high", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Derived from BRQ-020 retention rule; necessary for async pipeline durability.", status:"draft"}}, {id:"NFR-006", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"Protocol canonical format is Markdown; PDF export is transient (re-rendered on demand, not persisted).", category:"integration", type:"nfr", priority:"high", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Derived from BRQ-017 (PDF transient) and BRQ-018 (Markdown canonical).", status:"draft"}}, {id:"NFR-007", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"MVP runs without authentication or multi-tenancy; all artifacts treated as owned by the uploader within a single trust boundary.", type:"nfr", category:"security", priority:"medium", superseded_by:"NFR-011", updated:"2026-10-07T17:28:51.293Z", rationale:"Per SystemContext out-of-scope and single active role (ROL-01 Author).", superseded_reason:"FR-003 (программа product, 2026-10-07): вход по PIN и изоляция по пространствам (D-6, D-8).", status:"superseded"}}, {id:"NFR-008", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"Job failures MUST be surfaced to the user with a human-readable error_reason; jobs in terminal states (succeeded/failed) are immutable.", category:"infrastructure", type:"nfr", priority:"high", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Derived from BRQ-009 (immutable terminal states) and BRQ-010 (failure recorded with reason).", status:"draft"}}, {id:"NFR-009", properties:{created:datetime('2026-05-18T06:39:52.733Z'), description:"ASSUMPTION: One concurrent user session at MVP - one video processed at a time per user; multi-user/parallel-job scaling design deferred.", priority:"medium", type:"assumption", category:"performance", updated:datetime('2026-05-18T06:39:52.733Z'), rationale:"Per SystemContext assumption 'One video at a time per user session; queue/parallelism design TBD'. Revisit when multi-user scope is added.", status:"needs_review"}}, {id:"RQ-001", properties:{rq_type:"behavioral", description:"Meeting catalog MUST sort meetings by updated_at descending.", source:"behavior", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-002", properties:{rq_type:"behavioral", description:"Meeting rows in transient statuses (UPLOADING, TRANSCRIBING, PROTOCOL_GENERATING) MUST auto-refresh their status without requiring a full page reload.", source:"behavior", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-003", properties:{rq_type:"behavioral", revised_by_fr:"FR-003", description:"AUTHOR видит только встречи пространств, где состоит (BRQ-016 в редакции FR-003: владелец встречи — пространство, D-6). Принуждение — RQ-044 (одинаковый 404 для чужого и несуществующего); до WP-BACKEND-01 все встречи принадлежат пространству «Роман» (RQ-045).", source:"BRQ-016, D-6", type:"functional", priority:"medium", updated:"2026-10-07T17:28:51.293Z", status:"draft"}}, {id:"RQ-004", properties:{rq_type:"behavioral", description:"Meeting detail MUST surface the current job's error_reason when Meeting.status=FAILED.", source:"BRQ-010", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-005", properties:{rq_type:"behavioral", description:"Meeting detail action links MUST be gated by Meeting.status: 'View transcript' enabled when status in {TRANSCRIPT_READY, PROTOCOL_GENERATING, PROTOCOL_READY, EDITED}; 'Review/Edit protocol' enabled when status in {PROTOCOL_READY, EDITED}; 'Export PDF' enabled when status in {PROTOCOL_READY, EDITED}.", source:"behavior", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-006", properties:{rq_type:"behavioral", description:"Meeting deletion MUST cascade-remove all derived artifacts: Protocol, ProtocolGenerationJob, Transcript, TranscriptionJob, Recording (including its storage object in EXT-04), and the Meeting itself.", source:"behavior", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-007", properties:{rq_type:"behavioral", description:"Deletion attempted while a job is IN_PROGRESS MUST require explicit user confirmation and MUST mark the in-flight job as FAILED with error_reason='deleted by user'. Terminal-state immutability (BRQ-009) is preserved for already-completed jobs.", source:"BRQ-009", type:"functional", priority:"high", updated:datetime('2026-05-18T07:05:09.22Z'), status:"draft"}}, {id:"RQ-008", properties:{rq_type:"validation", description:"File size validation MUST reject files where size_bytes > 2,684,354,560 bytes (2.5 GiB) BEFORE any storage upload begins. (500 MB -> 1 GiB post-v0.2.0 -> 1.5 GiB by DEC-004 -> 2.5 GiB by DEC-005; matches shared MAX_UPLOAD_BYTES = 2_684_354_560.) The byte cap protects upload and storage only. The processing pipeline is bounded by RQ-039's duration gate, which is unchanged at 4 h and is what every measured constraint (worker memory, ASR budget, LLM context) actually scales with. Raising the byte cap therefore admits higher-bitrate recordings of the same maximum duration - up to ~1.5 Mbps at the full 4 h - without moving any pipeline limit.", source:"BRQ-001", type:"functional", priority:"high", updated:datetime('2026-08-17T09:14:27.065Z'), status:"draft"}}, {id:"RQ-009", properties:{rq_type:"validation", description:"MIME validation MUST accept exactly {video/mp4, video/x-matroska, video/quicktime, video/webm} and reject all other types with a clear user-facing error message. (video/webm added post-v0.2.0 to support full-meeting WebM recordings; matches shared ACCEPTED_UPLOAD_MIME_TYPES.)", source:"BRQ-002", type:"functional", priority:"high", updated:datetime('2026-05-18T07:06:55.519Z'), status:"draft"}}, {id:"RQ-010", properties:{rq_type:"validation", description:"Container integrity MUST be verified during upload acceptance (probe of header/short-duration sample - exact method TBD per BRQ-003 assumption). Corrupt files are rejected with an error before the Recording is persisted.", source:"BRQ-003", type:"functional", priority:"high", updated:datetime('2026-05-18T07:06:55.519Z'), status:"draft"}}, {id:"RQ-011", properties:{rq_type:"behavioral", description:"On successful upload completion, System MUST atomically: (1) finalize Recording metadata, (2) transition Meeting.status from UPLOADING to TRANSCRIBING (BRQ-008 mirror), (3) create exactly one TranscriptionJob with status=QUEUED per Recording (BRQ-006).", source:"BRQ-006, BRQ-008", type:"functional", priority:"high", updated:datetime('2026-05-18T07:06:55.519Z'), status:"draft"}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{id:"RQ-012", properties:{rq_type:"behavioral", description:"Language selector accepts RU, EN, or blank. Blank means Meeting.language takes its default value AUTO (the field is NOT NULL). AUTO causes the ASR to auto-detect per BRQ-005, recording the detected value on Transcript.language, and causes the protocol to be generated in Russian per BRQ-013. Selecting EN is the only way to obtain an English protocol.", source:"BRQ-005", type:"functional", priority:"high", updated:datetime('2026-05-18T07:06:55.519Z'), status:"draft"}}, {id:"RQ-013", properties:{rq_type:"behavioral", description:"Meeting.title field defaults to Recording.filename (without extension) when the AUTHOR leaves the title field blank.", source:"behavior", type:"functional", priority:"medium", updated:datetime('2026-05-18T07:06:55.519Z'), status:"draft"}}, {id:"RQ-014", properties:{rq_type:"behavioral", description:"TranscriptionJob lifecycle MUST follow: QUEUED -> IN_PROGRESS -> {COMPLETED, FAILED}. Terminal states {COMPLETED, FAILED} are immutable per BRQ-009.", source:"BRQ-009", type:"functional", priority:"high", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-015", properties:{rq_type:"behavioral", description:"On a PERMANENT failure during transcription (storage-not-found, audio-extraction error, or a non-retriable ASR error per RC-UC-200) OR after BullMQ retry exhaustion (final attempt), job.status MUST become FAILED with non-null human-readable error_reason (BRQ-010) and Meeting.status MUST transition to FAILED (BRQ-008). A TRANSIENT failure (Deepgram 429/5xx) with attempts remaining MUST re-throw WITHOUT writing FAILED, so the BRQ-009 idempotency guard does not treat the job as terminal and the next BullMQ attempt proceeds. (FR-001)", source:"BRQ-008, BRQ-010 | refined by FR-001 (2026-05-26)", type:"functional", priority:"high", updated:datetime('2026-05-26T10:32:59.22Z'), status:"draft"}}, {id:"RQ-016", properties:{rq_type:"behavioral", description:"On successful completion of TranscriptionJob, System MUST auto-create exactly one ProtocolGenerationJob with status=QUEUED, transcript_id pointing to the new Transcript, and prompt_template_version set to the current template version. Per BRQ-007.", source:"BRQ-007", type:"functional", priority:"high", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-017", properties:{rq_type:"behavioral", description:"Speaker name resolution MUST attempt to map each anonymous diarization label (Speaker 1, Speaker 2, ...) to a real name by analyzing self-introductions and addressed names within the transcript. Confident matches are substituted across full_text and recorded in speaker_map. Labels without a confident match remain 'Speaker N' and map to null in speaker_map. Per BRQ-021.", source:"BRQ-021", type:"functional", priority:"high", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-018", properties:{rq_type:"behavioral", description:"Language handling. Meeting.language is the author's document-language choice and MUST NEVER be overwritten by detection (BRQ-005). When Meeting.language = AUTO, no language hint is sent to the ASR provider; the provider's detected language is normalized and persisted as Transcript.language, and Meeting.language remains AUTO. When Meeting.language is RU or EN, that value is sent as a hint and is persisted as Transcript.language. Transcript.language is constrained to {RU, EN} and is persisted in the transcripts.language column; when the provider reports a language outside that set (or reports none), Transcript.language is persisted as NULL rather than being silently coerced to a supported value. Transcript.language is a record of the recording, not a control input for protocol generation.", source:"BRQ-005", type:"functional", priority:"high", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-019", properties:{rq_type:"behavioral", description:"Transcript view MUST display each segment with its speaker label (resolved name from speaker_map or 'Speaker N' if unresolved) and minute/second timestamps.", source:"behavior", type:"functional", priority:"high", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-020", properties:{rq_type:"behavioral", description:"Transcript download produces a plain-text file (.txt) containing the verbatim transcript with speaker labels and timestamps. Filename pattern: '<meeting-title>-transcript.txt' (or filename fallback when title is null).", source:"behavior", type:"functional", priority:"medium", updated:datetime('2026-05-18T07:08:15.081Z'), status:"draft"}}, {id:"RQ-021", properties:{rq_type:"behavioral", description:"ProtocolGenerationJob lifecycle MUST follow: QUEUED -> IN_PROGRESS -> {COMPLETED, FAILED}. Terminal states immutable per BRQ-009.", source:"BRQ-009", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-022", properties:{rq_type:"behavioral", updated_by:"WP-WORKER-01", description:"The LLM prompt template MUST be selected by Meeting.language per BRQ-013 (amended 2026-08-14): Meeting.language = EN selects the English template; every other value (RU and AUTO) selects the Russian template. The protocol is therefore generated in Russian by default, regardless of the language spoken in the recording. Transcript.language MUST NOT influence template selection. There is NO fallback path that maps an unresolved language onto the English template - the previous AUTO -> EN fallback produced English protocols for Russian meetings and is prohibited. The section-validation language of RQ-023 MUST be the same value that was passed to the LLM provider, so that a response in the wrong language fails validation loudly instead of being persisted. The RU protocol prompt uses an XML-structured role/constraints format (BR-105) and instructs the model to write in Russian regardless of the transcript's language; the EN prompt carries the symmetric English instruction. Each template has a context variant (prompts/{ru,en}/protocol-context.md, RQ-060) used only when at least one context section is non-empty; without context the original protocol.md is sent unchanged. The version of the template actually used is persisted per run as ProtocolGeneration.prompt_version = sha256 of the template file (RQ-051, FR-005); the module constant PROTOCOL_PROMPT_TEMPLATE_VERSION is no longer the audit record.", source:"BRQ-013", type:"functional", priority:"high", updated:datetime('2026-10-07T20:40:59.295Z'), status:"draft"}}, {id:"RQ-023", properties:{rq_type:"behavioral", class_corrected_at:datetime('2026-08-14T08:20:40.706Z'), class_corrected_note:"rq_type validation -> behavioral: RQ-023 constrains worker-side LLM output (UC-300 has_ui=false, owns no Form), so the validation-class contract target FormField cannot exist. Anchor UC-300-AS07 was already correct.", description:"Persisted Protocol MUST contain all four required sections per BRQ-011: Participants, Discussion Topics, Decisions, Action Items. If any section is missing in the LLM response, the job MUST be marked FAILED.", source:"BRQ-011", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-024", properties:{rq_type:"behavioral", description:"Action items SHOULD include assignee and deadline when these are stated in the meeting per BRQ-012. Best-effort extraction by the LLM; absence is acceptable.", source:"BRQ-012", type:"functional", priority:"medium", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-025", properties:{rq_type:"behavioral", description:"Initial Protocol on successful generation MUST be persisted with version=1, edit_count=0, generated_at=now. Meeting.status -> PROTOCOL_READY per BRQ-008.", source:"BRQ-008, BRQ-014, BRQ-015", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-026", properties:{rq_type:"behavioral", description:"On a PERMANENT failure during protocol generation (JSON parse error, empty or unparseable completion, missing required sections, or a non-retriable kie.ai error per RC-UC-300 - effective status 400/401/402/413 or any other unlisted 4xx) OR after BullMQ retry exhaustion (final attempt), job.status=FAILED with non-null error_reason (BRQ-010) and Meeting.status=FAILED (BRQ-008). A TRANSIENT failure (effective status 404/408/429/5xx - including a code delivered inside an HTTP 200 {code,msg} gateway envelope - or a network/transport failure) with attempts remaining MUST re-throw WITHOUT writing FAILED, so the BRQ-009 idempotency guard does not treat the job as terminal and the next BullMQ attempt proceeds. Effective status = body.code when an HTTP 200 body carries a numeric code other than 200, otherwise the HTTP status. (FR-001; 404-transience, in-envelope classification and network-transience per DEC-001, 2026-08-13)", source:"BRQ-008, BRQ-010 | refined by FR-001 (2026-05-26) | revised by DEC-001 (2026-08-13)", type:"functional", priority:"high", updated:datetime('2026-08-13T11:11:20.972Z'), status:"draft"}}, {id:"RQ-027", properties:{rq_type:"behavioral", description:"Each save of an edited Protocol MUST increment version by exactly 1 per BRQ-014. Version is monotonically increasing.", source:"BRQ-014", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-028", properties:{rq_type:"behavioral", description:"Each save of an edited Protocol MUST increment edit_count by exactly 1 per BRQ-015. edit_count equals the number of manual saves performed since initial generation.", source:"BRQ-015", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-029", properties:{rq_type:"behavioral", description:"On first save, Meeting.status transitions PROTOCOL_READY -> EDITED (BRQ-008). Subsequent saves keep status=EDITED. last_edited_at is updated on every save.", source:"BRQ-008", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-030", properties:{rq_type:"behavioral", description:"All edits operate on canonical Markdown stored in Protocol.markdown_content per BRQ-018. Rendered preview is a derivation, never persisted.", source:"BRQ-018", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-031", properties:{rq_type:"behavioral", description:"The editor MUST warn the AUTHOR before navigating away with unsaved changes (browser-native or in-app confirmation).", source:"behavior", type:"functional", priority:"medium", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{id:"RQ-032", properties:{rq_type:"behavioral", description:"PDF export is transient: the rendered PDF MUST NOT be persisted (BRQ-017). Each export re-renders from the canonical Markdown (BRQ-018).", source:"BRQ-017, BRQ-018", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"RQ-033", properties:{rq_type:"behavioral", description:"Exported PDF MUST include all four required sections per BRQ-011 (Participants, Discussion Topics, Decisions, Action Items). On render failure, no file is delivered and no state change is persisted.", source:"BRQ-011", type:"functional", priority:"high", updated:datetime('2026-05-18T07:09:54.787Z'), status:"draft"}}, {id:"ADR-001", properties:{decision:"Node 20 LTS + Fastify 5 + TypeScript + Zod via fastify-type-provider-zod for runtime validation.", created:datetime('2026-05-18T00:00:00Z'), context:"User preference (Fastify). NFR-001 requires chunked 500MB uploads, NFR-002 requires async job pipeline. Fastify excels at streaming uploads, has first-class Pino logging, and pairs cleanly with BullMQ.", consequences:"Shared Zod schemas in shared/ workspace become single source of truth for DTOs.", alternatives:"NestJS (heavier, decorators add complexity); Express (slower streaming, no first-class typing); Hono (newer, smaller plugin ecosystem).", type:"adr", title:"Backend: Fastify 5 + Node 20 LTS + TypeScript", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-002", properties:{decision:"PostgreSQL 16 with JSONB columns for segments/speaker_map. Prisma as ORM (excellent TS types, migrations).", created:datetime('2026-05-18T00:00:00Z'), context:"Job state transitions (uploading -> transcribing -> ... -> failed) require ACID per BRQ-008/009/010. Transcript.segments and Protocol.speaker_map are document-shaped.", consequences:"Prisma client shared via shared/ workspace between api and worker.", alternatives:"Drizzle (lighter but less mature migrations), MongoDB (no ACID without transactions, schema drift risk), SQLite (single-writer bottleneck even for MVP).", type:"adr", title:"Database & ORM: PostgreSQL 16 + Prisma", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-003", properties:{decision:"BullMQ over Redis 7 for queue management. Worker runs as a separate Node process (own Docker container) sharing the Prisma client via monorepo.", created:datetime('2026-05-18T00:00:00Z'), context:"BP-002 transcription and BP-004 protocol generation are long-running (minutes to hours). NFR-002 requires async. BRQ-009 requires terminal-state immutability.", consequences:"Job retry semantics map cleanly to ADR-004 manual-retry decision via BullMQ attempts cap.", alternatives:"pg-boss (DB-backed, simpler ops but slower fan-out); in-process queue (rejected, API latency would spike during ffmpeg).", type:"adr", title:"Job Queue: BullMQ + Redis 7, separate worker process", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-004", properties:{decision:"MinIO 2026 in Docker Compose. AWS SDK v3 S3 client used in code so swap to AWS S3 / Cloudflare R2 is a config change only.", created:datetime('2026-05-18T00:00:00Z'), context:"EXT-04 requires durable object storage. NFR-005 / BRQ-020 require retention until both Transcript and Protocol are produced. MVP needs single-VM deployment.", consequences:"Recording.storage_uri uses s3://bucket/key shape; the same code path works against any S3-compatible backend.", alternatives:"Local filesystem (rejected, no proper streaming API); AWS S3 from day 1 (rejected, adds cloud dependency for MVP).", type:"adr", title:"Object Storage: MinIO (S3-compatible, Dockerized)", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-005", properties:{decision:"@tus/server on Fastify (mounted under /api/upload), tus-js-client on the frontend. Bridge to MinIO via S3 multipart on chunk completion.", created:datetime('2026-05-18T00:00:00Z'), title:"Chunked upload protocol: TUS", type:"adr", priority:"MVP", superseded_by:"ADR-012", revoked_at:datetime('2026-05-19T00:00:00Z'), context:"NFR-001 requires 500MB chunked upload without timeout. Network flakiness must not force full re-upload.", consequences:"Frontend dropzone uses tus-js-client; resumes automatically on disconnect.", alternatives:"Direct S3 multipart with presigned URLs (rejected, exposes storage credentials surface); custom chunk upload (rejected, reinvents TUS).", revoked_reason:"@tus/s3-store v2.0.4 does not support TUS concatenation extension — parallelism impossible. 66 MB files took 3-4 min (~275-440 KB/s). Files up to 1 GiB expected. Replaced with direct S3 presigned multipart upload (.tl/external-contracts/s3-multipart-presigned.md). Code-side removal: changelog [2026-05-19] ed6aaa9.", updated:datetime('2026-05-22T13:02:04.32Z'), status:"revoked"}}, {id:"ADR-006", properties:{decision:"Deepgram Nova-3 (RU+EN + diarization in a single API call) wrapped behind an IAsrProvider TypeScript interface. The interface allows swapping to OpenRouter / AssemblyAI / self-hosted Whisper+pyannote later.", created:datetime('2026-05-18T00:00:00Z'), context:"EXT-02 requires speaker-attributed transcript with timestamps. BRQ-006 (1:1 TranscriptionJob per Recording) and BRQ-021 (speaker name resolution) require native diarization output. OpenRouter was evaluated but none of its ASR models expose speaker diarization as of 2026-05.", consequences:"Worker holds the Deepgram client; IAsrProvider in shared/ workspace defines transcribe({audioUri, language}) returning normalized segments with speaker_label, start_ms, end_ms, text.", alternatives:"OpenRouter (rejected, no diarization); AssemblyAI Universal-3 (acceptable backup, slightly pricier); self-hosted Whisper + pyannote (rejected for MVP, GPU ops overhead).", type:"adr", title:"ASR/Diarization: Deepgram Nova-3 behind IAsrProvider", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-007", properties:{decision:"kie.ai with two adapters: claude-sonnet-4-6 via POST /claude/v1/messages and gpt-5-4 via POST /codex/v1/responses. ILlmProvider interface in shared/; per-meeting model selection persisted on Meeting.llm_model. Default Claude Sonnet 4.6.", created:datetime('2026-05-18T00:00:00Z'), context:"EXT-03 requires LLM for structured protocol generation (BRQ-011 four sections, BRQ-013 source language). User wants both Anthropic and OpenAI lineage available; kie.ai exposes both behind separate endpoints with different request shapes.", consequences:"Two adapter implementations; identical output schema (markdown + four required sections). Switching is just a Meeting.llm_model UI control.", alternatives:"Direct vendor APIs (rejected, user prefers single billing surface); OpenRouter (rejected, user explicitly chose kie.ai).", type:"adr", title:"LLM: kie.ai with runtime-switchable Claude Sonnet 4.6 / GPT-5.4", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-008", properties:{decision:"Vite 5 + React 19 + TypeScript SPA. shadcn/ui + Tailwind CSS for components. TanStack Query v5 for data fetching and SSE bridge. React Router 7 for routing.", created:datetime('2026-05-18T00:00:00Z'), context:"Single-user internal MVP per NFR-007/NFR-009. No SEO or crawler discovery needed. Heavy client-side interactivity: file upload, markdown editor, SSE status. Astro was evaluated but its islands model fits content-first sites, not interactive apps.", consequences:"Web served as static files behind Fastify (or via separate nginx); API and Web deploy independently.", alternatives:"Astro (rejected, islands hydration adds cost without benefit for interactive-heavy app); Next.js 15 (rejected, SSR overhead unnecessary for internal MVP).", type:"adr", title:"Frontend: Vite 5 + React 19 + TypeScript (SPA)", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-009", properties:{decision:"Milkdown for WYSIWYG markdown editing (UC-301). react-markdown + remark-gfm for read-only rendering. PDF export via Puppeteer rendering an HTML/CSS template against the markdown source on demand; the rendered PDF is streamed back and never persisted.", created:datetime('2026-05-18T00:00:00Z'), context:"BRQ-018 markdown canonical, BRQ-017 PDF transient, BRQ-011 four required sections.", consequences:"Worker container ships with chromium for Puppeteer; ~150MB image overhead.", alternatives:"Pandoc (heavier, system dependency); md-to-pdf (less style control); Typst (less mature ecosystem).", type:"adr", title:"Markdown editing & PDF export", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-010", properties:{decision:"SSE via Fastify reply.raw stream; client subscribes with EventSource. TanStack Query bridges SSE events to query cache updates.", created:datetime('2026-05-18T00:00:00Z'), context:"NFR-002 requires non-blocking UI surfacing of job progress. BRQ-008 status lifecycle has well-defined one-way transitions.", consequences:"No socket server required; survives any reverse proxy that supports streaming responses.", alternatives:"WebSocket (rejected, full duplex unneeded); polling (rejected, latency and bandwidth waste).", title:"Realtime status: Server-Sent Events", type:"adr", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-011", properties:{decision:"pnpm workspaces with packages: api/, worker/, web/, shared/ (Prisma, Zod schemas, provider interfaces). Docker Compose runs api + worker + postgres + redis + minio.", created:datetime('2026-05-18T00:00:00Z'), context:"API and Worker share Prisma client and Zod schemas; FE shares Zod-derived TS types. NFR-009 allows single-VM deployment.", consequences:"Single docker-compose.yml is the source of truth for local dev and single-VM production; production swaps MinIO -> S3 via env vars only.", alternatives:"Polyrepo (rejected, duplicate types); npm/yarn workspaces (acceptable, pnpm chosen for performance + strict isolation).", type:"adr", title:"Repo shape & deployment: pnpm monorepo + Docker Compose", priority:"MVP", updated:datetime('2026-05-18T00:00:00Z'), status:"approved"}}, {id:"ADR-012", properties:{decision:"Browser splits file into 10 MB parts and PUTs each part directly to S3 (MinIO in dev, Cloud.ru in prod) using server-issued presigned URLs. Three api endpoints: POST /api/uploads/init (server creates multipart upload and returns presigned PUT URLs), POST /api/uploads/complete (server finalizes with collected ETags), POST /api/uploads/abort. See .tl/external-contracts/s3-multipart-presigned.md for the full wire contract.", created:datetime('2026-05-22T11:50:00Z'), context:"Replaces ADR-005 (TUS) as of 2026-05-19. Code-side removal in changelog [2026-05-19] ed6aaa9; api/src/plugins/tus.ts deleted, @tus/server + @tus/s3-store uninstalled.", consequences:"Browser must capture per-part ETag from each S3 PUT response and forward to /complete. Presigned URLs expire 1h after /init; for >1h uploads, /init must be re-run. CORS on MinIO/Cloud.ru must allow browser PUT (configured in docker-compose minio-init + Cloud.ru bucket policy + MINIO_API_CORS_ALLOW_ORIGIN env var).", type:"adr", title:"Chunked upload protocol: direct S3 presigned multipart (supersedes ADR-005 TUS)", priority:"MVP", updated:datetime('2026-05-22T11:50:00Z'), rationale:"Three motivations: (1) TUS+@tus/s3-store could not parallelize parts — observed 3-4 min for 66 MB; expected files up to 1 GiB per RQ-008. (2) Direct presigned PUT removes the api server from the upload data path entirely, cutting memory + bandwidth load on a single-VM MVP. (3) Code+infra path was already implemented behind TUS facade (TUS bridged to S3 multipart on chunk completion per old ADR-005), so the supersession was incremental rather than greenfield.", supersedes:"ADR-005", status:"approved"}}, {id:"RQ-034", properties:{rq_type:"behavioral", created:datetime('2026-05-26T10:33:10.169Z'), description:"An AUTHOR MAY trigger 'Retry processing' on a Meeting whose status is FAILED. The System identifies the most recent FAILED job (TranscriptionJob or ProtocolGenerationJob), re-enqueues that stage as a new attempt (status=QUEUED, attempt_count reset to 0, error_msg cleared), and transitions Meeting.status from FAILED back to the corresponding in-progress state (TRANSCRIBING for a transcription failure, PROTOCOL_GENERATING for a protocol failure). Per BRQ-008.", source:"FR-001", type:"functional", priority:"high", updated:datetime('2026-05-26T10:33:10.169Z'), status:"draft"}}, {id:"RQ-035", properties:{rq_type:"behavioral", created:datetime('2026-05-26T10:33:10.169Z'), description:"Retry MUST be idempotent: if a re-enqueued job for the meeting+stage is already QUEUED or IN_PROGRESS, re-triggering MUST NOT create a duplicate job (idempotency key = meetingId + stage).", source:"FR-001", type:"functional", priority:"high", updated:datetime('2026-05-26T10:33:10.169Z'), status:"draft"}}, {id:"RQ-036", properties:{rq_type:"behavioral", created:datetime('2026-05-26T10:33:10.169Z'), description:"The Retry action MUST be offered ONLY when Meeting.status=FAILED; in any other status the action is hidden in the UI and rejected by the API with a 409-class (conflict) error and no state change.", source:"FR-001", type:"functional", priority:"high", updated:datetime('2026-05-26T10:33:10.169Z'), status:"draft"}}, {id:"RQ-037", properties:{rq_type:"functional", description:"On upload, the AUTHOR MAY optionally supply a speaker_count hint (integer 1-10). When present, it is passed through to the ASR provider to pin diarization to exactly that number of speakers (e.g. Deepgram min_speakers/max_speakers). When absent, the ASR provider auto-detects speaker count.", source:"BR-103", priority:"medium", updated:datetime('2026-05-26T14:39:34.141Z')}}, {id:"RQ-038", properties:{rq_type:"interface", description:"UC sub-pages reached from the Meeting detail hub (transcript view, protocol editor) MUST present a sticky back-link affordance that remains visible while scrolling and returns the AUTHOR to the originating Meeting detail page.", source:"BR-104", priority:"medium", updated:datetime('2026-05-26T14:39:38.542Z')}}, {id:"RQ-039", properties:{rq_type:"validation", created:datetime('2026-08-15T14:43:17.935Z'), description:"Recording duration validation MUST reject uploads whose probed duration exceeds 14,400 s (4 hours), BEFORE the transcription job is enqueued. Duration - not byte size - is what bounds the processing pipeline: peak worker memory, the Deepgram request budget (RQ-008's byte cap maps to wildly different durations depending on source bitrate) and the LLM context for the protocol. ffprobe already runs at upload finalization and its durationSec MUST be persisted on Recording and enforced here rather than discarded. Rejection is reported to the AUTHOR as an inline error on the upload form, in the same channel as the size and MIME failures.", source:"DEC-004", updated:datetime('2026-08-15T14:43:17.935Z')}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{id:"RQ-040", properties:{rq_type:"validation", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"PIN — ровно 6 цифр (иначе 400 PIN_FORMAT) и уникален среди пользователей. PIN нигде не хранится и не логируется: поиск по pin_lookup = HMAC-SHA256(PIN, PIN_PEPPER), проверка pin_hash (scrypt, сравнение постоянного времени). Неверный PIN — 401 INVALID_PIN «Неверный PIN».", source:"D-8, A-1, A-3", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-041", properties:{rq_type:"behavioral", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"После 10 неудачных попыток с одного клиента (IP из X-Forwarded-For от прокси 127.0.0.1) клиент блокируется: любой вход, даже с верным PIN, получает 423 LOGIN_BLOCKED с текстом «Больше нельзя, пиши Максу для разблокировки». Блокировка бессрочная, снимается только CLI user:unblock. Успешный вход сбрасывает счётчик клиента. Общий счётчик (client_key='*') > 100 неудач за час — предупреждение в лог.", source:"D-8, A-3", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-042", properties:{rq_type:"security", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Сессия: случайный токен в cookie transcrib_session (httpOnly; Secure; SameSite=Lax; Path=/; 30 дней), в БД только SHA-256 токена. POST /api/auth/logout удаляет сессию и чистит cookie (идемпотентно, 204). GET /api/auth/me → {user {id,name}, workspaces [{id,name,personal}]}.", source:"D-8", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-043", properties:{rq_type:"security", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Все маршруты /api/* кроме GET /api/health и POST /api/auth/login требуют действующей сессии; без неё — 401 UNAUTHENTICATED (веб перенаправляет на вход и возвращает на исходный URL).", source:"D-6", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-044", properties:{rq_type:"security", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Изоляция пространств: каждый маршрут, адресующий встречу, проект, отзыв или событие памяти (включая SSE, PDF, скачивания, предподписанные URL), проверяет членство в пространстве владельца; чужое и несуществующее дают одинаковый 404 NOT_FOUND. Список встреч — GET /api/meetings?workspace_id= (обязателен после WP-BACKEND-01). Новые ключи S3 — ws/<workspaceId>/…", source:"D-6, BRQ-016", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-045", properties:{rq_type:"data", source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Все встречи до программы принадлежат личному пространству «Роман» (id 00000000-0000-4000-8000-000000000001), созданному миграцией 20261007120000_program_product_schema. До WP-BACKEND-01 meetings.workspace_id имеет DB DEFAULT на это пространство, чтобы встречи, созданные старым кодом, не оставались без владельца; WP-BACKEND-01 снимает default и ставит NOT NULL. Пользователь «Роман» заводится CLI и привязывается к нему.", source:"D-7, D-3", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-046", properties:{rq_type:"behavioral", source_fr:"FR-004", created:"2026-10-07T17:28:35.546Z", description:"POST /api/uploads/complete с defer_start=true создаёт встречу в AWAITING_START и ничего не ставит в очередь; без флага — сегодняшнее поведение (TRANSCRIBING + очередь). Веб всегда шлёт defer_start=true.", source:"D-9", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-047", properties:{rq_type:"behavioral", source_fr:"FR-004", created:"2026-10-07T17:28:35.546Z", description:"Контекст меняется только в AWAITING_START (иначе 409 CONTEXT_FROZEN). POST /api/meetings/:id/start допустим только из AWAITING_START (повтор — 409 MEETING_NOT_AWAITING_START; захват статуса атомарный, при гонке двух стартов один победитель и одно задание в очереди): собирает снимок = карточка проекта + добавления встречи + текст предыдущего протокола (≤ 50000 символов, D-25; обрезка в воркере не делается), считает snapshot_hash, пишет Meeting.project_id и ставит в очередь существующее задание PENDING с {transcription_job_id, speaker_count} так же, как finalizeUpload. Предыдущий протокол «из проекта» разрешается на старте; если в проекте нет протокола — 422 PREVIOUS_PROTOCOL_UNAVAILABLE, если протокол проекта длиннее 50000 символов — 422 PREVIOUS_PROTOCOL_TOO_LONG (текст не обрезается; автор выбирает «без протокола» или вставляет фрагмент); в обоих случаях встреча остаётся в AWAITING_START, очередь не вызывается. Последующие правки проекта снимок не меняют. Контекст необязателен.", source:"D-9, D-10, D-25", type:"functional", priority:"high", updated:"2026-10-08T10:50:47.251Z", status:"draft"}}, {id:"RQ-048", properties:{rq_type:"integration", source_fr:"FR-004", created:"2026-10-07T17:28:35.546Z", description:"ASR keyterms из снимка: сначала имена участников и варианты, затем организации, затем термины с asr_keyterm; без дублей, ≤ 50 штук и ≈ ≤ 450 токенов; в Deepgram — повторяющийся параметр keyterm= без запятых и весов. Включается флагом ASR_KEYTERMS_ENABLED (по умолчанию выключен). Пустой список — запрос байт в байт как сегодня.", source:"Q-1, Q-2", type:"functional", priority:"medium", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-049", properties:{rq_type:"integration", source_fr:"FR-004", created:"2026-10-07T17:28:35.546Z", description:"Вход LLM для протокола — секции <meeting_meta>, <participants>, <agenda>, <glossary>, <previous_protocol>, <notes>, <project_memory> в этом порядке перед <transcript>; закрывающие теги внутри текста экранируются, пустые секции опускаются (shared renderLlmContextSections). Без контекста и памяти запрос байт в байт равен сегодняшнему. Спикеров сопоставляет LLM.", source:"D-10", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-050", properties:{rq_type:"data", source_fr:"FR-005", created:"2026-10-07T17:28:35.546Z", description:"История протокола — неизменяемые ProtocolVersion: v1 GENERATED (с generation_id) в той же транзакции, что Protocol; каждое сохранение — новая USER_EDIT (с author_user_id) в транзакции PUT /api/meetings/:id/protocol; n идёт без пропусков, UNIQUE(meeting_id, n). Существовавшие протоколы — v1 LEGACY (edit_count>0) или GENERATED. GET …/protocol/versions и …/versions/:n.", source:"BRQ-014, D-3", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-051", properties:{rq_type:"data", source_fr:"FR-005", created:"2026-10-07T17:28:35.546Z", updated_by:"WP-WORKER-01", description:"Каждый вызов LLM (протокол и шаги памяти) записывается в ProtocolGeneration: kind, model, prompt_version = sha256 файла шаблона, context_snapshot_hash, keyterms, asr_options, токены; отрендеренный промпт — в s3://…/ws/<workspaceId>/prompts/<generationId>.txt. Для kind PROTOCOL keyterms и asr_options восстанавливаются детерминированно из того же замороженного снимка и флага ASR_KEYTERMS_ENABLED в момент генерации протокола (отдельного хранения опций ASR в схеме нет; asr_options.source = 'reconstructed'); строка ProtocolGeneration пишется только для успешной генерации, в одной транзакции с Protocol и ProtocolVersion.", source:"D-10, D-11", type:"functional", priority:"medium", updated:datetime('2026-10-07T20:40:59.295Z'), status:"draft"}}, {id:"RQ-052", properties:{rq_type:"validation", source_fr:"FR-005", created:"2026-10-07T17:28:35.546Z", updated_by:"WP-API-FEEDBACK-01", description:"Отзыв привязан к текущей версии. COMMENT — текст (+ категория), без файла; CORRECTED_PROTOCOL — текст или файл .md/.txt/.docx; DOCX_REVIEW — файл .docx. Файл ≤ 20 MB; проверяются расширение, MIME и сигнатура zip (PK\\x03\\x04) для .docx (shared checkFeedbackSubmission). Ошибки: 400 FEEDBACK_TEXT_REQUIRED / FEEDBACK_FILE_REQUIRED, 413 FEEDBACK_FILE_TOO_LARGE, 415 FEEDBACK_FILE_TYPE. Реализация (WP-API-FEEDBACK-01): привязка к max(n) ProtocolVersion; встреча без версий -> 404 PROTOCOL_VERSION_NOT_FOUND; имя файла в ключе S3 очищается (без пути и спецсимволов, ≤120 знаков); при сбое записи строки загруженный объект удаляется; скачивание — attachment + nosniff, нет файла/чужое/потерян объект -> 404 NOT_FOUND.", source:"D-12", type:"functional", priority:"high", updated:"2026-10-08T10:38:30.043Z", status:"draft"}}, {id:"RQ-053", properties:{rq_type:"behavioral", source_fr:"FR-005", created:"2026-10-07T17:28:35.546Z", updated_by:"WP-API-FEEDBACK-01", description:"Word сохраняется и сразу разбирается в extracted: комментарии {id, author, date, text, anchored_text}, правки w:ins/w:del {type, author, date, text}, accepted_text и original_text; для CORRECTED_PROTOCOL — plain_text. При ошибке разбора файл всё равно сохраняется, extracted.error заполнен. Ответ POST сразу несёт extracted (счётчики для UI). Реализация: разбор напрямую word/document.xml + word/comments.xml (jszip + fast-xml-parser, XML валидируется, предел распаковки части 64 MB); якорный текст = обычный и вставленный текст между commentRangeStart/End; правки без текста (метки абзаца) пропускаются; .md/.txt — plain_text = UTF-8 текст без BOM.", source:"D-12", type:"functional", priority:"medium", updated:"2026-10-08T10:38:30.043Z", status:"draft"}}, {id:"RQ-054", properties:{rq_type:"behavioral", source_fr:"FR-006", created:"2026-10-07T17:28:35.546Z", description:"После каждого протокола встречи с проектом конвейер памяти извлекает задачи и решения (с дословной цитатой, таймкодом, спикером), сопоставляет с реестром (NEW|UPDATE|CLOSE|DUPLICATE|NO_CHANGE) и применяет через гейт: новые задачи, упоминания и уверенные обновления — AUTO; закрытие, отмена, слияние дублей, смена исполнителя и неуверенные — PENDING в очередь подтверждения. Одна встреча — одна транзакция Neo4j. Затем обновляется сводка (новая версия ProjectMemory).", source:"D-11, D-14", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-055", properties:{rq_type:"security", source_fr:"FR-006", created:"2026-10-07T17:28:35.546Z", description:"Каждый запрос к графу памяти параметризован И workspaceId, И projectId; событие /api/task-events/:id ищется по id с фильтром workspaceId ∈ пространства вызывающего. При недоступности Neo4j эндпоинты памяти отвечают 503 MEMORY_UNAVAILABLE, остальное приложение и генерация протокола работают (память в промпте опускается).", source:"D-6, D-13", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-056", properties:{rq_type:"data", source_fr:"FR-006", created:"2026-10-07T17:28:35.546Z", description:"Postgres — источник истины для пространств, проектов, встреч и протоколов. Удаление встречи с проектом или проекта пишет строку GraphOutbox (DELETE_MEETING / DELETE_PROJECT) в той же транзакции; воркер применяет её в Neo4j (DETACH DELETE) с повторами, пока Neo4j недоступен (attempts, last_error, done_at).", source:"D-13", type:"functional", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"RQ-057", properties:{rq_type:"validation", source_fr:"FR-006", created:"2026-10-07T17:28:35.546Z", description:"Переходы статуса задачи (ручные и LLM) проверяются одной общей функцией canTransitionTaskStatus (shared): OPEN/IN_PROGRESS/POSTPONED → любой другой, DONE/CANCELLED → только OPEN; недопустимый — 400 TASK_STATUS_TRANSITION. Повторное подтверждение/отклонение события — 409 TASK_EVENT_ALREADY_REVIEWED; история сохраняется в обоих случаях.", source:"D-14", type:"functional", priority:"medium", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"NFR-010", properties:{source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Миграции программы строго аддитивны и совместимы со старым кодом: deploy-production.yml применяет migrate deploy до перезапуска pm2, и merge в main = прод. Новые таблицы/нуллируемые колонки/индексы, новые значения enum, не используемые старым кодом; FK новых таблиц к meetings — ON DELETE CASCADE; бэкфиллы идемпотентны. NOT NULL и снятие временных default — отдельными миграциями пакетов-потребителей. Регистрация маршрутов и модулей воркера — автоподключением (api/src/features/<name>/routes.ts, worker/src/<module>/index.ts register(ctx)).", source:"D-3, D-15", type:"nfr", priority:"high", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}, {id:"NFR-011", properties:{source_fr:"FR-003", created:"2026-10-07T17:28:35.546Z", description:"Безопасность MVP-продукта для ограниченного круга лиц: аутентификация только по PIN, изоляция по пространствам. Риск перебора PIN принят владельцем (D-8) и ограничен блокировкой RQ-041. Заменяет NFR-007 (работа без аутентификации).", source:"D-6, D-8", type:"nfr", priority:"medium", updated:"2026-10-07T17:28:35.546Z", status:"draft"}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{id:"ADR-013", properties:{decision:"Граф задач, решений, событий и сводок проекта хранится в отдельном экземпляре Neo4j на проде (не dev-контейнер transcrib-neo4j для спецификаций), лимиты D-16 (heap 512m, pagecache 256m, контейнер 1536m). Postgres остаётся источником истины для пространств, проектов, встреч и протоколов; :Project/:Meeting/:Participant в Neo4j — проекции с теми же id и обязательными workspaceId/projectId. Удаления зеркалятся транзакционным outbox (graph_outbox). Доступ — только через слой worker/src/graph (neo4j-driver), каждый запрос параметризован workspaceId и projectId. Неработающий Neo4j деградирует до 503 на эндпоинтах памяти и протокола без <project_memory>.", source_fr:"FR-006", created:"2026-10-07T17:28:51.293Z", context:"D-11: проект должен накапливать задачи и решения между встречами с историей изменений и переносом открытых задач; исследование Q-3 (reports/research-2026-10-07-project-memory.md) сравнило таблицы Postgres со связями, отдельную графовую БД и temporal knowledge graph (Graphiti). D-13: владелец выбрал Neo4j.", consequences:"Второе хранилище: бэкапы (gzip, 3 копии), память VM, синхронизация удалений через outbox — закрываются WP-INFRA-01 и WP-WORKER-MEMORY-01. Контракт: .tl/external-contracts/neo4j.md; деплой: .tl/deploy-plan.md § Neo4j памяти проекта.", alternatives:"Таблицы Postgres со связями (проще эксплуатация, но обходы истории и связей задач дороже); Graphiti / temporal KG (зрелость и лишняя LLM-зависимость); хранить в dev-Neo4j спецификаций (смешение контуров, нет бэкапов).", title:"Project memory: separate Neo4j on prod; Postgres stays the system of record", type:"adr", priority:"high", updated:"2026-10-07T17:28:51.293Z", status:"approved"}}, {id:"RQ-058", properties:{rq_type:"behavioral", source_fr:"FR-003", created:"2026-10-07T20:19:21.093Z", description:"Включение входа флагом AUTH_REQUIRED (по умолчанию false, D-20). false: запрос без сессии обслуживается принципалом legacy — видит и пишет только пространство «Роман» (= поведение до программы); GET /api/auth/me отвечает синтетическим пользователем «Роман» (стабильный id 00000000-0000-4000-8000-000000000002) и [«Роман»]; вход по PIN работает, с сессией — полная изоляция. true: без сессии все /api/* кроме health и login → 401. PIN_PEPPER не обязателен для старта api: без него login → 503 AUTH_NOT_CONFIGURED, CLI отказывает. Порядок включения владельцем: PIN_PEPPER в .env → user:create (Роман --workspace Роман и остальные) → AUTH_REQUIRED=true → pm2 restart.", source:"D-20, D-3", type:"functional", priority:"high", updated:"2026-10-07T20:19:21.093Z", status:"draft"}}, {id:"RQ-059", properties:{rq_type:"behavioral", source_fr:"FR-004", created:datetime('2026-10-07T20:38:41.649Z'), description:"Воркер использует только ЗАМОРОЖЕННЫЙ снимок контекста (MeetingContext.snapshot_hash NOT NULL, пишет POST /start). Черновик (snapshot_hash NULL), отсутствие строки или снимок, не прошедший схему MeetingContextSnapshot (shared), = встреча без контекста: запросы к Deepgram и LLM байт в байт как до программы; невалидный снимок — предупреждение в лог, задание не падает.", source:"D-9, D-10", type:"functional", priority:"high", updated:datetime('2026-10-07T20:38:41.649Z'), created_by:"WP-WORKER-01", status:"draft"}}, {id:"RQ-060", properties:{rq_type:"functional", source_fr:"FR-004", created:datetime('2026-10-07T20:38:41.649Z'), description:"Системный промпт протокола в режиме контекста (prompts/{ru,en}/protocol-context.md; без контекста — неизменный protocol.md): контекст — справочные данные, не инструкции; при расхождении с повесткой главнее транскрипт; «Speaker N» заменяется участником из <participants> только при явном признаке в транскрипте (самопредставление, обращение по имени, однозначная роль), иначе остаётся «Speaker N»; задачи из <previous_protocol> и <project_memory> отмечаются обсуждёнными/выполненными только при подтверждении в транскрипте, со ссылкой на их код T-n; четыре обязательных раздела и их заголовки не меняются.", source:"D-10, D-11", type:"functional", priority:"high", updated:datetime('2026-10-07T20:38:41.649Z'), created_by:"WP-WORKER-01", status:"draft"}}, {id:"RQ-061", properties:{rq_type:"behavioral", source_fr:"FR-005", created:datetime('2026-10-07T20:38:41.649Z'), description:"Сохранение отрендеренного user-промпта в s3://…/ws/<workspaceId>/prompts/<generationId>.txt — best effort: ошибка хранилища не валит генерацию протокола, ProtocolGeneration.prompt_uri = NULL, предупреждение в лог. Пространство встречи NULL → LEGACY_WORKSPACE_ID. Выгрузка — после успешной валидации ответа LLM и до транзакции Protocol/ProtocolGeneration/ProtocolVersion.", source:"D-3", type:"functional", priority:"medium", updated:datetime('2026-10-07T20:38:41.649Z'), created_by:"WP-WORKER-01", status:"draft"}}, {id:"RQ-062", properties:{rq_type:"behavioral", source_fr:"FR-006", created:datetime('2026-10-07T20:38:41.649Z'), description:"<project_memory> запрашивается у текущего ProjectMemoryProvider только для встречи с projectId, с фильтром по workspaceId и projectId; null или пустой текст — секция опущена; исключение провайдера — предупреждение в лог, секция опущена, протокол генерируется (деградация без памяти, D-19).", source:"D-19", type:"functional", priority:"medium", updated:datetime('2026-10-07T20:38:41.649Z'), created_by:"WP-WORKER-01", status:"draft"}}, {id:"RQ-063", properties:{rq_type:"behavioral", source_fr:"FR-006", created:"2026-10-07T20:42:52.779Z", description:"Гейт памяти проекта (D-14) применяется кодом к каждому изменению из MEMORY_RESOLVE. AUTO (применяется сразу): новая задача с начальными исполнителем и сроком, упоминание без изменений (MENTIONED), изменение срока, названия или описания, статус → IN_PROGRESS / POSTPONED / OPEN, назначение исполнителя задаче без исполнителя, новое решение D-n — при confidence ≥ MEMORY_CONFIDENCE_THRESHOLD (по умолчанию 0,7). PENDING (очередь подтверждения, задача не меняется): статус → DONE или CANCELLED (закрытие, отмена), merged_into (слияние дубля), смена существующего исполнителя на другого, любое изменение с confidence ниже порога. Каждое событие несёт дословную цитату, проверенную по Transcript.segmentsBlob; пункт без найденной цитаты отбрасывается; «не упомянута» = нет событий; решение Resolve с target_task_code вне кандидатов отклоняется. Текущее состояние задачи = свёртка применённых событий (AUTO, CONFIRMED) по valid_at, recorded_at — общая функция shared/src/memory, её же использует API при подтверждении и ручной правке.", source:"D-14, Q-3, WP-WORKER-MEMORY-01", type:"functional", priority:"high", updated:"2026-10-07T20:42:52.779Z", status:"draft"}}, {id:"RQ-064", properties:{rq_type:"behavioral", source_fr:"FR-004", created:"2026-10-08T10:32:47.727Z", description:"GET /api/projects/:projectId/last-protocol отдаёт текущий (после правок) текст самого нового протокола среди встреч проекта: meeting_id, meeting_title, version_n, markdown, created_at. Если у проекта ещё нет протокола — 422 PREVIOUS_PROTOCOL_UNAVAILABLE («В проекте ещё нет протокола»). Проект чужого пространства и несуществующий дают одинаковый 404 (RQ-044).", source:"D-25, D-10", type:"functional", priority:"medium", updated:"2026-10-08T10:32:47.727Z", status:"draft"}}, {id:"RQ-065", properties:{rq_type:"security", source_fr:"FR-005", created:"2026-10-08T10:38:30.043Z", updated_by:"WP-API-FEEDBACK-01", description:"Отзыв (POST /api/meetings/:id/feedback) принимает только вошедший пользователь: ProtocolFeedback.user_id обязателен, а у легаси-принципала без сессии (AUTH_REQUIRED=false, D-20) строки users нет — такой запрос получает 401 UNAUTHENTICATED. Чтение версий и списка отзывов для него работает как обычно.", source:"D-20, FR-003", type:"functional", priority:"medium", updated:"2026-10-08T10:38:30.043Z", status:"draft"}}, {id:"RQ-066", properties:{rq_type:"behavioral", source_fr:"FR-007", description:"GET /api/meetings/:id/speakers доступен в AWAITING_SPEAKERS и позже (до распознавания — 409 MEETING_NOT_AWAITING_SPEAKERS): метки из segments_blob (длительность, число сегментов, 3 самые длинные реплики ≤200 знаков), текущие имена из speaker_map, участники проекта; доступ как у маршрутов встречи (чужая — 404). PUT /api/meetings/:id/speakers {action: confirm|skip, mapping[{label, participant_id?, name?}]} — только из AWAITING_SPEAKERS (иначе и при повторе 409 MEETING_NOT_AWAITING_SPEAKERS; захват статуса атомарный): в одной транзакции пишет transcripts.speaker_map (метка → имя участника, свободное имя или null), speaker_mapping, speakers_confirmed_at, ставит GENERATING_PROTOCOL и создаёт ProtocolGenerationJob; после фиксации — очередь и SSE. participant_id вне проекта встречи — 404; неизвестная или повторная метка — 400 UNKNOWN_SPEAKER_LABEL; skip не меняет имена.", source:"D-38", type:"functional", priority:"high", updated:"2026-10-08T19:18:19.557Z", status:"draft"}}, {id:"RQ-067", properties:{rq_type:"constraint", source_fr:"FR-007", description:"Статус AWAITING_SPEAKERS ставит только воркер и только для встреч с контекстом (meeting_contexts.snapshot_hash не NULL); остальные идут TRANSCRIBED → GENERATING_PROTOCOL. API не переписывает raw_text — воркер строит реплики из segments_blob + speaker_map. Подтверждение объединяет метки (один человек — несколько меток), но не разделяет: недосегментацию диаризации без повторного распознавания исправить нельзя (D-21).", source:"D-38", type:"functional", priority:"high", updated:"2026-10-08T19:18:19.557Z", status:"draft"}}] AS row
CREATE (n:Requirement{id: row.id}) SET n += row.properties;
UNWIND [{_id:331, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:42:37.883Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the Meeting aggregate.", id:"Meeting-A01", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:332, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:42:37.883Z'), data_type:"String", name:"title", description:"Optional user-readable meeting title. Defaults to the source filename if not provided.", id:"Meeting-A02", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:333, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:42:37.883Z'), name:"language", data_type:"Enum", description:"The DOCUMENT language, declared by the author at upload (UC-100). NOT NULL, defaults to AUTO. Drives protocol prompt-template selection per BRQ-013: EN -> English protocol, RU or AUTO -> Russian protocol. Also used as the ASR language hint (null hint when AUTO). MUST NEVER be overwritten by language detection (BRQ-005) - detection results are recorded on Transcript.language instead.", default_value:"AUTO", id:"Meeting-A03", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:334, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:42:37.883Z'), name:"status", data_type:"Enum", description:"Pipeline-mirror status of the meeting (BRQ-008). Drives UI state and disables protocol actions before TRANSCRIPT_READY.", id:"Meeting-A04", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:335, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:42:37.883Z'), data_type:"DateTime", name:"uploaded_at", description:"Timestamp when the upload was initiated. Immutable.", id:"Meeting-A05", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:336, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:42:37.883Z'), data_type:"DateTime", name:"updated_at", description:"Timestamp of the last status transition or protocol edit. Used to sort the meeting catalog by recent activity.", id:"Meeting-A06", updated:datetime('2026-05-18T06:42:37.883Z')}}, {_id:337, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the Recording.", id:"Recording-A01", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:338, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"Reference", name:"meeting_id", description:"FK to the owning Meeting (ent-001). Also surfaced as a RELATES_TO edge in the graph.", id:"Recording-A02", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:339, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"String", name:"filename", description:"Original filename as supplied by the user at upload time.", id:"Recording-A03", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:340, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"Int", name:"size_bytes", description:"File size in bytes. MUST be <= 2,684,354,560 (2.5 GiB) per BRQ-001 / RQ-008.", id:"Recording-A04", updated:datetime('2026-08-17T09:14:27.065Z')}}, {_id:341, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"Enum", name:"mime_type", description:"Container MIME type. Constrained by BRQ-002 to MP4/MKV/MOV.", id:"Recording-A05", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:342, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"String", name:"storage_path", description:"Object key in EXT-04 Object Storage where the raw video is persisted. System-managed.", id:"Recording-A06", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:343, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"Int", name:"duration_sec", description:"Video duration in seconds. Null until extracted during BP-002 audio extraction.", id:"Recording-A07", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:344, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:46:25.641Z'), data_type:"DateTime", name:"uploaded_at", description:"Timestamp when the upload completed successfully. Immutable.", id:"Recording-A08", updated:datetime('2026-05-18T06:46:25.641Z')}}, {_id:345, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the TranscriptionJob.", id:"TranscriptionJob-A01", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:346, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Reference", name:"meeting_id", description:"FK to the owning Meeting (ent-001).", id:"TranscriptionJob-A02", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:347, properties:{internal:true, nullable:false, created:datetime('2026-05-26T10:31:40.39Z'), data_type:"Int", name:"attempt_count", description:"Number of processing attempts made (mirrors BullMQ attemptsMade). Lets the failure handler distinguish a transient retryable failure (attempts remaining) from terminal exhaustion. Reset to 0 on user-triggered retry (UC-004). Added by FR-001.", id:"TranscriptionJob-A08", type:"Int", updated:datetime('2026-05-26T10:31:40.39Z'), derived:false}}, {_id:348, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Enum", name:"status", description:"Job lifecycle status. Transitions: QUEUED -> IN_PROGRESS -> COMPLETED or FAILED. Terminal states are immutable (BRQ-009).", id:"TranscriptionJob-A04", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:349, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"String", name:"error_msg", description:"Non-null when status=FAILED (BRQ-010); free-form error message.", id:"TranscriptionJob-A05", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:350, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"DateTime", name:"started_at", description:"Timestamp when the worker picked up the job. Null while QUEUED.", id:"TranscriptionJob-A06", updated:datetime('2026-05-18T06:48:25.348Z')}}] AS row
