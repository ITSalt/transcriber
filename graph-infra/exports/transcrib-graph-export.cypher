:begin
CREATE FULLTEXT INDEX fulltext_ba_search FOR (n:UseCase|Module|DomainEntity|DomainAttribute|Requirement|Form|FormField|Component|BusinessProcess|BusinessEntity|BusinessRule|GlossaryTerm|ProcessGroup|Stakeholder|ExternalEntity|ActivityStep|WorkflowStep|DataFlow|Enumeration|EnumValue|SystemRole|Permission|EntityAttribute|EntityState) ON EACH [n.`name`,n.`description`,n.`term`,n.`function_name`];
CREATE CONSTRAINT ba_business_entity_id FOR (node:BusinessEntity) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_business_process_id FOR (node:BusinessProcess) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_business_role_id FOR (node:BusinessRole) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_business_rule_id FOR (node:BusinessRule) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_data_flow_id FOR (node:DataFlow) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_entity_attribute_id FOR (node:EntityAttribute) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_entity_state_id FOR (node:EntityState) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_external_entity_id FOR (node:ExternalEntity) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_glossary_term_id FOR (node:GlossaryTerm) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_process_group_id FOR (node:ProcessGroup) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_stakeholder_id FOR (node:Stakeholder) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_system_context_id FOR (node:SystemContext) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT ba_workflow_step_id FOR (node:WorkflowStep) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT constraint_featurerequest_id FOR (node:FeatureRequest) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_domain_entity_attr_id FOR (node:DomainEntityAttribute) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_domain_entity_id FOR (node:DomainEntity) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_domain_entity_state_id FOR (node:DomainEntityState) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_field_id FOR (node:Field) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_form_id FOR (node:Form) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_module_id FOR (node:Module) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_permission_id FOR (node:Permission) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_requirement_id FOR (node:Requirement) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_screen_id FOR (node:Screen) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_system_role_id FOR (node:SystemRole) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_ui_component_id FOR (node:UIComponent) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT sa_use_case_id FOR (node:UseCase) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT tl_api_contract_id FOR (node:ApiContract) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT tl_task_id FOR (node:Task) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT tl_wave_id FOR (node:Wave) REQUIRE (node.id) IS UNIQUE;
CREATE CONSTRAINT UNIQUE_IMPORT_NAME FOR (node:`UNIQUE IMPORT LABEL`) REQUIRE (node.`UNIQUE IMPORT ID`) IS UNIQUE;
:commit
CALL db.awaitIndexes(300);
:begin
UNWIND [{id:"GLO-001", properties:{aliases:["Встреча"], name_ru:"Встреча", created:date('2026-05-17'), name:"Meeting", context:"Used throughout all processes (BP-001..BP-006); the top-level aggregate (OBJ-001).", definition:"A single business meeting whose recording is uploaded into the system for processing. The root object that owns the resulting recording, transcript, and protocol throughout its lifecycle. In the UI and in all specifications the word «встреча» is the only name of this object; the word «задача» is never used for it.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-002", properties:{aliases:["Видеозапись", "Запись", "Video File"], name_ru:"Видеозапись", created:date('2026-05-17'), name:"Recording", context:"Created in BP-001 (Upload); consumed in BP-002 (Transcription). Corresponds to OBJ-002.", definition:"The video file uploaded by the Author that captures the meeting. The physical file is stored in object storage; the system tracks its metadata (filename, size, duration, storage path) as the Recording entity.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-003", properties:{aliases:["Транскрипт", "Пословная транскрибация", "Verbatim Transcript"], name_ru:"Транскрипт", created:date('2026-05-17'), name:"Transcript", context:"Produced by BP-002 (Transcription); consumed by BP-003 (Retrieve) and BP-004 (Protocol Generation). Corresponds to OBJ-004.", definition:"The verbatim, speaker-attributed text output of the transcription pipeline. Contains the full spoken content of the meeting with speaker labels and timestamps per segment. Sometimes called a \"verbatim transcript\" to distinguish it from a summarized protocol.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-004", properties:{aliases:["Диаризация спикеров", "Diarization"], name_ru:"Диаризация спикеров", created:date('2026-05-17'), context:"Performed inside BP-002 (Transcription) by the ASR/Diarization Engine (EXT-01). Output feeds into speaker-attributed transcript segments.", name:"Speaker Diarization", definition:"The automated process of partitioning an audio stream into segments and labeling each segment with a speaker identity (e.g., «Спикер 1», «Спикер 2»). Diarization answers the question \"who spoke when\" and is a required step of the transcription pipeline.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-005", properties:{aliases:["Сегмент транскрипта", "Transcript Segment"], name_ru:"Сегмент транскрипта", created:date('2026-05-17'), context:"Produced by the diarization step inside BP-002; stored as structured content within OBJ-004 (Transcript) at MVP scope.", name:"Speaker Segment", definition:"A contiguous block of speech attributed to a single speaker, with a start timestamp, end timestamp, speaker label, and verbatim text. Multiple segments together form the full Transcript.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-006", properties:{aliases:["Протокол встречи", "Протокол", "Protocol", "Minutes"], name_ru:"Протокол встречи", created:date('2026-05-17'), context:"Produced by BP-004; edited in BP-005; exported in BP-006. Corresponds to OBJ-006. Also used in the short form «Протокол» (former GLO-007, merged here).", name:"Meeting Protocol", definition:"A structured summary document produced from the transcript by the LLM generation pipeline. Contains sections for meeting participants, discussion topics, decisions made, and action items with assignees and deadlines. Stored in Markdown and exportable to PDF.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-029", properties:{aliases:["Пространство", "Рабочее пространство"], name_ru:"Пространство", created:date('2026-05-17'), name:"Workspace", context:"ent-008; выбор пространства — UC-402; создаётся и выдаётся оператором через CLI (SR-03).", definition:"Единица изоляции данных: все члены пространства видят в нём все встречи, проекты и протоколы. У каждого пользователя есть личное пространство; общие выдаются по членству.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-008", properties:{aliases:["Поручение", "Action Item"], name_ru:"Поручение", created:date('2026-05-17'), name:"Action Item", context:"Protocol section of OBJ-006 (BP-004); project register ent-020 (Task) with change history ent-022 (TaskEvent).", definition:"A commitment agreed at a meeting: an assignment to a named project participant with the meeting context and a deadline. Extracted by the LLM from the transcript; appears in the protocol section «## Поручения» (protocols generated before 2026-10 call this section «## Задачи») and, in a project, as an entry of the project register (code T-n, status, assignee, due date, history of events). The word «задача» is not used in the product: the user-facing name is «поручение»; code identifiers (Task, /api/projects/:id/tasks, T-n) are unchanged.", updated:date('2026-10-09'), code_name:"Task", status:"approved"}}, {id:"GLO-009", properties:{aliases:["Решение"], name_ru:"Решение", created:date('2026-05-17'), name:"Decision", context:"Captured as a section within OBJ-006 (Protocol); extracted during BP-004 (Protocol Generation).", definition:"A conclusion or resolution reached during the meeting that is explicitly recorded in the protocol. Decisions are distinct from action items in that they represent outcomes rather than future tasks.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-010", properties:{aliases:["Тема обсуждения", "Вопрос", "Agenda Item"], name_ru:"Тема обсуждения", created:date('2026-05-17'), context:"Captured as a section within OBJ-006 (Protocol); extracted during BP-004 (Protocol Generation).", name:"Discussion Topic", definition:"A distinct agenda point or subject discussed during the meeting. The LLM groups related transcript content under topics, which become named sections within the protocol.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-011", properties:{aliases:["Участник", "Attendee"], name_ru:"Участник", created:date('2026-05-17'), name:"Participant", context:"Derived from speaker segments in OBJ-004 (Transcript); surfaced in OBJ-006 (Protocol).", definition:"A person who took part in the meeting. Identified in the transcript through speaker labels (GLO-038) and, in a project, mapped to project participants (GLO-032). The participant list appears as a dedicated section of the protocol.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-012", properties:{aliases:["Автор", "Uploader"], name_ru:"Автор", created:date('2026-05-17'), name:"Author", context:"Defined as ROL-01; performs BP-001, BP-003, BP-005, BP-006. Per FR-003 an Author is a User (GLO-027) acting inside a workspace (GLO-029).", definition:"The business role of a workspace member who uploaded a meeting recording and owns the derived artifacts (transcript and protocol). Any member of the same workspace sees these artifacts (the workspace is the isolation unit).", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-013", properties:{aliases:["Читатель протокола", "Проверяющий"], name_ru:"Читатель протокола", created:date('2026-05-17'), name:"Reviewer", context:"Defined as ROL-02; same permissions as Author after FR-003 (access is defined by workspace membership). Feedback is captured as Protocol Feedback (GLO-045).", definition:"A business role of a workspace member who reads, validates and gives feedback on a protocol produced by another member. Has no separate access rights: all workspace members see everything in the workspace.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-014", properties:{aliases:["Пайплайн транскрибации", "Transcription Flow"], name_ru:"Пайплайн транскрибации", created:date('2026-05-17'), context:"Corresponds to BP-002 (Transcribe Audio) and its constituent workflow steps.", name:"Transcription Pipeline", definition:"The end-to-end automated sequence of steps that transforms an uploaded video recording into a verbatim speaker-attributed transcript. Encompasses audio extraction, ASR, and speaker diarization.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-015", properties:{aliases:["Жизненный цикл протокола"], name_ru:"Жизненный цикл протокола", created:date('2026-05-17'), context:"Spans BP-004 (generation), BP-005 (editing), BP-006 (export); states tracked via OBJ-006 and Meeting status OBJ-001.", name:"Protocol Lifecycle", definition:"The ordered sequence of states a Meeting Protocol passes through from generation to final export: generated → edited (zero or more times) → exported. Tracks how the document evolves after LLM creation.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-016", properties:{aliases:["Automatic Speech Recognition", "Распознавание речи", "Speech-to-Text", "STT"], name_ru:"Распознавание речи", created:date('2026-05-17'), name:"ASR", context:"Invoked inside BP-002 (Transcription); implemented by Deepgram Nova-3 behind IAsrProvider.", definition:"Automatic Speech Recognition — the technology that converts audio speech into written text. In Transcrib, ASR is performed by an external engine (EXT-01) that also handles speaker diarization.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-017", properties:{aliases:["Large Language Model", "Большая языковая модель", "Language Model"], name_ru:"Большая языковая модель", created:date('2026-05-17'), name:"LLM", context:"Invoked inside BP-004 (Protocol Generation) via EXT-02; production provider is OpenRouter (anthropic/claude-haiku-5.5) behind ILlmProvider, kie.ai is the fallback adapter.", definition:"Large Language Model — an AI model used to summarize and structure the verbatim transcript into a formatted meeting protocol. The LLM receives a prompt containing the transcript and a template, and returns structured Markdown.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-018", properties:{aliases:["Обработка", "Фоновая обработка", "Background Job"], name_ru:"Обработка", created:date('2026-05-17'), name:"Async Job", context:"Materialized as OBJ-003 (TranscriptionJob) and OBJ-005 (ProtocolGenerationJob).", definition:"A background operation that performs long-running work (transcription or protocol generation) outside the synchronous request-response cycle. The user sees its progress through meeting statuses and server-sent events and gets the result when processing completes. In the UI it is called «обработка».", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-019", properties:{aliases:["Обработка распознавания"], name_ru:"Обработка распознавания", created:date('2026-05-17'), context:"Created in BP-001; executed in BP-002. Corresponds to OBJ-003.", name:"TranscriptionJob", definition:"The specific async job record that tracks ASR and diarization pipeline execution for a single recording. Transitions through queued → in_progress → completed | failed, and is the primary means of surfacing transcription progress and errors to the system.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-020", properties:{aliases:["Обработка генерации протокола"], name_ru:"Обработка генерации протокола", created:date('2026-05-17'), context:"Triggered at end of BP-002; executed in BP-004. Corresponds to OBJ-005.", name:"ProtocolGenerationJob", definition:"The specific async job record that tracks LLM-based protocol generation for a single transcript. Created automatically when the TranscriptionJob completes; tracks prompt template version, timing, and failure details.", updated:date('2026-10-09'), status:"approved"}}] AS row
CREATE (n:GlossaryTerm{id: row.id}) SET n += row.properties;
UNWIND [{id:"GLO-021", properties:{aliases:["Объектное хранилище", "Blob Storage", "File Storage"], name_ru:"Объектное хранилище", created:date('2026-05-17'), name:"Object Storage", context:"Corresponds to EXT-04; used in BP-001 (Upload) and BP-002 (Transcription); S3-compatible storage (MinIO locally, AWS S3/R2 in production).", definition:"A remote binary storage service used to persist large video files uploaded by the user. The system stores the file in object storage and records only the storage path reference in the Recording entity.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-022", properties:{assumption_note:"Template format and versioning mechanism are TBD at MVP; the term is recorded to ensure traceability of generation reproducibility.", aliases:["Шаблон промпта", "LLM Prompt"], name_ru:"Шаблон промпта", created:date('2026-05-17'), context:"Used in BP-004 (Protocol Generation); version is recorded in OBJ-005 (ProtocolGenerationJob) for audit.", name:"Prompt Template", definition:"A versioned template that defines the structure and instructions given to the LLM when generating a meeting protocol from a transcript. The template controls which sections (participants, topics, decisions, action items) the LLM must produce and in what format.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-023", properties:{aliases:["Маркдаун"], name_ru:"Маркдаун", created:date('2026-05-17'), name:"Markdown", context:"Stored in OBJ-006.markdown_content; edited in BP-005; exported in BP-006.", definition:"A lightweight text markup language used as the internal storage format for meeting protocols. The user edits the protocol as Markdown in the built-in editor; Markdown is also the source format for PDF export.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-024", properties:{aliases:["Экспорт в PDF", "Export to PDF"], name_ru:"Экспорт в PDF", created:date('2026-05-17'), name:"PDF Export", context:"Performed in BP-006 (Export Protocol to PDF); triggered by the Author.", definition:"The on-demand conversion of a Markdown protocol document to a PDF file delivered to the user as a browser download. The PDF is a transient artifact — it is not persisted in the system after delivery.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-025", properties:{aliases:["Загрузка", "File Upload"], name_ru:"Загрузка", created:date('2026-05-17'), name:"Upload", context:"The first user action; corresponds to BP-001 (Upload Meeting Video).", definition:"The user action of submitting a video file to the system via the web interface. Upload initiates the meeting record creation and queues the transcription pipeline. Files up to 300–500 MB must be supported.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-026", properties:{assumption_note:"The set of supported languages and whether auto-detection is accurate are TBD pending ASR vendor selection.", aliases:["Подсказка языка", "Source Language", "Language Setting"], name_ru:"Подсказка языка", created:date('2026-05-17'), name:"Language Hint", context:"Stored as Meeting.language (OBJ-001-A03); supplied during BP-001 (Upload); passed to the ASR engine in BP-002.", definition:"An optional user-supplied indication of the primary spoken language in the recording (e.g., Russian, English, or auto-detect). The ASR engine uses this hint to improve transcription accuracy.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-027", properties:{aliases:["Пользователь", "Член пространства"], name_ru:"Пользователь", created:date('2026-05-17'), name:"User", context:"Workspace member (FR-003): plays the Author role (ROL-01) for the meetings they upload and may read other members' meetings in the same workspace. Signs in via UC-400; the operator role SR-03 is not represented in the web UI.", definition:"A person who signs in to Transcrib with a personal PIN and works inside the workspaces they are a member of (Membership): uploads meetings, reviews transcripts, edits and exports protocols. Accounts, workspaces and memberships are managed only by the operator through the CLI (SR-03).", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-028", properties:{assumption_note:"Resolution method (heuristic or LLM-based) and confidence threshold are TBD at SA phase.", aliases:["Определение имён спикеров", "Подтверждение имён", "Name Attribution"], name_ru:"Определение имён спикеров", created:date('2026-05-17'), name:"Speaker Name Resolution", context:"Performed inside BP-002 at step BP-002-S07B; results stored in Transcript.speaker_map (OBJ-004-A08). Confirmed by the user in UC-505 before protocol generation.", definition:"Post-diarization step that substitutes anonymous speaker labels («Спикер 1», «Спикер 2», ...) with real participant names. Names come from project participants or from the transcript itself (self-introductions, addressed names), and are confirmed by the user at the speaker confirmation step (GLO-037). Unresolved labels remain as «Спикер N».", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-030", properties:{aliases:["Членство", "Доступ к пространству"], name_ru:"Членство", created:date('2026-05-17'), name:"Membership", context:"ent-009; CLI user:grant / user:create --workspace.", definition:"Связь пользователя с пространством (уникальна по паре пользователь + пространство). Определяет, какие пространства видит пользователь. Выдаётся оператором через CLI.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-031", properties:{aliases:["Проект"], name_ru:"Проект", created:date('2026-05-17'), name:"Project", context:"ent-012; UC-500, UC-501; FR-006.", definition:"Группа встреч пространства с общим контекстом (участники проекта, термины проекта) и памятью проекта. Удаление проекта не удаляет встречи: у них пропадает только привязка к проекту.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-032", properties:{aliases:["Участник проекта", "Постоянный участник"], name_ru:"Участник проекта", created:date('2026-05-17'), context:"ent-013; UC-501, UC-505.", name:"Project Participant", definition:"Постоянный участник встреч проекта: имя, варианты написания и организация. Имена идут подсказкой в распознавание речи и в промпт протокола; метки спикеров сопоставляются с участниками проекта. Не путать с участником конкретной встречи (GLO-011).", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-033", properties:{aliases:["Термин проекта", "Термин глоссария проекта"], name_ru:"Термин проекта", created:date('2026-05-17'), name:"Project Glossary Term", context:"ent-014 (таблица продукта, а не узел графа спецификации); UC-501.", definition:"Термин предметной области проекта, который помогает распознаванию и протоколу писать слова верно. Это данные продукта; не путать с глоссарием спецификации (узлы GlossaryTerm в графе, GLO-xxx), в котором описан этот словарь.", code_name:"GlossaryTerm", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-034", properties:{aliases:["Контекст встречи"], name_ru:"Контекст встречи", created:date('2026-05-17'), context:"ent-015; UC-502, UC-504.", name:"Meeting Context", definition:"Необязательные сведения о конкретной встрече: проект, тип, цель, повестка, дополнительные участники и термины, предыдущий протокол, заметки. Заполняется при загрузке, фиксируется снимком при запуске распознавания.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-035", properties:{aliases:["Снимок контекста", "Использованный контекст"], name_ru:"Снимок контекста", created:date('2026-05-17'), name:"Context Snapshot", context:"ent-015.snapshot_hash; UC-503, UC-504.", definition:"Неизменяемая копия контекста встречи в момент запуска распознавания (карточка проекта + данные встречи + текст предыдущего протокола) с хэшем snapshot_hash. Правки проекта после запуска снимок не меняют; пользователь может посмотреть, какой контекст был использован.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-036", properties:{aliases:["Запуск распознавания", "Начать распознавание", "AWAITING_START"], name_ru:"Запуск распознавания", created:date('2026-05-17'), name:"Transcription Start", context:"UC-503; статус встречи AWAITING_START.", definition:"Явное действие пользователя после загрузки: «Начать распознавание». До него встреча стоит в статусе AWAITING_START и контекст можно править; после — контекст фиксируется снимком и стартует обработка.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-037", properties:{aliases:["Подтверждение спикеров", "AWAITING_SPEAKERS"], name_ru:"Подтверждение спикеров", created:date('2026-05-17'), name:"Speaker Confirmation", context:"UC-505; FR-007; статус встречи AWAITING_SPEAKERS.", definition:"Шаг после распознавания и до генерации протокола: пользователь сопоставляет метки «Спикер N» с участниками проекта или именами (можно объединять дубли) либо пропускает шаг. До подтверждения встреча стоит в статусе AWAITING_SPEAKERS.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-038", properties:{aliases:["Спикер", "Метка спикера", "Speaker label"], name_ru:"Спикер", created:date('2026-05-17'), name:"Speaker", context:"Сегменты транскрипта OBJ-004; UC-505.", definition:"Анонимная метка диаризации «Спикер N», присвоенная голосу в распознанной записи. Один человек может получить несколько меток; после подтверждения (GLO-037) метка заменяется именем участника. В коде метка хранится как SPEAKER_n; это идентификатор, пользователю он не показывается. Не синоним участника (GLO-011).", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-039", properties:{aliases:["Ключевой термин", "Keyterm"], name_ru:"Ключевой термин", created:date('2026-05-17'), name:"Keyterm", context:"ASR keyterms (Deepgram); ent-013, ent-014.", definition:"Слово или имя, которое передаётся распознаванию речи как подсказка: имена участников проекта первыми, затем термины проекта, не более 50. Повышает точность распознавания имён и терминов.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-040", properties:{aliases:["Решение проекта", "D-n"], name_ru:"Решение проекта", created:date('2026-05-17'), context:"ent-021; UC-604.", name:"Project Decision", definition:"Решение, принятое на встрече проекта и сохранённое в памяти проекта с кодом D-n, цитатой и связью с поручениями. Отличается от решения как раздела протокола (GLO-009): это запись реестра проекта, а не текст протокола.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-041", properties:{aliases:["Событие поручения", "TaskEvent"], name_ru:"Событие поручения", created:date('2026-05-17'), name:"Action Item Event", context:"ent-022; UC-601, UC-602, UC-603.", definition:"Изменение одного поля поручения (создание, упоминание, закрытие, смена исполнителя или срока, слияние), привязанное к встрече. Уверенные изменения применяются автоматически, остальные попадают в очередь подтверждения (GLO-042) с цитатой.", code_name:"TaskEvent", updated:date('2026-10-09'), status:"approved"}}] AS row
CREATE (n:GlossaryTerm{id: row.id}) SET n += row.properties;
UNWIND [{id:"GLO-042", properties:{aliases:["Очередь подтверждения", "Очередь на разбор"], name_ru:"Очередь подтверждения", created:date('2026-05-17'), name:"Confirmation Queue", context:"ent-022 (статус PENDING); UC-602.", definition:"Список событий поручений, которые модель предложила, но не применила сама (закрытие, отмена, слияние, смена исполнителя, неуверенные правки). Пользователь принимает или отклоняет каждое, видя цитату из встречи.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-043", properties:{aliases:["Память проекта"], name_ru:"Память проекта", created:date('2026-05-17'), name:"Project Memory", context:"ent-023; UC-600, UC-604; хранится в графе памяти.", definition:"Накопленное знание проекта между встречами: версионируемая сводка, реестр поручений, решения. Обновляется после каждого протокола и подаётся в промпт следующего, без утечки чужих участников и контекста.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-044", properties:{aliases:["Версия протокола", "История протокола"], name_ru:"Версия протокола", created:date('2026-05-17'), name:"Protocol Version", context:"ent-017; UC-300, UC-301, UC-303.", definition:"Неизменяемая запись текста протокола: версия 1 создаётся генерацией, каждая правка пользователя добавляет следующую. Текущий текст остаётся в протоколе, история только пополняется.", code_name:"ProtocolVersion", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-045", properties:{aliases:["Обратная связь на протокол", "Отзыв на протокол", "Обратная связь"], name_ru:"Обратная связь на протокол", created:date('2026-05-17'), context:"ent-018; UC-304, UC-305.", name:"Protocol Feedback", definition:"Отзыв читателя на конкретную версию протокола: комментарий, исправленный текст или файл Word с правками. Файл разбирается и учитывается при следующей генерации.", code_name:"ProtocolFeedback", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-046", properties:{aliases:["Генерация протокола", "Запуск генерации"], name_ru:"Генерация протокола", created:date('2026-05-17'), name:"Protocol Generation", context:"ent-016; связан с OBJ-005 (GLO-020).", definition:"Аудит одного прогона модели (протокол или обновление памяти): модель, версия промпта, снимок контекста, подсказки распознавания, расход токенов. Отвечает на вопрос, чем и из чего сделана версия протокола.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-047", properties:{aliases:["Исходящая очередь графа", "GraphOutbox"], name_ru:"Исходящая очередь графа", created:date('2026-05-17'), context:"ent-019; UC-605.", name:"GraphOutbox", definition:"Служебная очередь в базе данных, из которой воркер переносит изменения (удаление встречи или проекта) в граф памяти проекта с повторами, пока граф недоступен. Пользователю не видна.", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-048", properties:{aliases:["Сессия входа"], name_ru:"Сессия входа", created:date('2026-05-17'), context:"ent-010; UC-400, UC-401.", name:"Auth Session", definition:"Серверная сессия пользователя после ввода PIN: cookie transcrib_session живёт 30 дней, выход её удаляет. Не путать со встречей: слово «сессия» встречей не называется.", code_name:"AuthSession", updated:date('2026-10-09'), status:"approved"}}, {id:"GLO-049", properties:{aliases:["Блокировка входа", "Блокировка клиента"], name_ru:"Блокировка входа", created:date('2026-05-17'), name:"Login Block", context:"ent-011; UC-400; снимает оператор (SR-03).", definition:"Ограничение попыток ввода PIN: после 10 неудач с одного клиента вход блокируется, даже для верного PIN, пока оператор не снимет блокировку через CLI.", code_name:"LoginBlock", updated:date('2026-10-09'), status:"approved"}}] AS row
CREATE (n:GlossaryTerm{id: row.id}) SET n += row.properties;
UNWIND [{id:"EXT-01", properties:{name:"Meeting Participant", description:"The human user who interacts with the system UI: uploads the meeting video file and downloads the resulting verbatim transcript and meeting protocol", type:"User"}}, {id:"EXT-02", properties:{assumption_note:"Dedicated ASR+diarization engine required for speaker-attributed timestamped transcripts. Cloud API or self-hosted. Stack TBD.", name:"ASR / Diarization Engine", description:"External ASR and speaker diarization service. Receives audio, returns speaker-attributed transcript segments with timestamps. Vendor/model TBD.", type:"ExternalSystem", status:"assumption"}}, {id:"EXT-03", properties:{assumption_note:"LLM is the natural tool to transform raw transcript into structured protocol. Provider TBD.", name:"LLM Protocol Generator", description:"LLM service that converts the verbatim transcript into a structured meeting protocol (participants, topics, decisions, action items). Provider/model TBD.", type:"ExternalSystem", status:"assumption"}}, {id:"EXT-04", properties:{assumption_note:"Large file sizes imply dedicated storage layer for durability across async steps. S3/local FS/similar. Stack TBD.", name:"File / Object Storage", description:"Object storage that holds uploaded video files during async processing. Required because multi-hundred-MB to multi-GB files cannot be held in memory through the pipeline. In production this is an external S3-compatible service (S3_ENDPOINT), not a co-located MinIO: uploaded bytes go browser -> storage directly via presigned multipart and never traverse the API host's disk.", type:"ExternalSystem", updated:datetime('2026-08-15T14:43:08.536Z'), status:"assumption"}}] AS row
CREATE (n:ExternalEntity{id: row.id}) SET n += row.properties;
UNWIND [{id:"STK-01", properties:{role:"Primary User", interest:"Uploads meeting video recordings and receives verbatim transcripts and structured meeting protocols for archiving, reporting, or task tracking", name:"Meeting Participant"}}, {id:"STK-02", properties:{assumption_note:"Inferred as natural consumer of protocol artifact. In MVP scope may be same person as STK-01.", role:"Secondary Stakeholder (assumption)", interest:"Interested in the meeting protocol artifact for distributing decisions and action items", name:"Meeting Organizer", status:"assumption"}}] AS row
CREATE (n:Stakeholder{id: row.id}) SET n += row.properties;
UNWIND [{_id:34, properties:{field_category:"input", name:"title", label:"Встреча", id:"FORM-MeetingCatalog-F01", label_en:"Title", updated:datetime('2026-05-18T07:04:51.208Z'), field_type:"text", required:false, order:1}}, {_id:35, properties:{field_category:"input", name:"status", label:"Статус", id:"FORM-MeetingCatalog-F02", label_en:"Status", field_type:"select", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:2}}, {_id:36, properties:{field_category:"input", name:"language", label:"Язык", id:"FORM-MeetingCatalog-F03", label_en:"Language", field_type:"select", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:3}}, {_id:37, properties:{field_category:"input", name:"uploaded_at", label:"Загружена", id:"FORM-MeetingCatalog-F04", label_en:"Uploaded", field_type:"datetime", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:4}}, {_id:38, properties:{field_category:"input", name:"duration_sec", label:"Длительность", id:"FORM-MeetingCatalog-F05", label_en:"Duration", field_type:"number", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:5}}, {_id:39, properties:{field_category:"action", name:"open_button", label:"Открыть", id:"FORM-MeetingCatalog-F06", label_en:"Open", field_type:"button", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:6}}, {_id:40, properties:{field_category:"input", name:"title", label:"Название", id:"FORM-MeetingDetail-F01", label_en:"Title", updated:datetime('2026-05-18T07:04:51.208Z'), field_type:"text", required:false, order:1}}, {_id:41, properties:{field_category:"input", name:"language", label:"Язык", id:"FORM-MeetingDetail-F02", label_en:"Language", field_type:"select", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:2}}, {_id:42, properties:{field_category:"input", name:"status", label:"Статус", id:"FORM-MeetingDetail-F03", label_en:"Status", field_type:"select", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:3}}, {_id:43, properties:{field_category:"input", name:"uploaded_at", label:"Загружена", id:"FORM-MeetingDetail-F04", label_en:"Uploaded at", field_type:"datetime", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:4}}, {_id:44, properties:{field_category:"input", name:"updated_at", label:"Обновлена", id:"FORM-MeetingDetail-F05", label_en:"Last update", field_type:"datetime", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:5}}, {_id:45, properties:{field_category:"input", name:"filename", label:"Имя файла", id:"FORM-MeetingDetail-F06", label_en:"File name", updated:datetime('2026-05-18T07:04:51.208Z'), field_type:"text", required:true, order:6}}, {_id:46, properties:{field_category:"input", name:"size_bytes", label:"Размер", id:"FORM-MeetingDetail-F07", label_en:"Size", field_type:"number", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:7}}, {_id:47, properties:{field_category:"input", name:"mime_type", label:"Формат", id:"FORM-MeetingDetail-F08", label_en:"Format", field_type:"select", updated:datetime('2026-05-18T07:04:51.208Z'), required:true, order:8}}, {_id:48, properties:{field_category:"input", name:"duration_sec", label:"Длительность", id:"FORM-MeetingDetail-F09", label_en:"Duration", field_type:"number", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:9}}, {_id:49, properties:{field_category:"input", name:"error_reason", label:"Ошибка", id:"FORM-MeetingDetail-F10", label_en:"Error", field_type:"textarea", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:10}}, {_id:50, properties:{field_category:"action", name:"delete_button", label:"Удалить встречу", id:"FORM-MeetingDetail-F11", label_en:"Delete meeting", field_type:"button", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:11}}, {_id:51, properties:{field_category:"display", name:"header", label:"Delete this meeting?", id:"FORM-MeetingDeleteConfirm-F01", field_type:"header", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:1}}, {_id:52, properties:{field_category:"input", name:"title", label:"Meeting title", id:"FORM-MeetingDeleteConfirm-F02", updated:datetime('2026-05-18T07:04:51.208Z'), field_type:"text", required:false, order:2}}, {_id:53, properties:{field_category:"action", name:"confirm_button", label:"Confirm delete", id:"FORM-MeetingDeleteConfirm-F03", field_type:"button", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:3}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:FormField;
UNWIND [{_id:54, properties:{field_category:"action", name:"cancel_button", label:"Cancel", id:"FORM-MeetingDeleteConfirm-F04", field_type:"button", updated:datetime('2026-05-18T07:04:51.208Z'), required:false, order:4}}, {_id:55, properties:{field_category:"display", name:"header", label:"Загрузить запись встречи", id:"FORM-MeetingUpload-F01", label_en:"Upload meeting video", field_type:"header", updated:datetime('2026-05-18T07:06:40.999Z'), required:false, order:1}}, {_id:56, properties:{field_category:"input", drift_corrected_note:"Label said \"MP4 / MKV / MOV, max 500 MB\" — stale against RQ-008/RQ-009 and the shipped code. User-facing string; web/ copy should be checked to match.", name:"file", label:"Файл записи (видео или аудио: MP4 / MKV / MOV / WebM, до 2,5 ГиБ, до 4 ч)", id:"FORM-MeetingUpload-F02", label_en:"Video file (MP4 / MKV / MOV / WebM, max 2.5 GiB, max 4 h)", field_type:"file", updated:datetime('2026-08-17T09:14:27.065Z'), required:true, order:2}}, {_id:57, properties:{field_category:"input", drift_corrected_note:"Label said \"Language (leave blank for auto-detect)\" - stale against BRQ-013 as amended by DEC-003 (2026-08-14). The field selects the PROTOCOL's language, not merely an ASR hint: blank/AUTO yields a Russian protocol (not an auto-detected one), and EN is the only way to obtain an English protocol (RQ-012). The ASR auto-detection role (BRQ-005) is retained in the new label. Corrected 2026-08-15; web/ i18n strings must be brought to match.", name:"language", label:"Язык протокола (пусто = русский, речь определяется автоматически)", id:"FORM-MeetingUpload-F03", label_en:"Protocol language (blank = Russian, speech auto-detected)", field_type:"select", updated:datetime('2026-08-15T13:57:51.576Z'), required:false, order:3}}, {_id:58, properties:{field_category:"input", name:"title", label:"Название встречи (по умолчанию — имя файла)", id:"FORM-MeetingUpload-F04", label_en:"Meeting title (defaults to filename)", updated:datetime('2026-05-18T07:06:40.999Z'), field_type:"text", required:false, order:4}}, {_id:59, properties:{field_category:"action", name:"submit_button", label:"Загрузить", id:"FORM-MeetingUpload-F05", label_en:"Upload", field_type:"button", updated:datetime('2026-05-18T07:06:40.999Z'), required:false, order:5}}, {_id:60, properties:{field_category:"action", name:"cancel_button", label:"Отмена", id:"FORM-MeetingUpload-F06", label_en:"Cancel", field_type:"button", updated:datetime('2026-05-18T07:06:40.999Z'), required:false, order:6}}, {_id:61, properties:{field_category:"display", name:"header", label:"Transcript", id:"FORM-TranscriptView-F01", field_type:"header", updated:datetime('2026-05-18T07:07:50.001Z'), required:false, order:1}}, {_id:62, properties:{field_category:"input", name:"language", label:"Language", id:"FORM-TranscriptView-F02", field_type:"select", updated:datetime('2026-05-18T07:07:50.001Z'), required:true, order:2}}, {_id:63, properties:{field_category:"input", name:"segments_count", label:"Segments", id:"FORM-TranscriptView-F03", field_type:"number", updated:datetime('2026-05-18T07:07:50.001Z'), required:true, order:3}}, {_id:64, properties:{field_category:"input", name:"speakers_count", label:"Speakers", id:"FORM-TranscriptView-F04", field_type:"number", updated:datetime('2026-05-18T07:07:50.001Z'), required:true, order:4}}, {_id:65, properties:{field_category:"input", name:"created_at", label:"Created", id:"FORM-TranscriptView-F05", field_type:"datetime", updated:datetime('2026-05-18T07:07:50.001Z'), required:true, order:5}}, {_id:66, properties:{field_category:"input", name:"full_text", label:"Transcript content", id:"FORM-TranscriptView-F06", field_type:"textarea", updated:datetime('2026-05-18T07:07:50.001Z'), required:true, order:6}}, {_id:67, properties:{field_category:"input", name:"speaker_map", label:"Speaker name map", id:"FORM-TranscriptView-F07", field_type:"textarea", updated:datetime('2026-05-18T07:07:50.001Z'), required:false, order:7}}, {_id:68, properties:{field_category:"action", name:"download_button", label:"Download as text", id:"FORM-TranscriptView-F08", field_type:"button", updated:datetime('2026-05-18T07:07:50.001Z'), required:false, order:8}}, {_id:69, properties:{field_category:"action", name:"back_button", label:"Back to meeting", id:"FORM-TranscriptView-F09", field_type:"button", updated:datetime('2026-05-18T07:07:50.001Z'), required:false, order:9}}, {_id:70, properties:{field_category:"display", name:"header", label:"Protocol editor", id:"FORM-ProtocolEditor-F01", field_type:"header", updated:datetime('2026-05-18T07:09:31.14Z'), required:false, order:1}}, {_id:71, properties:{field_category:"input", name:"markdown_content", label:"Protocol (Markdown)", id:"FORM-ProtocolEditor-F02", field_type:"textarea", updated:datetime('2026-05-18T07:09:31.14Z'), required:true, order:2}}, {_id:72, properties:{field_category:"input", name:"version", label:"Version", id:"FORM-ProtocolEditor-F03", field_type:"number", updated:datetime('2026-05-18T07:09:31.14Z'), required:true, order:3}}, {_id:73, properties:{field_category:"input", name:"edit_count", label:"Edits", id:"FORM-ProtocolEditor-F04", field_type:"number", updated:datetime('2026-05-18T07:09:31.14Z'), required:true, order:4}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:FormField;
UNWIND [{_id:74, properties:{field_category:"input", name:"last_edited_at", label:"Last edited", id:"FORM-ProtocolEditor-F05", field_type:"datetime", updated:datetime('2026-05-18T07:09:31.14Z'), required:false, order:5}}, {_id:75, properties:{field_category:"input", name:"generated_at", label:"Generated", id:"FORM-ProtocolEditor-F06", field_type:"datetime", updated:datetime('2026-05-18T07:09:31.14Z'), required:true, order:6}}, {_id:76, properties:{field_category:"action", name:"save_button", label:"Save", id:"FORM-ProtocolEditor-F07", field_type:"button", updated:datetime('2026-05-18T07:09:31.14Z'), required:false, order:7}}, {_id:77, properties:{field_category:"action", name:"export_pdf_button", label:"Export PDF", id:"FORM-ProtocolEditor-F08", field_type:"button", updated:datetime('2026-05-18T07:09:31.14Z'), required:false, order:8}}, {_id:78, properties:{field_category:"action", name:"back_button", label:"Back to meeting", id:"FORM-ProtocolEditor-F09", field_type:"button", updated:datetime('2026-05-18T07:09:31.14Z'), required:false, order:9}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:FormField;
UNWIND [{_id:79, properties:{component_type:"layout", name:"FormLayout", description:"Standard form/page shell: header slot, body slot, action-bar slot. Applies the global spacing and accessibility patterns to every screen.", id:"CMP-FormLayout", updated:datetime('2026-05-18T07:13:40.556Z'), props:"header, body, actionBar, isLoading, errorBanner"}}, {_id:80, properties:{component_type:"display", name:"StatusBadge", description:"Compact badge that renders a MeetingStatus enum value with status-specific color/icon. Used in both catalog rows and detail headers.", id:"CMP-StatusBadge", updated:datetime('2026-05-18T07:13:40.556Z'), props:"status, size, withIcon"}}, {_id:81, properties:{component_type:"input", name:"LanguageSelect", description:"Bilingual (RU/EN) selector with a 'blank = auto-detect' option. Renders as a select on input forms and as a read-only badge on display forms (controlled by isReadOnly prop).", id:"CMP-LanguageSelect", updated:datetime('2026-05-18T07:13:40.556Z'), props:"value, isReadOnly, allowBlank, onChange"}}, {_id:82, properties:{component_type:"display", name:"DurationFormat", description:"Formats a duration in seconds as a human-readable string (e.g., 4523 -> '1h 15m 23s'). Returns a placeholder when value is null (duration not yet extracted).", id:"CMP-DurationFormat", updated:datetime('2026-05-18T07:13:40.556Z'), props:"seconds, placeholder, abbreviated"}}, {_id:83, properties:{component_type:"feedback", name:"ConfirmDialog", description:"Modal confirmation dialog with title, body, destructive/primary action variants. Used for meeting deletion (UC-003) and unsaved-changes warning in the protocol editor (UC-301 AS08).", id:"CMP-ConfirmDialog", updated:datetime('2026-05-18T07:13:40.556Z'), props:"open, title, body, confirmLabel, cancelLabel, variant, onConfirm, onCancel"}}, {_id:84, properties:{component_type:"navigation", route:"/", menu_order:1, roles:"AUTHOR", name:"NavMeetingCatalog", in_menu:true, description:"Top-level route 'Meetings' (catalog). Default landing page for AUTHOR.", id:"CMP-NavMeetingCatalog", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:85, properties:{component_type:"navigation", menu_order:2, route:"/upload", roles:"AUTHOR", name:"NavMeetingUpload", in_menu:true, description:"Top-level route 'Upload'. AUTHOR uploads a new meeting video.", id:"CMP-NavMeetingUpload", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:86, properties:{component_type:"navigation", route:"/meetings/:id", roles:"AUTHOR", name:"NavMeetingDetail", in_menu:false, description:"Meeting detail route. Reached by clicking a row in the catalog. Not a top-level menu item.", id:"CMP-NavMeetingDetail", parent_menu:"CMP-NavMeetingCatalog", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:87, properties:{component_type:"navigation", route:"/meetings/:id/delete", roles:"AUTHOR", name:"NavMeetingDeleteConfirm", in_menu:false, description:"Delete-confirmation route (also rendered as modal overlay over the detail page). Not a menu item.", id:"CMP-NavMeetingDeleteConfirm", parent_menu:"CMP-NavMeetingDetail", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:88, properties:{component_type:"navigation", route:"/meetings/:id/transcript", roles:"AUTHOR", name:"NavTranscriptView", in_menu:false, description:"Transcript view route. Reached via 'View transcript' link from meeting detail (gated by Meeting.status >= TRANSCRIPT_READY).", id:"CMP-NavTranscriptView", parent_menu:"CMP-NavMeetingDetail", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:89, properties:{component_type:"navigation", route:"/meetings/:id/protocol", roles:"AUTHOR", name:"NavProtocolEditor", in_menu:false, description:"Protocol editor route. Reached via 'Review/Edit protocol' link from meeting detail (gated by Meeting.status in {PROTOCOL_READY, EDITED}).", id:"CMP-NavProtocolEditor", parent_menu:"CMP-NavMeetingDetail", updated:datetime('2026-05-18T07:13:54.78Z')}}, {_id:526, properties:{component_type:"input", roles:"AUTHOR", in_menu:false, name:"Retry processing action", description:"Action button shown on the Meeting detail page only when Meeting.status=FAILED. Opens a confirm dialog (reuses CMP-ConfirmDialog) and POSTs the retry request. Drives UC-004.", id:"CMP-RetryProcessing", updated:datetime('2026-05-26T10:32:13.63Z'), props:"{ visibleWhen: \"meeting.status === FAILED\", confirm: true }"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:Component;
UNWIND [{_id:90, properties:{description:"File upload to object storage is in progress.", label:"Uploading", id:"ENUM-MeetingStatus-V01", value:"UPLOADING", order:1}}, {_id:91, properties:{description:"Transcription job is queued or running (ASR + diarization).", label:"Transcribing", id:"ENUM-MeetingStatus-V02", value:"TRANSCRIBING", order:2}}, {_id:92, properties:{description:"Transcript persisted; protocol generation has not started yet (or is in progress).", label:"Transcript ready", id:"ENUM-MeetingStatus-V03", value:"TRANSCRIPT_READY", order:3}}, {_id:93, properties:{description:"LLM-based protocol generation job is queued or running.", label:"Generating protocol", id:"ENUM-MeetingStatus-V04", value:"PROTOCOL_GENERATING", order:4}}, {_id:94, properties:{description:"Protocol has been generated and persisted; no manual edits yet.", label:"Protocol ready", id:"ENUM-MeetingStatus-V05", value:"PROTOCOL_READY", order:5}}, {_id:95, properties:{description:"Protocol has been manually edited at least once. Repeats on every save (version increments).", label:"Edited", id:"ENUM-MeetingStatus-V06", value:"EDITED", order:6}}, {_id:96, properties:{description:"Non-recoverable error in the transcription or protocol-generation pipeline. Terminal state per BRQ-009.", label:"Failed", id:"ENUM-MeetingStatus-V07", value:"FAILED", order:7}}, {_id:97, properties:{description:"Russian language. Used for ASR language hint and LLM prompt selection.", label:"Russian", id:"ENUM-MeetingLanguage-V01", value:"RU", order:1}}, {_id:98, properties:{description:"English language. Used for ASR language hint and LLM prompt selection.", label:"English", id:"ENUM-MeetingLanguage-V02", value:"EN", order:2}}, {_id:99, properties:{description:"MPEG-4 container.", id:"ENUM-VideoMimeType-V01", label:"MP4", value:"video/mp4", order:1}}, {_id:100, properties:{description:"Matroska container.", id:"ENUM-VideoMimeType-V02", label:"MKV", value:"video/x-matroska", order:2}}, {_id:101, properties:{description:"QuickTime / MOV container.", id:"ENUM-VideoMimeType-V03", label:"MOV", value:"video/quicktime", order:3}}, {_id:102, properties:{description:"Job created, waiting for a worker.", label:"Queued", id:"ENUM-JobStatus-V01", value:"QUEUED", order:1}}, {_id:103, properties:{description:"Worker is running the job.", label:"In progress", id:"ENUM-JobStatus-V02", value:"IN_PROGRESS", order:2}}, {_id:104, properties:{description:"Job finished successfully and the produced artifact has been persisted. Terminal.", label:"Completed", id:"ENUM-JobStatus-V03", value:"COMPLETED", order:3}}, {_id:105, properties:{description:"Job terminated with a non-recoverable error. error_reason MUST be set (BRQ-010). Terminal.", label:"Failed", id:"ENUM-JobStatus-V04", value:"FAILED", order:4}}, {_id:543, properties:{description:"Author did not declare a document language. The protocol is generated in Russian (BRQ-013) and the ASR runs with auto-detection (BRQ-005), recording what it found on Transcript.language. Valid on Meeting.language only - never a legal value for Transcript.language.", id:"ENUM-MeetingLanguage-V03", label:"Auto-detect", value:"AUTO", order:3}}, {_id:545, properties:{description:"WebM container. Added post-v0.2.0 to support full-meeting WebM recordings (RQ-009, BR-101); matches shared ACCEPTED_UPLOAD_MIME_TYPES.", id:"ENUM-VideoMimeType-V04", value:"video/webm", updated:datetime('2026-08-15T13:59:18.843Z')}}, {_id:563, properties:{description:"Наша команда", id:"ENUM-ParticipantSide-V01", label:"Наши", value:"OURS", order:1}}, {_id:564, properties:{description:"Сторона заказчика", label:"Клиент", id:"ENUM-ParticipantSide-V02", value:"CLIENT", order:2}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:EnumValue;
UNWIND [{_id:565, properties:{description:"Подрядчик / исполнитель", label:"Подрядчик", id:"ENUM-ParticipantSide-V03", value:"CONTRACTOR", order:3}}, {_id:566, properties:{description:"Прочие участники (по умолчанию)", label:"Другое", id:"ENUM-ParticipantSide-V04", value:"OTHER", order:4}}, {_id:567, properties:{description:"Переговоры с внешней стороной", label:"Переговоры", id:"ENUM-MeetingType-V01", value:"NEGOTIATION", order:1}}, {_id:568, properties:{description:"Статусная встреча по ходу работ", label:"Статус", id:"ENUM-MeetingType-V02", value:"STATUS", order:2}}, {_id:569, properties:{description:"Планирование работ", label:"Планирование", id:"ENUM-MeetingType-V03", value:"PLANNING", order:3}}, {_id:570, properties:{description:"Интервью / сбор требований", label:"Интервью", id:"ENUM-MeetingType-V04", value:"INTERVIEW", order:4}}, {_id:571, properties:{description:"Иной тип", label:"Другое", id:"ENUM-MeetingType-V05", value:"OTHER", order:5}}, {_id:572, properties:{description:"Генерация протокола встречи (UC-300)", label:"Протокол", id:"ENUM-ProtocolGenerationKind-V01", value:"PROTOCOL", order:1}}, {_id:573, properties:{description:"Извлечение задач и решений из протокола (UC-600)", id:"ENUM-ProtocolGenerationKind-V02", label:"Извлечение памяти", value:"MEMORY_EXTRACT", order:2}}, {_id:574, properties:{description:"Сопоставление извлечённого с реестром проекта (UC-600)", id:"ENUM-ProtocolGenerationKind-V03", label:"Сопоставление памяти", value:"MEMORY_RESOLVE", order:3}}, {_id:575, properties:{description:"Обновление сводки проекта (UC-600)", label:"Сводка проекта", id:"ENUM-ProtocolGenerationKind-V04", value:"MEMORY_SUMMARY", order:4}}, {_id:576, properties:{description:"Результат генерации LLM (с generationId)", label:"Сгенерирована", id:"ENUM-ProtocolVersionKind-V01", value:"GENERATED", order:1}}, {_id:577, properties:{description:"Сохранение пользователем (с authorUserId)", label:"Правка", id:"ENUM-ProtocolVersionKind-V02", value:"USER_EDIT", order:2}}, {_id:578, properties:{description:"Бэкфилл протокола до программы, который уже правили (editCount>0): оригинал генерации утрачен", label:"Перенесена", id:"ENUM-ProtocolVersionKind-V03", value:"LEGACY", order:3}}, {_id:579, properties:{description:"Текст (+ категория), без файла", label:"Комментарий", id:"ENUM-ProtocolFeedbackKind-V01", value:"COMMENT", order:1}}, {_id:580, properties:{description:"Текст или файл .md/.txt/.docx", label:"Исправленный протокол", id:"ENUM-ProtocolFeedbackKind-V02", value:"CORRECTED_PROTOCOL", order:2}}, {_id:581, properties:{description:"Файл .docx с комментариями и правками, разбирается в JSON (D-12)", label:"Рецензия Word", id:"ENUM-ProtocolFeedbackKind-V03", value:"DOCX_REVIEW", order:3}}, {_id:582, properties:{description:"Реплики приписаны не тем людям", id:"ENUM-ProtocolFeedbackCategory-V01", label:"Атрибуция спикеров", value:"SPEAKER_ATTRIBUTION", order:1}}, {_id:583, properties:{description:"В протоколе нет принятого решения", label:"Пропущено решение", id:"ENUM-ProtocolFeedbackCategory-V02", value:"MISSED_DECISION", order:2}}, {_id:584, properties:{description:"Задача искажена или лишняя", label:"Неверная задача", id:"ENUM-ProtocolFeedbackCategory-V03", value:"WRONG_TASK", order:3}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:EnumValue;
UNWIND [{_id:585, properties:{description:"В протоколе то, чего не было", label:"Выдумано", id:"ENUM-ProtocolFeedbackCategory-V04", value:"FABRICATED", order:4}}, {_id:586, properties:{description:"Ошибки в терминах и именах", label:"Термины и имена", id:"ENUM-ProtocolFeedbackCategory-V05", value:"TERMS_NAMES", order:5}}, {_id:587, properties:{description:"Подача и формулировки", label:"Стиль", id:"ENUM-ProtocolFeedbackCategory-V06", value:"STYLE", order:6}}, {_id:588, properties:{description:"Прочее", id:"ENUM-ProtocolFeedbackCategory-V07", label:"Другое", value:"OTHER", order:7}}, {_id:589, properties:{description:"Поставлена, не начата", label:"Открыта", id:"ENUM-MemoryTaskStatus-V01", value:"OPEN", order:1}}, {_id:590, properties:{description:"Выполняется", label:"В работе", id:"ENUM-MemoryTaskStatus-V02", value:"IN_PROGRESS", order:2}}, {_id:591, properties:{description:"Выполнена", label:"Сделана", id:"ENUM-MemoryTaskStatus-V03", value:"DONE", order:3}}, {_id:592, properties:{description:"Больше не нужна", label:"Отменена", id:"ENUM-MemoryTaskStatus-V04", value:"CANCELLED", order:4}}, {_id:593, properties:{description:"Перенесена на потом", label:"Отложена", id:"ENUM-MemoryTaskStatus-V05", value:"POSTPONED", order:5}}, {_id:594, properties:{description:"Задача впервые появилась", label:"Поставлена", id:"ENUM-TaskMentionKind-V01", value:"CREATED", order:1}}, {_id:595, properties:{description:"Сообщено об изменении статуса", label:"Статус", id:"ENUM-TaskMentionKind-V02", value:"STATUS_UPDATE", order:2}}, {_id:596, properties:{description:"Сменился исполнитель", label:"Переназначена", id:"ENUM-TaskMentionKind-V03", value:"REASSIGNED", order:3}}, {_id:597, properties:{description:"Сменился срок", id:"ENUM-TaskMentionKind-V04", label:"Срок", value:"DUE_CHANGED", order:4}}, {_id:598, properties:{description:"Упомянута без изменений", label:"Упомянута", id:"ENUM-TaskMentionKind-V05", value:"MENTIONED", order:5}}, {_id:599, properties:{description:"Извлечено из встречи", id:"ENUM-TaskEventSource-V01", label:"LLM", value:"LLM", order:1}}, {_id:600, properties:{description:"Ручная правка (UC-603) или решение в очереди", label:"Пользователь", id:"ENUM-TaskEventSource-V02", value:"USER", order:2}}, {_id:601, properties:{description:"Новые задачи, упоминания и уверенные обновления применяются сразу", label:"Применено", id:"ENUM-TaskEventReviewState-V01", value:"AUTO", order:1}}, {_id:602, properties:{description:"Закрытие, отмена, слияние дублей, смена исполнителя и неуверенные изменения", id:"ENUM-TaskEventReviewState-V02", label:"Ждёт подтверждения", value:"PENDING", order:2}}, {_id:603, properties:{description:"Применено после подтверждения", label:"Подтверждено", id:"ENUM-TaskEventReviewState-V03", value:"CONFIRMED", order:3}}, {_id:604, properties:{description:"Не применено; история сохранена", label:"Отклонено", id:"ENUM-TaskEventReviewState-V04", value:"REJECTED", order:4}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:EnumValue;
UNWIND [{_id:605, properties:{source_fr:"FR-004", description:"FR-004 / D-9: файл загружен с defer_start=true; ждёт «Начать» (POST /api/meetings/:id/start). Позиция в жизненном цикле: после UPLOADING, до TRANSCRIBING. Старый код это значение не пишет.", label:"Ждёт старта", id:"ENUM-MeetingStatus-V08", value:"AWAITING_START", order:8}}, {_id:883, properties:{description:"FR-007 / D-38: распознано, ждёт подтверждения спикеров (PUT /api/meetings/:id/speakers). Ставит воркер только для встреч с контекстом; позиция: после TRANSCRIBING, до GENERATING_PROTOCOL. Выход — только подтверждение/пропуск.", id:"ENUM-MeetingStatus-V09", value:"AWAITING_SPEAKERS", order:9}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:EnumValue;
UNWIND [{id:"BRQ-001", properties:{severity:"hard", created:date('2026-05-17'), name:"File size limit", statement:"Recording.size_bytes MUST be <= 2,684,354,560 bytes (2.5 GiB). Uploads exceeding the threshold are rejected before storage. (500 MB -> 1 GiB post-v0.2.0 -> 1.5 GiB by DEC-004 -> 2.5 GiB by DEC-005. BR-102 is the implementing SA-layer rule.)", classification:"constraint", updated:datetime('2026-08-17T09:14:27.065Z'), rationale:"Prevents runaway storage costs and ASR queue saturation from very large files at MVP scale.", status:"draft"}}, {id:"BRQ-002", properties:{severity:"hard", created:date('2026-05-17'), name:"Allowed file formats", statement:"Recording.mime_type MUST be one of {video/mp4, video/x-matroska, video/quicktime} (MP4, MKV, MOV). Other types are rejected.", classification:"constraint", updated:date('2026-05-17'), rationale:"ASR pipeline supports audio extraction only from these container formats; accepting others causes silent failures.", status:"draft"}}, {id:"BRQ-003", properties:{severity:"hard", assumption_note:"Validation method TBD (FFprobe header check or short-duration probe). Full frame-level integrity not guaranteed at MVP.", created:date('2026-05-17'), name:"File integrity", statement:"The uploaded file MUST be a valid, non-corrupt video container from which audio can be extracted. Corrupt or unplayable files are rejected during upload acceptance.", classification:"constraint", updated:date('2026-05-17'), rationale:"Corrupt files cause opaque failures deep in the ASR pipeline; early validation gives a clearer user-facing error.", status:"draft"}}, {id:"BRQ-004", properties:{severity:"hard", created:date('2026-05-17'), name:"Supported languages", statement:"Meeting.language MUST be one of {ru, en, auto}. Other values are rejected at upload.", classification:"constraint", updated:date('2026-05-17'), rationale:"MVP supports RU and EN only; auto-detect delegated to ASR. Broader languages out of scope.", status:"draft"}}, {id:"BRQ-005", properties:{severity:"hard", created:date('2026-05-17'), name:"Auto-detect language fallback", statement:"If Meeting.language = auto, the ASR engine MUST detect the language and the detected value is recorded as Transcript.language. The Meeting.language record stays as auto.", classification:"derivation", updated:date('2026-05-17'), rationale:"Auto-detection should not silently overwrite user input; Transcript.language records ground truth.", status:"draft"}}, {id:"BRQ-006", properties:{severity:"hard", created:date('2026-05-17'), name:"One TranscriptionJob per Recording", statement:"For each Recording there MUST be exactly one TranscriptionJob (1:1 relationship). Re-transcription is treated as a new Recording or explicit reprocess (out of MVP scope).", classification:"invariant", updated:date('2026-05-17'), rationale:"Simplifies status tracking and avoids divergent transcripts.", status:"draft"}}, {id:"BRQ-007", properties:{severity:"hard", created:date('2026-05-17'), name:"Auto-trigger protocol generation", statement:"When TranscriptionJob.status transitions to completed, a ProtocolGenerationJob MUST be created automatically for the resulting Transcript.", classification:"workflow", updated:date('2026-05-17'), rationale:"User does not need to manually initiate protocol generation; this is part of the end-to-end pipeline.", status:"draft"}}, {id:"BRQ-008", properties:{severity:"hard", created:date('2026-05-17'), name:"Meeting status mirrors pipeline", statement:"Meeting.status MUST reflect the current pipeline stage and follow the allowed lifecycle (uploading -> transcribing -> transcript_ready -> protocol_generating -> protocol_ready -> edited | failed).", classification:"invariant", updated:date('2026-05-17'), rationale:"The Meeting is the single authoritative status surface for the user; jobs carry internal status separately.", status:"draft"}}, {id:"BRQ-009", properties:{severity:"hard", created:date('2026-05-17'), name:"Job terminal states are immutable", statement:"Once TranscriptionJob.status or ProtocolGenerationJob.status reaches {completed, failed}, it MUST NOT change.", classification:"invariant", updated:date('2026-05-17'), rationale:"Terminal states are an audit anchor; mutating them would invalidate downstream artifacts and event records.", status:"draft"}}, {id:"BRQ-010", properties:{severity:"hard", created:date('2026-05-17'), name:"Failure recorded with reason", statement:"If a job status is failed, error_reason MUST be non-null and human-readable so the UI can surface it to the user.", classification:"invariant", updated:date('2026-05-17'), rationale:"Silent failures degrade trust and make support diagnostics impossible.", status:"draft"}}, {id:"BRQ-011", properties:{severity:"hard", created:date('2026-05-17'), name:"Required protocol sections", statement:"A persisted Protocol MUST contain all four sections: Participants, Discussion Topics, Decisions, Action Items.", classification:"constraint", updated:date('2026-05-17'), rationale:"These four sections are the value the system promises to deliver. Missing sections route generation to the failure branch.", status:"draft"}}, {id:"BRQ-012", properties:{severity:"soft", assumption_note:"No automated post-generation completeness check at MVP; user reviews/corrects in BP-005.", created:date('2026-05-17'), name:"Action items have assignee and deadline when extractable", statement:"Action items in the protocol SHOULD include an assignee and a deadline when these are stated in the meeting; best-effort extraction by the LLM.", classification:"constraint", updated:date('2026-05-17'), rationale:"Captures the value of action items; soft because LLM extraction quality is inherently variable.", status:"draft"}}, {id:"BRQ-013", properties:{severity:"hard", superseded_statement:"Protocol MUST be generated in the same language as Transcript.language. The LLM is prompted to produce output in the source language.", created:date('2026-05-17'), name:"Protocol language is Russian by default", statement:"The protocol MUST be generated in Russian by default, regardless of the language actually spoken in the recording. An English protocol is generated ONLY when the author explicitly selected EN at upload time (Meeting.language = EN). Meeting.language determines the language of the DOCUMENT; Transcript.language records the language of the RECORDING (BRQ-005) and MUST NOT influence protocol template selection. Resolution: Meeting.language = EN -> EN; otherwise (RU or AUTO, and for any detected recording language) -> RU. There is no silent fallback to EN.", description:"Amended 2026-08-14 by product-owner decision following a production defect: meeting 3afc6f2e-8f7b-44fe-9281-627db34504d8 on transcriber.itsalt.ru produced an English protocol from a Russian transcript. Prior statement (superseded, retained in superseded_statement) required the protocol language to match Transcript.language. BRQ-005 is unaffected and remains in force: ASR-detected language is still recorded on Transcript.language and Meeting.language is still never overwritten - BRQ-013 simply ceases to be a consumer of Transcript.language. NFR-004 (RU + EN throughout) remains satisfied: EN is reachable via explicit author selection. Implemented by RQ-022 (UC-300).", classification:"constraint", updated:date('2026-05-17'), rationale:"The product serves Russian-speaking organisations; the protocol is a working document in the language of the organisation, not a transcription of the meeting. The previous rule made protocol language depend on Transcript.language, which combined with the AUTO default produced English protocols for Russian meetings - a silent correctness failure rather than a visible degradation. Making Russian the default removes the fallback path that caused it.", amended_on:"2026-08-14", status:"approved"}}, {id:"BRQ-014", properties:{severity:"hard", created:date('2026-05-17'), name:"Protocol version increments on save", statement:"Protocol.version MUST increment by 1 each time the user saves an edit in BP-005.", classification:"invariant", updated:date('2026-05-17'), rationale:"Versioning enables future audit/undo and is a low-cost defense against silent overwrites.", status:"draft"}}, {id:"BRQ-015", properties:{severity:"hard", created:date('2026-05-17'), name:"Edit count tracks saves", statement:"Protocol.edit_count MUST equal the number of manual saves performed since initial generation.", classification:"invariant", updated:date('2026-05-17'), rationale:"Surfaces how many times the protocol was changed by the user.", status:"draft"}}, {id:"BRQ-016", properties:{severity:"hard", assumption_note:"No real authentication or access check exists at MVP; rule recorded for forward design only.", created:date('2026-05-17'), name:"Author owns derived artifacts", statement:"The Author (ROL-01) of a Meeting is the sole owner of OBJ-002 Recording, OBJ-004 Transcript, and OBJ-006 Protocol for that Meeting.", classification:"authorization", updated:date('2026-05-17'), rationale:"Establishes the ownership model that future auth will enforce.", status:"draft"}}, {id:"BRQ-017", properties:{severity:"hard", created:date('2026-05-17'), name:"PDF export is transient", statement:"PDF export output is delivered to the user as a download; the system MUST NOT persist the rendered PDF.", classification:"invariant", updated:date('2026-05-17'), rationale:"Markdown is the canonical form; persisting PDFs creates stale-copy hazards and storage bloat.", status:"draft"}}, {id:"BRQ-018", properties:{severity:"hard", created:date('2026-05-17'), name:"Markdown is canonical", statement:"All edits and exports MUST operate on the canonical Markdown stored in Protocol.markdown_content. PDF and any rendered views are derivations.", classification:"invariant", updated:date('2026-05-17'), rationale:"Single source of truth simplifies the data model and prevents divergence between formats.", status:"draft"}}, {id:"BRQ-019", properties:{severity:"soft", created:date('2026-05-17'), name:"No processing-time SLA", statement:"There is NO maximum processing time for transcription or protocol generation. Users receive completion via status updates, not deadline guarantees.", classification:"constraint", updated:date('2026-05-17'), rationale:"Tech stack TBD; an SLA cannot be guaranteed at MVP. UX surfaces async status instead.", status:"draft"}}, {id:"BRQ-020", properties:{severity:"hard", assumption_note:"Retention duration beyond pipeline completion is TBD pending storage cost analysis; indefinite retention assumed at MVP.", created:date('2026-05-17'), name:"Recording retention until artifacts produced", statement:"The original video file in object storage MUST be retained at least until both Transcript and Protocol have been produced.", classification:"constraint", updated:date('2026-05-17'), rationale:"Pipeline failures may require re-running stages from the source file.", status:"draft"}}] AS row
CREATE (n:BusinessRule{id: row.id}) SET n += row.properties;
UNWIND [{id:"BRQ-021", properties:{severity:"soft", assumption_note:"Resolution method TBD (heuristic vs. LLM pass). Confidence threshold for substitution TBD. At MVP only the in-dialogue context is used; no external participant list lookup.", created:date('2026-05-17'), name:"Speaker name resolution from dialogue context", statement:"After diarization assigns anonymous speaker labels (Speaker 1, Speaker 2, ...), the system MUST attempt to resolve each label to a real name by analyzing self-introductions and addressed names within the transcript. When a confident association is found, the label is substituted with the resolved name across the transcript and recorded in Transcript.speaker_map. Labels without a confident match remain as Speaker N.", classification:"derivation", updated:date('2026-05-17'), rationale:"Speaker labels are anonymous by default; resolving names where mentioned makes the transcript and protocol substantially more readable. Soft because resolution accuracy depends on dialogue content and the chosen resolution method.", status:"draft"}}, {id:"BR-101", properties:{severity:"high", source_commit:"commit 1b94f5b", created:date('2026-05-22'), name:"WEBM MIME acceptance", statement:"Upload form MUST accept video/webm as a valid filetype in addition to video/mp4, video/mkv, video/quicktime. EXT_MAP in api/src/routes/upload-init.ts MUST map webm→webm extension.", description:"Uploads with MIME type video/webm are accepted (in addition to video/mp4, video/x-matroska, video/quicktime).", category:"validation", classification:"invariant", updated:date('2026-05-22'), rationale:"Common browser-recorded format (MediaRecorder API). Added 2026-05-22 per commit 1b94f5b feat(UC-100): accept WEBM uploads, raise size limit to 1 GiB.", status:"approved"}}, {id:"BR-102", properties:{severity:"high", source_commit:"commit 1b94f5b", created:date('2026-05-22'), name:"1 GiB upload size cap", statement:"Upload form MUST reject files larger than 2.5 GiB (2,684,354,560 bytes) at the browser layer before /init is called. api/src/routes/upload-init.ts MUST enforce the same cap server-side. Supersedes the earlier 500 MB, 1 GiB and 1.5 GiB caps. Independently, a recording longer than 14,400 s (4 h) MUST be rejected per RQ-039 regardless of byte size - and for recordings below ~1.5 Mbps that duration gate is what binds first.", description:"Upload form MUST reject files larger than 2.5 GiB (2,684,354,560 bytes) at the browser layer before /init is called. api/src/routes/upload-init.ts MUST enforce the same cap server-side. Supersedes the earlier 500 MB, 1 GiB and 1.5 GiB caps. Independently, a recording longer than 14,400 s (4 h) MUST be rejected per RQ-039 regardless of byte size - and for recordings below ~1.5 Mbps that duration gate is what binds first.", category:"validation", classification:"constraint", updated:datetime('2026-08-17T09:14:27.065Z'), rationale:"Production needs accept 90-min Zoom recordings; 500 MB was insufficient. Raised in 1b94f5b together with WEBM acceptance.", status:"approved"}}, {id:"BR-103", properties:{severity:"medium", source_commit:"commit ad7b8b4", created:date('2026-05-22'), name:"Optional speaker_count hint on upload", statement:"Upload form MAY include speaker_count: integer | null in the /api/uploads/complete request. When present, worker passes the hint to Deepgram for diarization (model=\"nova-3\", diarize=true, with the hint improving speaker label stability). Null = let Deepgram auto-detect.", description:"The AUTHOR may optionally provide a speaker_count hint (1-10) at upload time, which is forwarded to ASR diarization to pin the speaker count.", category:"functional", classification:"invariant", updated:date('2026-05-22'), rationale:"Authors usually know their meeting size; the hint improves diarization accuracy. Added 2026-05-22 per commit ad7b8b4 feat(UC-100/UC-200): optional speaker count + sticky back-link on subpages.", status:"approved"}}, {id:"BR-104", properties:{severity:"low", source_commit:"ad7b8b4", created:date('2026-05-22'), name:"Sticky back-link on UC sub-pages", statement:"On UC-100 (Upload) and UC-200 (Transcript view) sub-pages, the catalog back-link MUST remain visible (sticky-positioned) while the user scrolls through long content. Implemented as a sticky header element in web/src/routes/{meeting,transcript,protocol}/index.tsx.", description:"Sub-pages of the Meeting detail hub display a sticky (scroll-persistent) back-link that returns to the Meeting detail page.", category:"interface", classification:"invariant", updated:date('2026-05-22'), rationale:"Long meeting recordings / transcripts can scroll many viewport heights; without a sticky back-link the user gets lost. Added 2026-05-22 per commit ad7b8b4.", status:"approved"}}, {id:"BR-105", properties:{severity:"medium", source_commit:"40341a6", created:date('2026-05-22'), name:"RU protocol prompt XML-structured role/constraints", statement:"The Russian-language protocol generation prompt (worker/src/llm/prompts/ru/protocol.md, copied to dist/llm/prompts/ru/protocol.md by worker build) uses structured XML-style sections to delimit role, constraints, and output template. This is the canonical prompt shape for claude-sonnet-4-6 to produce reliable RU meeting protocols. The EN prompt (en/protocol.md) follows the same structural pattern. Future prompt edits MUST preserve the XML-section structure.", description:"The Russian-language protocol generation prompt is structured with explicit XML tags for role and constraints to improve output consistency.", category:"behavioral", classification:"invariant", updated:date('2026-05-22'), rationale:"Structured XML sections improve Claude Sonnet 4.6 instruction-following compared to flat markdown prose. Rewritten 2026-05-22 per commit 40341a6 feat(UC-300): rewrite RU protocol prompt with structured XML role/constraints.", status:"approved"}}] AS row
CREATE (n:BusinessRule{id: row.id}) SET n += row.properties;
UNWIND [{_id:127, properties:{phase:"BA->SA", summary:"BA phase complete for Transcrib. Covers 2 ProcessGroups, 6 BusinessProcesses (3 decomposed), 6 BusinessEntities, 2 Roles, 27 GlossaryTerms, 21 BusinessRules (19 hard / 2 soft). Validation L1-L8 passed. Produces 9 UC candidates and 6 SA module proposals. 3 open questions deferred to SA.", sa_modules:"[{\"module\":\"Ingestion\",\"description\":\"Upload, validation, chunked transfer, object storage write, transcription job dispatch\",\"source_bp\":[\"BP-001\"]},{\"module\":\"TranscriptionPipeline\",\"description\":\"ASR worker, audio extraction, diarization, speaker-name resolution from dialogue context, transcript persistence\",\"source_bp\":[\"BP-002\"]},{\"module\":\"ProtocolGeneration\",\"description\":\"LLM orchestration, prompt template management/versioning, response parsing, protocol persistence\",\"source_bp\":[\"BP-004\"]},{\"module\":\"ProtocolEditing\",\"description\":\"Markdown editor UI, protocol versioning, save/discard\",\"source_bp\":[\"BP-005\"]},{\"module\":\"ExportDelivery\",\"description\":\"Transcript download endpoint, PDF rendering and delivery\",\"source_bp\":[\"BP-003\",\"BP-006\"]},{\"module\":\"MeetingStatus\",\"description\":\"Cross-cutting Meeting lifecycle status aggregation and UI display (polling or push)\",\"source_bp\":[\"BP-001\",\"BP-002\",\"BP-004\"]}]", uc_candidates:"[{\"id\":\"UC-001\",\"label\":\"Upload video and create meeting\",\"source\":[\"BP-001\"]},{\"id\":\"UC-002\",\"label\":\"Transcribe audio with diarization\",\"source\":[\"BP-002 S01-S07\"]},{\"id\":\"UC-003\",\"label\":\"Resolve speaker names in transcript\",\"source\":[\"BP-002-S07B\"]},{\"id\":\"UC-004\",\"label\":\"Generate meeting protocol via LLM\",\"source\":[\"BP-004 happy path\"]},{\"id\":\"UC-005\",\"label\":\"Handle transcription and protocol failures\",\"source\":[\"BP-002-S09\",\"BP-004-S10\"]},{\"id\":\"UC-006\",\"label\":\"View and download transcript\",\"source\":[\"BP-003\"]},{\"id\":\"UC-007\",\"label\":\"Review and edit protocol in Markdown editor\",\"source\":[\"BP-005\"]},{\"id\":\"UC-008\",\"label\":\"Export protocol as PDF\",\"source\":[\"BP-006\"]},{\"id\":\"UC-009\",\"label\":\"Display meeting processing status\",\"source\":[\"cross-cutting: BP-001-S07, BP-002-S08/S09, BP-004-S09/S10\"]}]", created:date('2026-05-17'), open_questions:"[{\"id\":\"OQ-1\",\"question\":\"Speaker-name resolution sequencing: must BP-002-S07B complete before BP-004 fires, or can protocol generation start with anonymous labels and names be resolved post-hoc? Affects UC-003 timing and TranscriptionPipeline module boundary.\"},{\"id\":\"OQ-2\",\"question\":\"Failure retry strategy (BRQ-019, BP-002-S09, BP-004-S10): manual user-triggered retry vs. automatic with back-off? Determines whether UC-005 needs UI controls or is informational-only.\"},{\"id\":\"OQ-3\",\"question\":\"Protocol versioning model (BRQ-014/015): append-only immutable versions vs. in-place overwrite with single prior snapshot? Drives SA domain model for Protocol and impacts UC-007 (edit) and UC-008 (export which version?).\"},{\"id\":\"OQ-4\",\"question\":\"Tech stack still TBD (EXT-02 ASR vendor, EXT-03 LLM provider, EXT-04 storage, PDF rendering). To be decided in /nacl-sa-architect.\"}]", entity_traces:"[{\"ba\":\"OBJ-001\",\"name\":\"Meeting\",\"sa_entity\":\"Meeting\"},{\"ba\":\"OBJ-002\",\"name\":\"Recording\",\"sa_entity\":\"Recording\"},{\"ba\":\"OBJ-003\",\"name\":\"TranscriptionJob\",\"sa_entity\":\"TranscriptionJob\"},{\"ba\":\"OBJ-004\",\"name\":\"Transcript\",\"sa_entity\":\"Transcript\"},{\"ba\":\"OBJ-005\",\"name\":\"ProtocolGenerationJob\",\"sa_entity\":\"ProtocolGenerationJob\"},{\"ba\":\"OBJ-006\",\"name\":\"Protocol\",\"sa_entity\":\"Protocol\"}]", rule_req_map:"[{\"brq\":\"BRQ-001\",\"name\":\"File size limit\",\"proposed_req\":\"REQ-001\",\"category\":\"FR\"},{\"brq\":\"BRQ-002\",\"name\":\"Allowed file formats\",\"proposed_req\":\"REQ-002\",\"category\":\"FR\"},{\"brq\":\"BRQ-003\",\"name\":\"File integrity\",\"proposed_req\":\"REQ-003\",\"category\":\"FR\"},{\"brq\":\"BRQ-004\",\"name\":\"Supported languages\",\"proposed_req\":\"REQ-004\",\"category\":\"FR\"},{\"brq\":\"BRQ-005\",\"name\":\"Auto-detect language fallback\",\"proposed_req\":\"REQ-005\",\"category\":\"FR\"},{\"brq\":\"BRQ-006\",\"name\":\"One TranscriptionJob per Recording\",\"proposed_req\":\"REQ-006\",\"category\":\"FR\"},{\"brq\":\"BRQ-007\",\"name\":\"Auto-trigger protocol generation\",\"proposed_req\":\"REQ-007\",\"category\":\"FR\"},{\"brq\":\"BRQ-008\",\"name\":\"Meeting status mirrors pipeline\",\"proposed_req\":\"REQ-008\",\"category\":\"FR\"},{\"brq\":\"BRQ-009\",\"name\":\"Job terminal states are immutable\",\"proposed_req\":\"REQ-009\",\"category\":\"FR\"},{\"brq\":\"BRQ-010\",\"name\":\"Failure recorded with reason\",\"proposed_req\":\"REQ-010\",\"category\":\"FR\"},{\"brq\":\"BRQ-011\",\"name\":\"Required protocol sections\",\"proposed_req\":\"REQ-011\",\"category\":\"FR\"},{\"brq\":\"BRQ-012\",\"name\":\"Action items have assignee and deadline when extractable\",\"proposed_req\":\"REQ-012\",\"category\":\"NFR\"},{\"brq\":\"BRQ-013\",\"name\":\"Protocol language matches transcript\",\"proposed_req\":\"REQ-013\",\"category\":\"FR\"},{\"brq\":\"BRQ-014\",\"name\":\"Protocol version increments on save\",\"proposed_req\":\"REQ-014\",\"category\":\"FR\"},{\"brq\":\"BRQ-015\",\"name\":\"Edit count tracks saves\",\"proposed_req\":\"REQ-015\",\"category\":\"FR\"},{\"brq\":\"BRQ-016\",\"name\":\"Author owns derived artifacts\",\"proposed_req\":\"REQ-016\",\"category\":\"FR\"},{\"brq\":\"BRQ-017\",\"name\":\"PDF export is transient\",\"proposed_req\":\"REQ-017\",\"category\":\"FR\"},{\"brq\":\"BRQ-018\",\"name\":\"Markdown is canonical\",\"proposed_req\":\"REQ-018\",\"category\":\"FR\"},{\"brq\":\"BRQ-019\",\"name\":\"No processing-time SLA\",\"proposed_req\":\"REQ-019\",\"category\":\"NFR\"},{\"brq\":\"BRQ-020\",\"name\":\"Recording retention until artifacts produced\",\"proposed_req\":\"REQ-020\",\"category\":\"FR\"},{\"brq\":\"BRQ-021\",\"name\":\"Speaker name resolution from dialogue context\",\"proposed_req\":\"REQ-021\",\"category\":\"NFR\"}]", id:"HP-001", role_traces:"[{\"ba\":\"ROL-01\",\"name\":\"Author\",\"sa_role\":\"Author\"},{\"ba\":\"ROL-02\",\"name\":\"Reviewer\",\"sa_role\":\"Reviewer (assumption ��� no MVP behavior)\"}]", updated:date('2026-05-17'), status:"draft"}}] AS row
CREATE (n:`UNIQUE IMPORT LABEL`{`UNIQUE IMPORT ID`: row._id}) SET n += row.properties SET n:HandoffPackage;
UNWIND [{id:"TECH-001", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Monorepo & tooling (pnpm workspaces, tsconfig, eslint, prettier, vitest)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-002", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Docker Compose dev stack (Postgres, Redis, MinIO)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-003", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Prisma schema & migrations (Meeting, Recording, jobs, Transcript, Protocol + enums)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-004", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Shared Zod schemas, DTOs, enums (shared/ package)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-005", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Fastify API scaffold (zod provider, error handler, Pino, /health)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-006", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), title:"BullMQ + worker process scaffold", type:"tech", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-007", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"S3/MinIO storage adapter (s3:// URI, env-swappable)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-008", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"TUS upload protocol wiring (@tus/server + tus-js-client)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-009", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"ffmpeg audio extraction utility (fluent-ffmpeg in worker)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-010", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"IAsrProvider abstraction + Deepgram Nova-3 adapter", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-011", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"ILlmProvider abstraction + kie.ai adapter (Claude 4.6 / GPT-5.4)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-012", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"SSE event stream (Fastify native) for job progress", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-013", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), type:"tech", title:"Web scaffold (Vite + React 19 + shadcn/ui + Tailwind + TanStack Query + Router + i18next RU/EN)", priority:"high", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-014", properties:{agent:"nacl-tl-dev", last_reconciled:"2026-05-18", created:datetime('2026-05-18T08:41:16.385Z'), priority:"medium", type:"tech", title:"Puppeteer PDF renderer (transient, never persisted)", updated:datetime('2026-05-18T08:41:16.385Z'), wave:0, phase_review_be:"approved", status:"done"}}, {id:"TECH-015", properties:{agent:"nacl-tl-dev", ci_run_id:26045597888, created:datetime('2026-05-18T08:41:16.385Z'), priority:"medium", type:"tech", title:"GitHub Actions CI (lint, typecheck, vitest, build)", wave:0, phase_review_be:"approved", ci_run_url:"https://github.com/ITSalt/transcriber/actions/runs/26045597888", ci_verified:"2026-05-18", ci_run_conclusion:"success", last_reconciled:"2026-05-18", updated:datetime('2026-05-18T08:41:16.385Z'), status:"done"}}, {id:"UC-001-BE", properties:{phase_qa:"pass", agent:"nacl-tl-dev-be", uc_ref:"UC-001", stale_origin:"FR-003..FR-006", created:datetime('2026-05-18T08:41:16.385Z'), stale_reason:"program product FR-003..FR-006 (WP-BACKEND-06 contract v1): workspace isolation, deferred start + context, protocol versions, project memory", phase_sync:"pass", verification_evidence_updated:datetime('2026-05-22T13:09:11.494Z'), title:"Meeting catalog API", type:"uc-be", priority:"high", last_docs_sync:"2026-05-18", wave:1, phase_review_be:"approved", phase_be:"approved", last_reconciled:"2026-05-18", verification_evidence:["wire-evidence:fixture:shared/test/fixtures/sse-event-frames.json", "wire-evidence:type-parity:shared/src/api/uc001.ts (Zod-shared; api/src/routes/uc-001.test.ts asserts shape)"], review_status:"stale", stale_since:"2026-10-07T17:32:31.711Z", updated:datetime('2026-05-18T08:41:16.385Z'), status:"done"}}, {id:"UC-001-FE", properties:{phase_qa:"pass", agent:"nacl-tl-dev-fe", uc_ref:"UC-001", stale_origin:"FR-003..FR-006", created:datetime('2026-05-18T08:41:16.385Z'), stale_reason:"program product FR-003..FR-006 (WP-BACKEND-06 contract v1): workspace isolation, deferred start + context, protocol versions, project memory", phase_sync:"pass", phase_review_fe:"approved", verification_evidence_updated:datetime('2026-05-22T13:09:11.494Z'), title:"Meeting catalog page", type:"uc-fe", priority:"high", last_docs_sync:"2026-05-18", wave:2, last_reconciled:"2026-05-18", phase_fe:"approved", verification_evidence:["wire-evidence:fixture:shared/test/fixtures/sse-event-frames.json", "wire-evidence:type-parity:shared/src/api/uc001.ts (Zod-shared; api/src/routes/uc-001.test.ts asserts shape)"], review_status:"stale", stale_since:"2026-10-07T17:32:31.711Z", updated:datetime('2026-05-18T08:41:16.385Z'), status:"done"}}, {id:"UC-002-BE", properties:{phase_qa:"pass", agent:"nacl-tl-dev-be", uc_ref:"UC-002", stale_origin:"FR-007", created:datetime('2026-05-18T08:41:16.385Z'), stale_reason:"FR-007 speaker confirmation changed UC-002", phase_sync:"pass", verification_evidence_updated:datetime('2026-05-22T13:09:11.494Z'), title:"Meeting detail API", type:"uc-be", priority:"high", wave:2, phase_review_be:"approved", phase_be:"approved", last_reconciled:"2026-05-18", verification_evidence:["wire-evidence:fixture:shared/test/fixtures/sse-event-frames.json", "wire-evidence:type-parity:shared/src/api/uc002.ts"], review_status:"stale", stale_since:datetime('2026-10-08T19:18:45.193Z'), updated:datetime('2026-05-18T08:41:16.385Z'), status:"done"}}, {id:"UC-002-FE", properties:{phase_qa:"pass", agent:"nacl-tl-dev-fe", uc_ref:"UC-002", stale_origin:"FR-007", created:datetime('2026-05-18T08:41:16.385Z'), stale_reason:"FR-007 speaker confirmation changed UC-002", phase_sync:"pass", phase_review_fe:"approved", verification_evidence_updated:datetime('2026-05-22T13:09:11.494Z'), title:"Meeting detail page", type:"uc-fe", priority:"high", wave:3, last_reconciled:"2026-05-18", phase_fe:"appro