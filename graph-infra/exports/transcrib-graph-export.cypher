UNWIND [{_id:351, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"DateTime", name:"finished_at", description:"Terminal-state timestamp; set when status becomes DONE or FAILED.", id:"TranscriptionJob-A07", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:352, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the Transcript.", id:"Transcript-A01", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:353, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Reference", name:"meeting_id", description:"FK to the owning Meeting (ent-001).", id:"Transcript-A02", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:354, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"String", name:"raw_text", description:"Markdown/text with per-segment speaker labels + minute:second timestamps. Schema-nullable but ALWAYS populated by worker (transcription.ts:251).", id:"Transcript-A03", type:"String", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:355, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Int", name:"segments_count", description:"DERIVED: length(segments_blob) at read time. Not persisted as a column.", id:"Transcript-A04", updated:datetime('2026-05-18T06:48:25.348Z'), derived:true}}, {_id:356, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Int", name:"speakers_count", description:"DERIVED: count of distinct speaker labels in segments_blob at read time. Not persisted as a column.", id:"Transcript-A05", updated:datetime('2026-05-18T06:48:25.348Z'), derived:true}}, {_id:357, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"Enum", name:"language", description:"PERSISTED (column transcripts.language). The language actually spoken in the recording, as reported by the ASR provider: the detected language when Meeting.language = AUTO, otherwise the confirmed hint. Constrained to {RU, EN}; NULL when ASR reported a language outside that set; never 'AUTO'. Canonical source for any surface displaying the transcript's language (UC-201). Per BRQ-013 (amended 2026-08-14) it MUST NOT influence protocol prompt-template selection - that is driven by Meeting.language.", id:"Transcript-A06", updated:datetime('2026-05-18T06:48:25.348Z'), derived:false}}, {_id:358, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"DateTime", name:"created_at", description:"Timestamp when the transcript was first persisted.", id:"Transcript-A07", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:359, properties:{internal:false, nullable:true, created:datetime('2026-05-18T06:48:25.348Z'), data_type:"JSON", name:"speaker_map", description:"Map of anonymous diarization labels to resolved names per BRQ-021. Example: {\"Speaker 1\": \"Ivan\", \"Speaker 2\": null}. Null means no resolutions attempted.", id:"Transcript-A08", updated:datetime('2026-05-18T06:48:25.348Z')}}, {_id:360, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the ProtocolGenerationJob.", id:"ProtocolGenerationJob-A01", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:361, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"Reference", name:"meeting_id", description:"FK to the owning Meeting (ent-001).", id:"ProtocolGenerationJob-A02", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:362, properties:{internal:true, nullable:false, created:datetime('2026-05-26T10:31:40.39Z'), data_type:"Int", name:"attempt_count", description:"Number of processing attempts made (mirrors BullMQ attemptsMade). Lets the failure handler distinguish a transient retryable failure (attempts remaining) from terminal exhaustion. Reset to 0 on user-triggered retry (UC-004). Added by FR-001.", id:"ProtocolGenerationJob-A09", type:"Int", updated:datetime('2026-05-26T10:31:40.39Z'), derived:false}}, {_id:363, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"Enum", name:"status", description:"Job lifecycle status. Reuses ENUM-JobStatus. Terminal states are immutable (BRQ-009).", id:"ProtocolGenerationJob-A04", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:364, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"String", name:"error_msg", description:"Non-null when status=FAILED (BRQ-010); free-form error message.", id:"ProtocolGenerationJob-A05", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:366, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"DateTime", name:"started_at", description:"Timestamp when the worker picked up the job. Null while QUEUED.", id:"ProtocolGenerationJob-A07", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:367, properties:{internal:true, nullable:true, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"DateTime", name:"finished_at", description:"Terminal-state timestamp; set when status becomes DONE or FAILED.", id:"ProtocolGenerationJob-A08", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:368, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"UUID", name:"id", description:"Surrogate primary key for the Protocol.", id:"Protocol-A01", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:369, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"Reference", name:"meeting_id", description:"FK to the owning Meeting (ent-001).", id:"Protocol-A02", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:370, properties:{internal:false, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"String", name:"markdown_content", description:"Canonical Markdown content of the protocol (BRQ-018). MUST contain the four required sections per BRQ-011: Participants, Discussion Topics, Decisions, Action Items.", id:"Protocol-A03", updated:datetime('2026-05-18T06:49:22.459Z')}}, {_id:371, properties:{internal:true, nullable:false, created:datetime('2026-05-18T06:49:22.459Z'), data_type:"DateTime", name:"generated_at", description:"Timestamp when the protocol was first produced by the LLM pipeline. Immutable.", id:"Protocol-A04", updated:datetime('2026-05-18T06:49:22.459Z')}}] AS row
