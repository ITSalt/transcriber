# PostgreSQL
# Docker Compose default: postgres://transcrib:transcrib@localhost:5432/transcrib
DATABASE_URL=postgres://transcrib:transcrib@localhost:5432/transcrib

# Redis
# Docker Compose default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# S3 / MinIO (dev) or Cloud.ru (prod)
# Docker Compose default: MinIO on localhost:9000
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=transcrib
S3_KEY=minioadmin
S3_SECRET=minioadmin
# Region: default us-east-1 (MinIO dev); set to ru-central-1 for Cloud.ru prod
S3_REGION=us-east-1
# Force path-style URLs — required for MinIO; also works with Cloud.ru
S3_FORCE_PATH_STYLE=true

# Cloud.ru prod example:
# S3_ENDPOINT=https://s3.cloud.ru
# S3_REGION=ru-central-1
# S3_BUCKET=transcrib-itsalt-prod
# S3_FORCE_PATH_STYLE=true
# IMPORTANT: Cloud.ru S3_KEY format is "<tenant-id>:<access-key-id>"
# Tenant ID is shown on the Object Storage API page in the console.
# S3_KEY=<tenant-id>:<access-key-id>   e.g. 63abedb5-xxxx:b9440ddc...
# S3_SECRET=<secret-access-key>

# Puppeteer / Chrome (prod only)
# Set to system Chrome binary path in prod. Leave unset in dev (bundled Chrome used).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Deepgram ASR
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# LLM (kie.ai)
KIE_API_KEY=your_kie_api_key_here

# Project-memory graph (Neo4j 5, ADR-013). Separate instance from the dev
# spec-graph container (3614/3627). Docker Compose `memory-neo4j` publishes
# bolt on 127.0.0.1:7689 (browser 7476; 7475/7688 are taken by fc-neo4j on the prod VM, D-26); the password below is the dev default — set a real one
# in prod BEFORE the first `docker compose up -d memory-neo4j`: NEO4J_AUTH is
# applied only on first start with an empty volume, a later change does not
# alter the DB password.
# Files (prod): compose and the deploy step read /opt/transcrib/.env; the worker
# and graph:migrate read /opt/transcrib/worker/.env. Keep the values equal.
# When MEMORY_NEO4J_URI is unset the prod deploy skips graph:migrate.
MEMORY_NEO4J_URI=bolt://localhost:7689
MEMORY_NEO4J_USER=neo4j
MEMORY_NEO4J_PASSWORD=memory_dev_password
MEMORY_NEO4J_DATABASE=neo4j

# Login by PIN (FR-003, WP-BACKEND-01). api reads these from api/.env (prod: /opt/transcrib/api/.env).
# PIN_PEPPER: HMAC key of the PIN lookup, >= 16 random chars (e.g. `openssl rand -hex 32`).
# Changing it later invalidates every PIN. Empty/unset: login answers 503 and the user CLI refuses.
PIN_PEPPER=
# AUTH_REQUIRED: true = every /api/* route except health/login needs a session (401 otherwise).
# false (default) = requests without a session see only the legacy workspace «Роман» (D-20).
# Owner switch-on order: PIN_PEPPER -> user:create (Роман --workspace Роман, others) -> true -> pm2 restart.
AUTH_REQUIRED=false

# LLM provider (WP-WORKER-03, D-32). The worker reads these from worker/.env (prod: /opt/transcrib/worker/.env).
# LLM_PROVIDER: openrouter | kieai. Unset = openrouter when OPENROUTER_API_KEY is set, otherwise kieai
#   (a stand without the key keeps working on kie.ai). An unknown value stops the worker at start.
# LLM_MODEL: model id of the chosen provider. Unset = anthropic/claude-haiku-5.5 (openrouter) / claude-sonnet-4-6 (kieai).
# OPENROUTER_API_KEY: key from openrouter.ai; KIE_API_KEY (above) is used only when the provider is kieai.
# LLM_TIMEOUT_MS: per-request timeout of the OpenRouter call, integer ms, minimum 1000, default 180000;
#   a timeout is retried (BullMQ).
# LLM_PROVIDER and LLM_MODEL go together: change them as a pair. With kieai only claude-sonnet-4-6 is accepted
#   (any other model stops the worker at start); with openrouter use an OpenRouter id such as anthropic/claude-haiku-5.5.
# OUTBOUND_PROXY_URL (WP-WORKER-04, D-33): forward proxy for OpenRouter ONLY (RU addresses get HTTP 403 from it).
#   http:// or https:// (user:pass@host:port allowed; socks5:// and malformed values stop the worker at start).
#   Empty = direct. kie.ai, Deepgram and S3 never use it.
LLM_PROVIDER=
LLM_MODEL=
OPENROUTER_API_KEY=
LLM_TIMEOUT_MS=
OUTBOUND_PROXY_URL=
